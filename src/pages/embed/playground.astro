---
import '@styles/global.css'
import '@fontsource-variable/inter/index.css'
import PlayerPlayground from '@components/PlayerPlayground'
---

<!doctype html>
<html lang="en" class="dark bg-neutral-900">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Interactive Playground | Kirill Tregubov</title>
  </head>
  <body class="m-0 h-dvh overflow-hidden bg-neutral-900 font-sans text-neutral-300">
    <main class="h-full w-full p-2 sm:p-3">
      <PlayerPlayground embedded client:load />
    </main>
  </body>
</html>
