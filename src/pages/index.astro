---
import { getCollection } from 'astro:content'
import HomeHero from '@components/HomeHero.astro'
import LatestPosts from '@components/LatestPosts.astro'
import PageContainer from '@components/PageContainer.astro'
import ProjectPreview from '@components/ProjectPreview.astro'
import TechnologyStack from '@components/TechnologyStack.astro'
import Button from '@components/ui/Button.astro'
import Layout from '@layouts/Layout.astro'
import { BLOG_SUBTITLE } from '@lib/blog'
import { SITE_NAME } from '@lib/site'
import { ArrowRightIcon, ChevronRightIcon } from 'lucide-react'

const latestPosts = (await getCollection('blog'))
  .filter((post) => !post.data.draft && !post.data.hidden)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 2)

const allProjects = await getCollection('projects').then((projects) =>
  projects
    .filter((project) => import.meta.env.DEV || project.data.draft !== true)
    .sort(
      (a, b) =>
        (b.data.updatedDate?.getTime() ?? b.data.pubDate.getTime()) -
        (a.data.updatedDate?.getTime() ?? a.data.pubDate.getTime()),
    ),
)
---

<Layout
  title={SITE_NAME}
  player={{ path: '/embed/playground', width: 640, height: 800 }}
  footerClass="enter-5"
>
  <PageContainer class="space-y-8 md:space-y-12">
    <h1 class="sr-only">Kirill Tregubov, Software Developer</h1>
    <HomeHero />
    {latestPosts.length > 0 && (
      <section id="writing" aria-labelledby="writing-title" class="enter-1">
        <div class="flex items-center justify-between gap-4">
          <h2 id="writing-title" class="text-xl leading-none font-semibold">
            My Writing
          </h2>
          <Button variant="ghost" href="/blog" class="group">
            All Posts
            <ArrowRightIcon
              className="size-4 -translate-y-px transition-transform motion-safe:group-hover:translate-x-0.5 motion-safe:group-focus-visible:translate-x-0.5"
              aria-hidden="true"
            />
          </Button>
        </div>
        <p class="mt-2 mb-3 text-neutral-400">{BLOG_SUBTITLE}</p>
        <LatestPosts posts={latestPosts} mode="single" />
      </section>
    )}

    <section
      id="projects"
      aria-labelledby="projects-title"
      data-show-all="false"
      class="group/projects enter-2"
    >
      <div class="sticky top-0 z-10 -mx-4 flex flex-col items-start justify-between gap-x-3 gap-y-2 bg-neutral-900 px-4 pt-4 pb-2 after:pointer-events-none after:absolute after:-bottom-3.5 after:left-0 after:h-3.5 after:w-full after:bg-linear-to-b after:from-neutral-900 after:to-neutral-900/0 after:content-[''] xs:-mx-6 xs:flex-row xs:px-6 md:-mx-12 md:px-12 md:pb-2.5">
        <div>
          <h2 id="projects-title" class="text-xl leading-none font-semibold">
            <span class="group-data-[show-all=true]/projects:hidden">
              Featured Projects
            </span>
            <span class="hidden group-data-[show-all=true]/projects:inline">
              All Projects
            </span>
          </h2>
          <p class="mt-2 text-neutral-400">
            Projects I have worked on that
            <span class="group-data-[show-all=true]/projects:hidden">
              {' '}
              best
            </span>{' '}
            showcase my abilities.
          </p>
        </div>
        <Button
          variant="ghost"
          aria-controls="project-list"
          aria-expanded="false"
          data-projects-toggle
        >
          <span class="group-data-[show-all=true]/projects:hidden">
            Show All
          </span>
          <span class="hidden group-data-[show-all=true]/projects:inline">
            Show Featured
          </span>
          <ChevronRightIcon
            className="size-4 -translate-y-px transition-transform group-data-[show-all=true]/projects:rotate-90"
            aria-hidden="true"
          />
        </Button>
      </div>
      <ul
        id="project-list"
        class="mt-4 grid grid-cols-1 gap-8 gap-x-6 group-data-[show-all=false]/projects:*:not-data-featured:hidden lg:grid-cols-3 xl:gap-x-10"
      >
        {allProjects.map((project) => (
          <li data-featured={project.data.featured || undefined}>
            <ProjectPreview
              project={project}
              featured={project.data.featured}
            />
          </li>
        ))}
      </ul>
    </section>
    <section id="tech-stack" aria-labelledby="tech-stack-title" class="enter-3">
      <h2 id="tech-stack-title" class="text-xl leading-none font-semibold">
        Tech Stack
      </h2>
      <p class="mt-2 mb-3 text-neutral-400">
        Technologies and programming languages that I enjoy using, and have
        worked with in the past.
      </p>
      <TechnologyStack type="technology" />
    </section>
    <section id="tools" aria-labelledby="tools-title" class="enter-4">
      <h2 id="tools-title" class="text-xl leading-none font-semibold">
        Tools & Services
      </h2>
      <p class="mt-2 mb-3 text-neutral-400">
        Tools and services that I enjoy using regularly and have experience
        with.
      </p>
      <TechnologyStack type="tool" />
    </section>
  </PageContainer>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.querySelector<HTMLButtonElement>(
      '[data-projects-toggle]',
    )
    const section = toggle?.closest<HTMLElement>('[data-show-all]')
    if (!toggle || !section) return

    toggle.addEventListener('click', () => {
      const showAll = section.dataset.showAll !== 'true'
      section.dataset.showAll = String(showAll)
      toggle.setAttribute('aria-expanded', String(showAll))
    })
  })
</script>
