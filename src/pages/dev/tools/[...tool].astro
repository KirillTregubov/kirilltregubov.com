---
import '@styles/global.css'
import '@fontsource-variable/inter/index.css'
import PlayerPreview from '@components/dev/PlayerPreview'
import { players } from '@lib/players'

// No paths are generated in production: these tools exist only in astro dev.
export function getStaticPaths() {
  return import.meta.env.DEV
    ? [{ params: { tool: 'player' } }, { params: { tool: 'players' } }]
    : []
}

const isPlayer = Astro.params.tool === 'player'
---

<!doctype html>
<html lang="en" class="dark bg-neutral-950">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{isPlayer ? 'X player preview' : 'Player gallery'} · Local dev</title>
  </head>
  <body class="m-0 p-4 font-sans text-neutral-300 sm:p-6">
    <main>
      {isPlayer ? (
        <>
          <header class="mb-4 flex flex-wrap items-center gap-x-6 gap-y-2 text-sm">
            <a
              href="/dev"
              class="text-neutral-400 underline underline-offset-4 hover:text-white"
            >
              Dev pages
            </a>
            <h1 class="font-medium">X player preview</h1>
          </header>
          <PlayerPreview players={players} client:load />
        </>
      ) : (
        <>
          <a
            href="/dev"
            class="text-sm text-neutral-400 underline underline-offset-4"
          >
            Dev pages
          </a>
          <h1 class="mt-4 text-xl font-semibold text-neutral-100">
            Player gallery
          </h1>
          <p class="mt-2 text-sm text-neutral-500">
            Choose a player to edit and preview at different sizes.
          </p>
          <div class="mt-6 grid max-w-4xl grid-cols-1 gap-6 sm:grid-cols-2">
            {players.map((player) => (
              <article class="overflow-hidden rounded-2xl border border-neutral-800 bg-neutral-900">
                <div
                  class="aspect-square overflow-hidden border-b border-neutral-800"
                  inert
                >
                  <iframe
                    src={`/embed/${player.id}`}
                    title={`${player.title} thumbnail`}
                    loading="lazy"
                    tabindex="-1"
                    class="pointer-events-none block h-full w-full border-0"
                  />
                </div>
                <div class="p-4">
                  <h2 class="font-semibold text-neutral-100">{player.title}</h2>
                  <p class="mt-2 text-sm text-neutral-400">
                    {player.description}
                  </p>
                  <a
                    href={`/dev/tools/player?player=${player.id}`}
                    class="mt-4 inline-flex min-h-10 items-center rounded-lg bg-neutral-800 px-4 text-sm font-medium hover:bg-neutral-700"
                  >
                    Open player →
                  </a>
                </div>
              </article>
            ))}
          </div>
        </>
      )}
    </main>
  </body>
</html>
