---
import { getCollection } from 'astro:content'
import ArticlePreview from '@components/ArticlePreview.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'
import { ChevronRightIcon } from 'lucide-react'

const visiblePosts = await getCollection('blog').then((posts) =>
  posts
    .filter(
      (post) =>
        (import.meta.env.DEV || !post.data.hidden) &&
        (import.meta.env.DEV || post.data.draft !== true),
    )
    .sort(
      (a, b) =>
        (b.data.updatedDate ?? b.data.pubDate).getTime() -
        (a.data.updatedDate ?? a.data.pubDate).getTime(),
    ),
)

const articles = visiblePosts.filter((post) => !post.data.archived)
const archivedArticles = visiblePosts.filter((post) => post.data.archived)
---

<Layout
  title="Blog - Kirill Tregubov"
  description="Articles by Kirill Tregubov about software development, projects, and the decisions behind them."
  bodyClass="flex flex-col"
>
  <main class="mx-auto w-full max-w-240 grow">
    <ReturnHome />
    <header class="mt-6 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0">
      <h1 class="text-3xl font-semibold text-neutral-100">Blog</h1>
      <p class="mt-3 max-w-180 text-lg text-neutral-400">
        Notes on software development, interface design, and the projects I’ve
        built.
      </p>
    </header>
    <div class="article-list-region -mx-3 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0 sm:-mx-6">
      <ul class="mt-6">
        {articles.map((article) => (
          <li class="article-row">
            <ArticlePreview article={article} />
          </li>
        ))}
      </ul>
      {archivedArticles.length > 0 && (
        <details
          class="archive-details group/archive mx-3 mt-10 motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0 sm:mx-6"
          style={`animation-delay: ${0.3 + articles.length * 0.1}s`}
        >
          <summary class="relative z-1 flex w-fit cursor-pointer items-center gap-2 text-lg font-semibold text-neutral-300 transition select-none marker:content-none hover:text-white focus-visible:text-white">
            Archive
            <span class="text-sm font-normal text-neutral-500">
              ({archivedArticles.length})
            </span>
            <ChevronRightIcon
              className="archive-chevron size-4 text-neutral-500 transition-transform duration-75 group-open/archive:rotate-90"
              aria-hidden="true"
            />
          </summary>
          <ul class="archive-list -mx-3 mt-3 sm:-mx-6">
            {archivedArticles.map((article) => (
              <li class="article-row">
                <ArticlePreview article={article} />
              </li>
            ))}
          </ul>
        </details>
      )}
    </div>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

  const setupArticleHighlights = () => {
    document
      .querySelectorAll<HTMLElement>('.article-list-region')
      .forEach((region) => {
        if (region.dataset.highlightInit !== undefined) return
        region.dataset.highlightInit = ''

        const rows = region.querySelectorAll<HTMLElement>('.article-row')
        const controller = new AbortController()
        const { signal } = controller
        let activeRow: HTMLElement | null = null
        let resetTimer: number | undefined

        const moveTo = (row: HTMLElement) => {
          const inset = 4
          const regionRect = region.getBoundingClientRect()
          const rowRect = row.getBoundingClientRect()
          const wasVisible = region.dataset.highlightVisible !== undefined

          window.clearTimeout(resetTimer)
          if (!wasVisible) region.dataset.highlightPositioning = ''

          activeRow = row
          region.style.setProperty(
            '--highlight-y',
            `${rowRect.top - regionRect.top + inset}px`,
          )
          region.style.setProperty(
            '--highlight-height',
            `${Math.max(0, rowRect.height - inset * 2)}px`,
          )

          if (!wasVisible) {
            void region.offsetWidth
            delete region.dataset.highlightPositioning
          }

          region.dataset.highlightVisible = ''
        }

        const hide = () => {
          delete region.dataset.highlightVisible
          activeRow = null
          window.clearTimeout(resetTimer)
          resetTimer = window.setTimeout(() => {
            if (region.dataset.highlightVisible !== undefined) return

            region.dataset.highlightPositioning = ''
            region.style.setProperty('--highlight-y', '0px')
            region.style.setProperty('--highlight-height', '0px')
            void region.offsetWidth
            delete region.dataset.highlightPositioning
          }, 150)
        }

        const hasKeyboardFocus = () => {
          const focusedElement = document.activeElement

          return (
            focusedElement instanceof HTMLElement &&
            region.contains(focusedElement) &&
            focusedElement.matches(':focus-visible')
          )
        }

        const hideIfInactive = () => {
          if (!region.matches(':hover') && !hasKeyboardFocus()) hide()
        }

        rows.forEach((row) => {
          row.addEventListener('pointerenter', () => moveTo(row))
          row.addEventListener('focusin', () => moveTo(row))
        })

        region.addEventListener('pointerleave', hideIfInactive)

        region.addEventListener('focusout', () => {
          requestAnimationFrame(() => {
            const focusedRow =
              document.activeElement?.closest<HTMLElement>('.article-row')

            if (focusedRow && region.contains(focusedRow)) moveTo(focusedRow)
            else hideIfInactive()
          })
        })

        const reconcileAfterPointer = () => {
          requestAnimationFrame(hideIfInactive)
        }

        window.addEventListener('pointerup', reconcileAfterPointer, { signal })
        window.addEventListener('pointercancel', reconcileAfterPointer, {
          signal,
        })
        window.addEventListener('blur', hide, { signal })
        document.addEventListener(
          'visibilitychange',
          () => {
            if (document.hidden) hide()
          },
          { signal },
        )
        document.addEventListener(
          'astro:before-swap',
          () => controller.abort(),
          { once: true, signal },
        )

        const resizeObserver = new ResizeObserver(() => {
          if (activeRow && region.dataset.highlightVisible !== undefined) {
            moveTo(activeRow)
          }
        })

        rows.forEach((row) => resizeObserver.observe(row))
      })
  }

  const setupArchiveDetails = () => {
    document
      .querySelectorAll<HTMLDetailsElement>('.archive-details')
      .forEach((details) => {
        if (details.dataset.archiveInit !== undefined) return
        details.dataset.archiveInit = ''

        const summary = details.querySelector('summary')
        const list = details.querySelector<HTMLElement>('.archive-list')

        if (!summary || !list) return

        summary.addEventListener('click', async (event) => {
          if (reducedMotion.matches) return

          event.preventDefault()
          if (details.dataset.animating !== undefined) return

          const opening = !details.open
          details.dataset.animating = ''

          if (opening) details.open = true
          else details.dataset.closing = ''

          const hiddenState = { opacity: 0 }
          const visibleState = { opacity: 1 }

          const animation = list.animate(
            opening ? [hiddenState, visibleState] : [visibleState, hiddenState],
            { duration: 200, easing: 'ease-out' },
          )

          try {
            await animation.finished
            if (!opening) details.open = false
          } finally {
            delete details.dataset.animating
            delete details.dataset.closing
          }
        })
      })
  }

  document.addEventListener('astro:page-load', () => {
    setupArticleHighlights()
    setupArchiveDetails()
  })
</script>

<style>
  .article-list-region {
    --highlight-y: 0px;
    --highlight-height: 0px;
    position: relative;
  }

  .article-list-region::before {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    height: var(--highlight-height);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--color-neutral-800) 60%, transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, var(--highlight-y), 0);
    transition:
      transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
      opacity 150ms ease-out;
    will-change: transform, height, opacity;
  }

  .article-list-region[data-highlight-visible]::before {
    opacity: 1;
  }

  .article-list-region[data-highlight-positioning]::before {
    transition: none;
  }

  .article-row {
    position: relative;
    z-index: 1;
    padding-block: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-list-region::before {
      transition: opacity 150ms ease-out;
    }
  }
</style>
