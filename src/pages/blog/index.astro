---
import { getCollection } from 'astro:content'
import ArticlePreview from '@components/ArticlePreview.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'
import { ChevronRightIcon, SearchIcon } from 'lucide-react'

const visiblePosts = await getCollection('blog').then((posts) =>
  posts
    .filter(
      (post) =>
        (import.meta.env.DEV || !post.data.hidden) &&
        (import.meta.env.DEV || post.data.draft !== true),
    )
    .sort(
      (a, b) =>
        (b.data.updatedDate ?? b.data.pubDate).getTime() -
        (a.data.updatedDate ?? a.data.pubDate).getTime(),
    ),
)

const articles = visiblePosts.filter((post) => !post.data.archived)
const archivedArticles = visiblePosts.filter((post) => post.data.archived)
---

<Layout
  title="Blog - Kirill Tregubov"
  description="Articles by Kirill Tregubov about software development, projects, and the decisions behind them."
  bodyClass="flex flex-col"
>
  <main class="mx-auto w-full max-w-240 grow">
    <ReturnHome />
    <header class="mt-6 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0">
      <h1 class="text-3xl font-semibold text-neutral-100">Blog</h1>
      <p class="mt-3 max-w-180 text-lg text-neutral-400">
        Notes on software development, interface design, and the projects I’ve
        built.
      </p>
    </header>
    <label class="group relative mt-6 block max-w-120 motion-safe:animate-[fadeUp_0.6s_forwards_0.25s] motion-safe:opacity-0">
      <span class="sr-only">Search blog posts</span>
      <SearchIcon
        className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-neutral-500 transition-colors group-hover:text-neutral-400 group-focus-within:text-neutral-400"
        aria-hidden="true"
      />
      <input
        id="blog-search"
        type="search"
        placeholder="Search posts..."
        autocomplete="off"
        aria-controls="blog-article-list blog-archive-list"
        class="w-full rounded-lg border border-neutral-700 bg-neutral-800 py-2 pr-3 pl-9 text-base text-neutral-100 transition outline-none placeholder:text-neutral-400 placeholder:select-none hover:border-neutral-600 hover:bg-neutral-700 focus-visible:border-neutral-600 focus-visible:bg-neutral-700 focus-visible:ring-neutral-300! active:border-neutral-500 active:bg-neutral-600 selection:bg-neutral-300 selection:text-neutral-950"
      />
    </label>
    <div class="article-list-region -mx-3 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0 lg:-mx-6">
      <ul id="blog-article-list" class="mt-6">
        {articles.map((article) => (
          <li
            class="article-row"
            data-search={[
              article.data.title,
              article.data.description,
              ...article.data.tags,
            ]
              .join(' ')
              .toLocaleLowerCase()}
          >
            <ArticlePreview article={article} />
          </li>
        ))}
      </ul>
      {archivedArticles.length > 0 && (
        <div class="archive-region mx-3 mt-10 motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0 lg:mx-6">
          <details
            class="archive-details group/archive"
            style={`animation-delay: ${0.3 + articles.length * 0.1}s`}
          >
            <summary class="relative z-1 px-2 py-1 -mx-2 -my-1 rounded-lg flex w-full cursor-pointer items-center gap-2 text-lg font-semibold text-neutral-300 select-none marker:content-none group">
              <span class="flex items-baseline gap-1 pt-px">
                <span class="group-hover:text-white group-focus-visible:text-white group-active:text-white transition">
                  Archive
                </span>
                <span class="text-sm font-normal text-neutral-500">
                  (<span class="archive-count">{archivedArticles.length}</span>)
                </span>
              </span>
              <ChevronRightIcon
                className="archive-chevron size-4 transition text-neutral-500 group-hover:text-white group-focus-visible:text-white group-active:text-white group-open/archive:rotate-90"
                aria-hidden="true"
              />
            </summary>
            <ul id="blog-archive-list" class="archive-list -mx-3 mt-3 lg:-mx-6">
              {archivedArticles.map((article) => (
                <li
                  class="article-row"
                  data-search={[
                    article.data.title,
                    article.data.description,
                    ...article.data.tags,
                  ]
                    .join(' ')
                    .toLocaleLowerCase()}
                >
                  <ArticlePreview article={article} />
                </li>
              ))}
            </ul>
          </details>
        </div>
      )}
      <div
        class="blog-no-results mx-3 mt-6 hidden rounded-xl border border-dashed border-white/15 px-6 py-12 text-center lg:mx-6"
        role="status"
        aria-live="polite"
      >
        <p class="font-medium text-neutral-300">No matching posts found.</p>
        <p class="mt-1 text-sm text-neutral-500">
          Try another title, topic, or keyword.
        </p>
      </div>
    </div>
  </main>
</Layout>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')
  const supportsHighlightMovement = window.matchMedia(
    '(hover: hover) and (pointer: fine)',
  )

  const setupArticleHighlights = () => {
    document
      .querySelectorAll<HTMLElement>('.article-list-region')
      .forEach((region) => {
        if (region.dataset.highlightInit !== undefined) return
        region.dataset.highlightInit = ''

        const rows = region.querySelectorAll<HTMLElement>('.article-row')
        const controller = new AbortController()
        const { signal } = controller
        let activeRow: HTMLElement | null = null
        let resetTimer: number | undefined

        const moveTo = (row: HTMLElement) => {
          const inset = 4
          const regionRect = region.getBoundingClientRect()
          const rowRect = row.getBoundingClientRect()
          const wasVisible = region.dataset.highlightVisible !== undefined
          const shouldReplayOpacity =
            wasVisible &&
            !supportsHighlightMovement.matches &&
            activeRow !== row

          window.clearTimeout(resetTimer)
          if (!wasVisible || shouldReplayOpacity) {
            delete region.dataset.highlightVisible
            region.dataset.highlightPositioning = ''
          }

          activeRow = row
          region.style.setProperty(
            '--highlight-y',
            `${rowRect.top - regionRect.top + inset}px`,
          )
          region.style.setProperty(
            '--highlight-height',
            `${Math.max(0, rowRect.height - inset * 2)}px`,
          )

          if (!wasVisible || shouldReplayOpacity) {
            void region.offsetWidth
            delete region.dataset.highlightPositioning
          }

          region.dataset.highlightVisible = ''
        }

        const hide = () => {
          delete region.dataset.highlightVisible
          activeRow = null
          window.clearTimeout(resetTimer)
          resetTimer = window.setTimeout(() => {
            if (region.dataset.highlightVisible !== undefined) return

            region.dataset.highlightPositioning = ''
            region.style.setProperty('--highlight-y', '0px')
            region.style.setProperty('--highlight-height', '0px')
            void region.offsetWidth
            delete region.dataset.highlightPositioning
          }, 150)
        }

        const hasKeyboardFocus = () => {
          const focusedElement = document.activeElement

          return (
            focusedElement instanceof HTMLElement &&
            region.contains(focusedElement) &&
            focusedElement.matches(':focus-visible')
          )
        }

        const hideIfInactive = () => {
          if (!region.matches(':hover') && !hasKeyboardFocus()) hide()
        }

        rows.forEach((row) => {
          row.addEventListener('pointerenter', () => moveTo(row))
          row.addEventListener('focusin', () => moveTo(row))
        })

        region.addEventListener('pointerleave', hideIfInactive)

        region
          .querySelectorAll<HTMLDetailsElement>('.archive-details')
          .forEach((details) => {
            const summary = details.querySelector('summary')

            summary?.addEventListener('pointerenter', hide, { signal })
            summary?.addEventListener('focusin', hide, { signal })
            details.addEventListener(
              'toggle',
              () => {
                if (!details.open && activeRow && details.contains(activeRow)) {
                  hide()
                }
              },
              { signal },
            )
          })

        region.addEventListener('focusout', () => {
          requestAnimationFrame(() => {
            const focusedRow =
              document.activeElement?.closest<HTMLElement>('.article-row')

            if (focusedRow && region.contains(focusedRow)) moveTo(focusedRow)
            else hideIfInactive()
          })
        })

        const reconcileAfterPointer = () => {
          requestAnimationFrame(hideIfInactive)
        }

        window.addEventListener('pointerup', reconcileAfterPointer, { signal })
        window.addEventListener('pointercancel', reconcileAfterPointer, {
          signal,
        })
        window.addEventListener('blur', hide, { signal })
        document.addEventListener(
          'visibilitychange',
          () => {
            if (document.hidden) hide()
          },
          { signal },
        )
        document.addEventListener(
          'astro:before-swap',
          () => controller.abort(),
          { once: true, signal },
        )

        const resizeObserver = new ResizeObserver(() => {
          if (activeRow && region.dataset.highlightVisible !== undefined) {
            moveTo(activeRow)
          }
        })

        rows.forEach((row) => resizeObserver.observe(row))
      })
  }

  const setupArchiveDetails = () => {
    document
      .querySelectorAll<HTMLDetailsElement>('.archive-details')
      .forEach((details) => {
        if (details.dataset.archiveInit !== undefined) return
        details.dataset.archiveInit = ''

        const summary = details.querySelector('summary')
        const list = details.querySelector<HTMLElement>('.archive-list')

        if (!summary || !list) return

        summary.addEventListener('click', async (event) => {
          if (reducedMotion.matches) return

          event.preventDefault()
          if (details.dataset.animating !== undefined) return

          const opening = !details.open
          details.dataset.animating = ''

          if (opening) details.open = true
          else details.dataset.closing = ''

          const hiddenState = { opacity: 0 }
          const visibleState = { opacity: 1 }

          const animation = list.animate(
            opening ? [hiddenState, visibleState] : [visibleState, hiddenState],
            { duration: 200, easing: 'ease-out' },
          )

          try {
            await animation.finished
            if (!opening) details.open = false
          } finally {
            delete details.dataset.animating
            delete details.dataset.closing
          }
        })
      })
  }

  const setupArticleSearch = () => {
    const searchInput = document.querySelector<HTMLInputElement>('#blog-search')
    if (!searchInput || searchInput.dataset.searchInit !== undefined) return
    searchInput.dataset.searchInit = ''

    const articleList =
      document.querySelector<HTMLElement>('#blog-article-list')
    const archiveList =
      document.querySelector<HTMLElement>('#blog-archive-list')
    const archiveRegion = document.querySelector<HTMLElement>('.archive-region')
    const archiveDetails =
      archiveRegion?.querySelector<HTMLDetailsElement>('.archive-details')
    const archiveCount =
      archiveRegion?.querySelector<HTMLElement>('.archive-count')
    const noResults = document.querySelector<HTMLElement>('.blog-no-results')
    const articleRows = Array.from(
      articleList?.querySelectorAll<HTMLElement>('.article-row') ?? [],
    )
    const archiveRows = Array.from(
      archiveList?.querySelectorAll<HTMLElement>('.article-row') ?? [],
    )
    let archiveWasOpen = archiveDetails?.open ?? false
    let hadQuery = false
    const controller = new AbortController()
    const { signal } = controller

    const filterRows = (rows: HTMLElement[], query: string) => {
      let matches = 0

      rows.forEach((row) => {
        const matchesQuery = !query || row.dataset.search?.includes(query)
        row.hidden = !matchesQuery
        if (matchesQuery) matches += 1
      })

      return matches
    }

    const updateResults = () => {
      const query = searchInput.value.trim().toLocaleLowerCase()
      if (query && !hadQuery) archiveWasOpen = archiveDetails?.open ?? false
      const articleMatches = filterRows(articleRows, query)
      const archiveMatches = filterRows(archiveRows, query)

      if (articleList) articleList.hidden = articleMatches === 0
      if (archiveRegion) archiveRegion.hidden = archiveMatches === 0
      if (archiveCount) archiveCount.textContent = String(archiveMatches)
      if (archiveDetails) {
        archiveDetails.open = query ? archiveMatches > 0 : archiveWasOpen
      }
      if (noResults) {
        noResults.classList.toggle(
          'hidden',
          articleMatches + archiveMatches > 0,
        )
      }
      hadQuery = Boolean(query)
    }

    searchInput.addEventListener('input', updateResults, { signal })
    document.addEventListener('astro:before-swap', () => controller.abort(), {
      once: true,
      signal,
    })
    updateResults()
  }

  document.addEventListener('astro:page-load', () => {
    setupArticleSearch()
    setupArticleHighlights()
    setupArchiveDetails()
  })
</script>

<style>
  .article-list-region {
    --highlight-y: 0px;
    --highlight-height: 0px;
    position: relative;
  }

  .article-list-region::before {
    position: absolute;
    z-index: 0;
    top: 0;
    right: 0;
    left: 0;
    height: var(--highlight-height);
    border-radius: 0.75rem;
    background: color-mix(in oklab, var(--color-neutral-800) 60%, transparent);
    content: '';
    opacity: 0;
    pointer-events: none;
    transform: translate3d(0, var(--highlight-y), 0);
    transition: opacity 150ms ease-out;
    will-change: opacity;
  }

  @media (hover: hover) and (pointer: fine) {
    .article-list-region::before {
      transition:
        transform 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
        height 240ms cubic-bezier(0.2, 0.8, 0.2, 1),
        opacity 150ms ease-out;
      will-change: transform, height, opacity;
    }
  }

  .article-list-region[data-highlight-visible]::before {
    opacity: 1;
  }

  .article-list-region[data-highlight-positioning]::before {
    transition: none;
  }

  .article-row {
    position: relative;
    z-index: 1;
    padding-block: 0.25rem;
  }

  @media (prefers-reduced-motion: reduce) {
    .article-list-region::before {
      transition: opacity 150ms ease-out;
    }
  }
</style>
