---
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { Code } from 'astro:components'
import ReturnHome from '@components/ReturnHome.astro'
import Button from '@components/ui/Button.astro'
import SavedTweet from '@components/SavedTweet.astro'
import Layout from '@layouts/Layout.astro'
import { solidColors } from '@styles/classes'
import { ArrowUpRightIcon, ExternalLinkIcon } from 'lucide-react'

type SavedEntry = CollectionEntry<'saved'>
type ResourceData = Extract<SavedEntry['data'], { type: 'resource' }>
type ResourceEntry = SavedEntry & { data: ResourceData }
type PostEntry = SavedEntry & {
  data: Exclude<SavedEntry['data'], ResourceData>
}

const typeLabels = {
  tweet: 'Post',
  quote: 'Quote',
  snippet: 'Snippet',
  link: 'Link',
} as const

const isResource = (item: SavedEntry): item is ResourceEntry =>
  item.data.type === 'resource'

const collection = await getCollection('saved')

// `date` is when I found something. Sorted newest first; same-day items keep
// their order in saved.yaml.
const byDate = (a: SavedEntry, b: SavedEntry) =>
  b.data.date.getTime() - a.data.date.getTime() || a.data.order - b.data.order

const posts = collection
  .filter((item): item is PostEntry => !isResource(item))
  .sort(byDate)
const resources = collection.filter(isResource).sort(byDate)
const design = posts.filter(({ data }) => data.category === 'design')
const feed = posts.filter(({ data }) => data.category === undefined)
const postSections = [
  { id: 'feed', title: 'Feed', items: feed, enterClass: 'enter-3' },
  { id: 'design', title: 'Design', items: design, enterClass: 'enter-4' },
]

const dateFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
  timeZone: 'UTC',
})
const monthFormat = new Intl.DateTimeFormat('en-CA', {
  year: 'numeric',
  month: 'short',
  timeZone: 'UTC',
})

const hostname = (url: string) => new URL(url).hostname.replace(/^www\./, '')
const siteName = (url: string) => {
  const host = hostname(url)
  return host === 'x.com' || host === 'twitter.com' ? 'X' : host
}

const cardClass = [
  'group flex rounded-xl border p-4 transition duration-150 hover:border-neutral-600 focus-visible:border-neutral-600 active:scale-[0.99]',
  solidColors.savedCard.background,
  solidColors.savedCard.border,
  solidColors.savedCard.hoverBackground,
]
const cardTitleClass =
  'leading-snug font-medium text-neutral-200 transition group-hover:text-white group-focus-visible:text-white'
const cardArrowClass =
  'size-5 shrink-0 text-neutral-500 transition group-hover:text-neutral-200 group-focus-visible:text-neutral-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5 motion-safe:group-focus-visible:translate-x-0.5 motion-safe:group-focus-visible:-translate-y-0.5'
const tagClass =
  'rounded-sm bg-neutral-800 px-1.5 py-0.5 text-xs text-neutral-400'
---

<Layout
  title="Saved - Kirill Tregubov"
  description="Things I saved for later."
  bodyClass="flex flex-col"
  footerClass="enter-5"
  referrerPolicy="same-origin"
  noindex
>
  <main class="mx-auto w-full max-w-360 grow">
    <ReturnHome containerClass="max-sm:flex-col max-sm:items-start max-sm:gap-2">
      <nav aria-label="Sections" class="flex flex-wrap gap-4 sm:gap-5">
        <Button variant="ghost" href="#resources">
          Resources <span class="text-neutral-500">{resources.length}</span>
        </Button>
        {postSections.map(({ id, title, items }) => (
          <Button variant="ghost" href={`#${id}`}>
            {title} <span class="text-neutral-500">{items.length}</span>
          </Button>
        ))}
      </nav>
    </ReturnHome>
    <header class="mt-6 enter-1">
      <h1 class="text-3xl font-semibold text-neutral-100">Saved</h1>
      <p class="mt-3 text-lg text-neutral-400">Things I saved for later.</p>
    </header>

    <section
      id="resources"
      aria-labelledby="resources-title"
      class="mt-10 scroll-mt-24 enter-2 sm:scroll-mt-20"
    >
      <h2 id="resources-title" class="text-xl font-semibold text-neutral-100">
        Resources
      </h2>
      <ul class="mt-6 grid grid-cols-[repeat(auto-fill,minmax(min(100%,20rem),1fr))] gap-4">
        {resources.map(({ data }) => (
          <li>
            <a
              href={data.url}
              target="_blank"
              rel="noopener"
              class:list={[cardClass, 'h-full flex-col']}
            >
              <span class="flex items-start justify-between gap-3">
                <span class:list={[cardTitleClass, 'min-w-0 text-lg']}>
                  {data.title}
                </span>
                <ArrowUpRightIcon
                  className={`${cardArrowClass} mt-1`}
                  aria-hidden="true"
                />
              </span>
              {hostname(data.url) !== data.title && (
                <span class="mt-0.5 truncate text-sm text-neutral-500">
                  {hostname(data.url)}
                </span>
              )}
              {data.description && (
                <span class="mt-2 text-sm leading-relaxed text-neutral-400">
                  {data.description}
                </span>
              )}
              <span class="mt-auto flex items-end justify-between gap-3 pt-4">
                <span class="flex flex-wrap gap-1.5">
                  {data.tags.map((tag) => (
                    <span class={tagClass}>{tag}</span>
                  ))}
                </span>
                <time
                  datetime={data.date.toISOString()}
                  class="shrink-0 text-xs text-neutral-400"
                >
                  {monthFormat.format(data.date)}
                </time>
              </span>
            </a>
            {data.note && (
              <p class="mt-2 px-1 text-sm whitespace-pre-line text-neutral-400">
                {data.note}
              </p>
            )}
          </li>
        ))}
      </ul>

      {resources.length === 0 && (
        <p class="mt-6 text-neutral-500">No resources yet.</p>
      )}
    </section>

    {postSections.map(({ id, title, items, enterClass }) => {
      const listId = `${id}-list`
      const presentTypes = (
        Object.keys(typeLabels) as (keyof typeof typeLabels)[]
      )
        .map((type) => ({
          type,
          count: items.filter((item) => item.data.type === type).length,
        }))
        .filter(({ count }) => count > 0)
      return (
        <section
          {id}
          data-saved-posts
          aria-labelledby={`${id}-title`}
          class:list={[
            'mt-6 scroll-mt-24 border-t border-neutral-800 pt-10 sm:scroll-mt-20',
            enterClass,
          ]}
        >
          <div class="flex flex-wrap items-center justify-between gap-4">
            <h2
              id={`${id}-title`}
              class="text-xl font-semibold text-neutral-100"
            >
              {title}
            </h2>
            {presentTypes.length > 1 && (
              <div
                data-saved-filters
                class="flex flex-wrap gap-2"
                role="group"
                aria-label="Filter by type"
              >
                <Button
                  size="sm"
                  data-filter=""
                  aria-pressed="true"
                  aria-controls={listId}
                >
                  All{' '}
                  <span class="text-neutral-500 in-aria-pressed:text-neutral-300">
                    {items.length}
                  </span>
                </Button>
                {presentTypes.map(({ type, count }) => (
                  <Button
                    size="sm"
                    data-filter={type}
                    aria-pressed="false"
                    aria-controls={listId}
                  >
                    {typeLabels[type]}s{' '}
                    <span class="text-neutral-500 in-aria-pressed:text-neutral-300">
                      {count}
                    </span>
                  </Button>
                ))}
              </div>
            )}
          </div>

          {presentTypes.length > 1 && (
            <p
              data-saved-filter-status
              class="sr-only"
              role="status"
              aria-atomic="true"
            ></p>
          )}

          <!-- Masonry columns: each at least 24rem: 1 on phones, up to 3 at max width. -->
          <ul id={listId} data-saved-list class="mt-6 columns-sm gap-8">
            {items.map(({ data }) => {
              // Quotes have their own source button instead.
              const href =
                data.type === 'snippet'
                  ? data.source
                  : data.type === 'quote'
                    ? undefined
                    : data.url
              return (
                <li data-type={data.type} class="mb-10 break-inside-avoid">
                  <div class="mb-3 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500">
                    <span class="font-medium text-neutral-400">
                      {typeLabels[data.type]}
                    </span>
                    <span aria-hidden="true">·</span>
                    <time datetime={data.date.toISOString()}>
                      {dateFormat.format(data.date)}
                    </time>
                    {data.tags.map((tag) => (
                      <span class={tagClass}>{tag}</span>
                    ))}
                    {href && (
                      <a
                        href={href}
                        target="_blank"
                        rel="noopener"
                        class="ml-auto inline-flex items-center gap-1 rounded-sm transition hover:text-white focus-visible:text-white"
                      >
                        {data.type === 'snippet' ? 'Source' : 'Open'}
                        <ExternalLinkIcon
                          className="size-3.5"
                          aria-hidden="true"
                        />
                      </a>
                    )}
                  </div>

                  {data.type === 'tweet' && <SavedTweet url={data.url} />}

                  {data.type === 'link' && (
                    <a
                      href={data.url}
                      target="_blank"
                      rel="noopener"
                      class:list={[cardClass, 'items-center gap-4']}
                    >
                      <span class="min-w-0 flex-1">
                        <span class:list={[cardTitleClass, 'block']}>
                          {data.title}
                        </span>
                        <span class="mt-1 block truncate text-sm text-neutral-500">
                          {hostname(data.url)}
                        </span>
                      </span>
                      <ArrowUpRightIcon
                        className={cardArrowClass}
                        aria-hidden="true"
                      />
                    </a>
                  )}

                  {data.type === 'quote' && (
                    <figure>
                      <blockquote class="border-l-2 border-neutral-600 pl-4 leading-relaxed whitespace-pre-line text-neutral-200">
                        {data.text.trim()}
                      </blockquote>
                      <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-3">
                        <span class="min-w-0 text-sm text-neutral-400">
                          {data.author && (
                            <span class="block text-neutral-300">
                              {data.author}
                            </span>
                          )}
                          {data.title && (
                            <cite class="not-italic">{data.title}</cite>
                          )}
                        </span>
                        <Button
                          href={data.source}
                          external
                          size="sm"
                          class="group"
                        >
                          Read on {siteName(data.source)}
                          <ArrowUpRightIcon
                            className="size-4 text-neutral-500 transition group-hover:text-neutral-200 group-focus-visible:text-neutral-200 motion-safe:group-hover:translate-x-0.5 motion-safe:group-hover:-translate-y-0.5"
                            aria-hidden="true"
                          />
                        </Button>
                      </figcaption>
                    </figure>
                  )}

                  {data.type === 'snippet' && (
                    <>
                      <h3 class="mb-2 font-medium text-neutral-100">
                        {data.title}
                      </h3>
                      <Code
                        code={data.code.trimEnd()}
                        lang={data.lang as 'plaintext'}
                        class="overflow-x-auto rounded-xl px-4 py-3 text-sm"
                      />
                    </>
                  )}

                  {data.note && (
                    <p class="mt-3 whitespace-pre-line text-neutral-400">
                      {data.note}
                    </p>
                  )}
                </li>
              )
            })}
          </ul>

          {items.length === 0 && (
            <p class="mt-6 text-neutral-500">Nothing saved yet.</p>
          )}
        </section>
      )
    })}
  </main>
</Layout>

<script>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-saved-posts]').forEach((section) => {
      const filters = section.querySelector<HTMLElement>('[data-saved-filters]')
      const status = section.querySelector('[data-saved-filter-status]')
      if (!filters || !status || filters.dataset.init !== undefined) return
      filters.dataset.init = ''
      const rows = section.querySelectorAll<HTMLElement>(
        '[data-saved-list] > li',
      )

      filters.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>(
          'button[data-filter]',
        )
        if (!button) return
        const type = button.dataset.filter
        filters.querySelectorAll('button').forEach((b) => {
          b.setAttribute('aria-pressed', String(b === button))
        })
        let visibleCount = 0
        rows.forEach((row) => {
          row.hidden = Boolean(type) && row.dataset.type !== type
          if (!row.hidden) visibleCount++
        })
        status.textContent = `Showing ${visibleCount} of ${rows.length} saved items.`
      })
    })
  })
</script>
