---
import { getCollection } from 'astro:content'
import { LocateFixedIcon, SearchIcon, XIcon } from 'lucide-react'
import ExperienceBadge from '@components/cineplex-badges/ExperienceBadge.astro'
import PageContainer from '@components/PageContainer.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'

const theatres = (await getCollection('cinemas'))
  .map((theatre) => ({
    ...theatre,
    formats: Array.from(
      new Set(theatre.data.auditoriums.flatMap(({ formats }) => formats)),
    ),
  }))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))

const auditoriumCount = theatres.reduce(
  (total, theatre) => total + theatre.data.auditoriumCount,
  0,
)

const formats = new Set(theatres.flatMap((theatre) => theatre.formats))

const formatCount = formats.size

// const premiumFormatCount = [...formats].filter(
//   (format) => format !== 'Regular',
// ).length

const formatPriority: Record<string, number> = {
  'IMAX 70mm': 0,
  IMAX: 1,
  UltraAVX: 2,
  SCREENX: 3,
  '70mm': 4,
  'VIP 19+': 5,
  '4DX': 6,
  Regular: 7,
}

const formatOptions = Array.from(
  new Set(theatres.flatMap((theatre) => theatre.formats)),
).sort(
  (a, b) =>
    (formatPriority[a] ?? Number.POSITIVE_INFINITY) -
      (formatPriority[b] ?? Number.POSITIVE_INFINITY) || a.localeCompare(b),
)

type ScreenShape = {
  filterLabel: string
  listingLabel?: string
}

const screenShapeByRatio = new Map<string, ScreenShape>([
  ['1.43:1', { filterLabel: 'IMAX 1.43' }],
  ['1.90:1', { filterLabel: 'IMAX 1.90', listingLabel: 'Digital' }],
  ['2.20:1', { filterLabel: '70mm' }],
  ['1.85:1', { filterLabel: 'Flat', listingLabel: 'Flat' }],
  ['2.39:1', { filterLabel: 'Scope', listingLabel: 'Scope' }],
])

const getScreenShape = (ratio: string) => screenShapeByRatio.get(ratio)

const screenShapeOptions = Array.from(screenShapeByRatio.values())
  .filter(({ filterLabel }) =>
    theatres.some((theatre) =>
      theatre.data.auditoriums.some(
        ({ screen }) =>
          getScreenShape(screen.ratio)?.filterLabel === filterLabel,
      ),
    ),
  )
  .map(({ filterLabel }) => filterLabel)

const getRatioDiagram = (ratio: string) => {
  const [width = 1, height = 1] = ratio.split(':').map(Number)
  const canvasWidth = 92
  const canvasHeight = 62
  const screenWidth = 84
  const screenHeight = screenWidth / (width / height)

  return {
    x: (canvasWidth - screenWidth) / 2,
    y: (canvasHeight - screenHeight) / 2,
    width: screenWidth,
    height: screenHeight,
  }
}

const getAuditoriumHeading = (auditoriums: string) => {
  return /[-,]/.test(auditoriums) ? 'Auditoriums' : 'Auditorium'
}
---

<Layout
  title="Toronto Cineplex Guide"
  description="A reference to Cineplex viewing formats, auditorium formats, and screen aspect ratios at theatres in the Greater Toronto Area."
  bodyClass="bg-[radial-gradient(circle_at_50%_-12rem,rgb(120_53_15_/_0.2),transparent_35rem),#171717]"
  footerClass="motion-safe:animate-[fadeUp_0.6s_forwards_0.45s] motion-safe:opacity-0"
>
  <PageContainer>
    <ReturnHome />

    <header
      class="mt-2 motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0"
    >
      <div class="grid gap-5">
        <div
          class="relative overflow-hidden rounded-3xl border border-amber-200/16 bg-[#160d08] bg-[radial-gradient(circle_at_88%_-6rem,rgb(252_211_77/0.15),transparent_18rem)] px-6 py-8 sm:px-10"
        >
          <!-- class="relative rounded-3xl border border-amber-200/16 bg-[radial-gradient(circle_at_88%_-6rem,rgb(252_211_77/0.15),transparent_18rem),#160d08] px-6 py-9 sm:px-10 sm:py-12" -->
          <!-- <div
            class="absolute -top-24 right-[12%] size-72 rounded-full bg-amber-300/15 blur-3xl"
            aria-hidden="true"
          >
          </div> -->
          <div
            class="relative grid items-center gap-6 lg:grid-cols-[minmax(0,1fr)_26rem] lg:gap-8"
          >
            <div>
              <!-- <p
                class="mb-4 inline-block border-y border-stone-700 py-1.5 font-serif text-base tracking-wide text-stone-100 italic"
              >
                The Toronto Cineplex Guide
              </p> -->
              <h1
                class="max-w-2xl text-4xl font-bold tracking-tighter text-balance text-white sm:text-5xl"
              >
                The right movie experience starts before showtime.
              </h1>
              <p
                class="mt-3 max-w-xl leading-relaxed text-balance text-stone-300 sm:text-base"
              >
                Give your next film the format it deserves. Browse all the
                auditorium details before you book your escape.
              </p>
              <a
                href="#directory"
                class="mt-5 inline-flex rounded-full border border-amber-300/30 bg-amber-300 px-5 py-2.5 text-sm font-semibold text-neutral-950 transition hover:border-amber-200/20 hover:bg-amber-300/85 active:border-amber-200/20 active:bg-amber-300/70"
              >
                Explore theatres
              </a>

              <dl
                class="relative mt-6 hidden flex-wrap gap-x-10 border-t border-white/10 pt-6 lg:flex"
              >
                <div>
                  <dt class="text-xs tracking-wider text-neutral-500 uppercase">
                    Locations
                  </dt>
                  <dd class="mt-1 text-2xl font-semibold text-neutral-100">
                    {theatres.length}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs tracking-wider text-neutral-500 uppercase">
                    Auditoriums
                  </dt>
                  <dd class="mt-1 text-2xl font-semibold text-neutral-100">
                    {auditoriumCount}
                  </dd>
                </div>
                <div>
                  <dt class="text-xs tracking-wider text-neutral-500 uppercase">
                    Formats
                  </dt>
                  <dd class="mt-1 text-2xl font-semibold text-neutral-100">
                    {formatCount}
                  </dd>
                </div>
                <!-- <div>
                  <dt class="text-xs tracking-wider text-neutral-500 uppercase">
                    Coverage
                  </dt>
                  <dd
                    class="mt-1 text-base font-semibold text-neutral-100 sm:text-lg"
                  >
                    Greater Toronto Area
                  </dd>
                </div> -->
              </dl>
            </div>

            <div
              class="relative mr-auto w-full max-w-sm -rotate-2 touch-manipulation rounded-xl bg-[oklch(94.3%_0.0895_95.6815)] text-amber-950 shadow-2xl shadow-black/35 transition-transform duration-300 will-change-transform hover:rotate-0 active:rotate-0 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0 lg:hidden"
            >
              <span
                class="absolute top-[55%] -left-3 size-6 -translate-y-1/2 rounded-full bg-[#160d08]"
                aria-hidden="true"></span>
              <span
                class="absolute top-[55%] -right-3 size-6 -translate-y-1/2 rounded-full bg-[#160d08]"
                aria-hidden="true"></span>
              <div class="p-4 sm:p-6">
                <div
                  class="flex items-center justify-between text-[9px] font-black tracking-[0.2em] uppercase"
                >
                  <span>Cineplex Guide</span><span>Admit One</span>
                </div>
                <div
                  class="mt-4 grid grid-cols-3 gap-3 border-t border-dashed border-amber-950/30 pt-4"
                >
                  <div>
                    <p
                      class="text-[8px] font-bold tracking-wider uppercase opacity-50 sm:text-[9px]"
                    >
                      Locations
                    </p>
                    <p class="mt-0.5 text-xl font-black sm:text-2xl">
                      {theatres.length}
                    </p>
                  </div>
                  <div>
                    <p
                      class="text-[8px] font-bold tracking-wider uppercase opacity-50 sm:text-[9px]"
                    >
                      Auditoriums
                    </p>
                    <p class="mt-0.5 text-xl font-black sm:text-2xl">
                      {auditoriumCount}
                    </p>
                  </div>
                  <div>
                    <p
                      class="text-[8px] font-bold tracking-wider uppercase opacity-50 sm:text-[9px]"
                    >
                      Formats
                    </p>
                    <p class="mt-0.5 text-xl font-black sm:text-2xl">
                      {formatCount}
                    </p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between gap-4">
                  <span
                    class="text-[9px] font-bold tracking-[0.18em] uppercase opacity-55"
                    >Greater Toronto Area</span
                  >
                  <span
                    class="h-7 w-20 bg-[repeating-linear-gradient(90deg,#261205_0,#261205_2px,transparent_2px,transparent_4px,#261205_4px,#261205_5px,transparent_5px,transparent_8px)]"
                    aria-hidden="true"></span>
                </div>
              </div>
            </div>

            <div
              class="relative mx-auto hidden w-full max-w-md rotate-2 touch-manipulation rounded-2xl bg-[oklch(94.3%_0.0895_95.6815)] text-amber-950 shadow-2xl shadow-black/35 transition-transform duration-300 will-change-transform hover:rotate-0 active:rotate-0 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0 lg:block"
            >
              <span
                class="absolute top-[67%] -left-3 size-6 -translate-y-1/2 rounded-full bg-[#160d08]"
                aria-hidden="true"></span>
              <span
                class="absolute top-[67%] -right-3 size-6 -translate-y-1/2 rounded-full bg-[#160d08]"
                aria-hidden="true"></span>
              <div class="p-6">
                <div
                  class="flex items-center justify-between text-[9px] font-black tracking-[0.2em] uppercase"
                >
                  <span>Cineplex Guide</span><span>Admit One</span>
                </div>
                <div>
                  <p
                    class="mt-4 text-[10px] font-bold tracking-[0.18em] uppercase opacity-55"
                  >
                    Your next presentation
                  </p>
                  <p class="mt-0.5 text-3xl font-black tracking-[-0.045em]">
                    Made for this screen.
                  </p>
                </div>
                <div
                  class="mt-3 flex justify-between gap-4 border-t border-dashed border-amber-950/30 pt-4"
                >
                  <div class="flex-1">
                    <p
                      class="text-[9px] font-bold tracking-wider uppercase opacity-50"
                    >
                      Auditorium
                    </p>
                    <p class="mt-0.5 text-base font-black">12</p>
                  </div>
                  <div class="flex-1">
                    <p
                      class="text-[9px] font-bold tracking-wider uppercase opacity-50"
                    >
                      Presentation
                    </p>
                    <p class="mt-0.5 text-base font-black">IMAX</p>
                  </div>
                  <div class="flex-1">
                    <p
                      class="text-[9px] font-bold tracking-wider uppercase opacity-50"
                    >
                      Screen
                    </p>
                    <p class="mt-0.5 text-base font-black">1.43:1</p>
                  </div>
                  <div class="flex-1">
                    <p
                      class="text-[9px] font-bold tracking-wider uppercase opacity-50"
                    >
                      Projection
                    </p>
                    <p class="mt-0.5 text-base font-black">Laser</p>
                  </div>
                </div>
                <div class="mt-4 flex items-center justify-between gap-4">
                  <span
                    class="text-[9px] font-bold tracking-[0.18em] uppercase opacity-55"
                    >Greater Toronto Area</span
                  >
                  <span
                    class="h-7 w-20 bg-[repeating-linear-gradient(90deg,#261205_0,#261205_2px,transparent_2px,transparent_4px,#261205_4px,#261205_5px,transparent_5px,transparent_8px)]"
                    aria-hidden="true"></span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </header>

    <section
      id="directory"
      class="mt-6 scroll-mt-14"
      aria-labelledby="directory-title"
    >
      <div
        class="sticky top-12 z-20 -mx-1 box-content bg-neutral-900 px-1 py-2 pt-4 text-neutral-200 after:pointer-events-none after:absolute after:-bottom-2 after:left-0 after:z-10 after:h-2 after:w-full after:bg-linear-to-b after:from-neutral-900 after:to-transparent after:content-[''] motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0"
      >
        <h2 id="directory-title" class="sr-only">Theatre directory</h2>
        <div
          class="flex flex-col gap-2 md:gap-2.5 lg:grid lg:grid-cols-[minmax(15rem,25rem)_minmax(0,1fr)] lg:items-center lg:gap-4"
        >
          <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2">
            <label class="relative block">
              <span class="sr-only">
                Search theatres, formats, or auditoriums
              </span>
              <SearchIcon
                className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-neutral-500"
                aria-hidden="true"
              />
              <input
                id="theatre-search"
                type="search"
                placeholder="Search theatre, format, or auditorium..."
                autocomplete="off"
                class="w-full rounded-md border border-neutral-700 bg-neutral-800 py-1.5 pr-2 pl-9 text-base text-neutral-200 transition outline-none placeholder:text-neutral-400 placeholder:select-none hover:border-neutral-600 hover:bg-neutral-700 focus-visible:border-neutral-600 focus-visible:bg-neutral-700 focus-visible:ring-neutral-300!"
              />
            </label>
            <button
              id="sort-by-distance"
              type="button"
              class="inline-flex items-center justify-center gap-2 rounded-md border border-neutral-700 bg-neutral-800 px-3 py-1.5 text-sm font-medium text-neutral-300 transition hover:border-neutral-600 hover:bg-neutral-700 hover:text-white focus-visible:ring-1 focus-visible:ring-neutral-300 disabled:cursor-wait disabled:opacity-60"
              aria-describedby="location-status"
            >
              <LocateFixedIcon className="size-4" aria-hidden="true" />
              <span class="hidden sm:inline">Near me</span>
              <span class="sr-only sm:hidden">Sort by distance</span>
            </button>
          </div>
          <div
            id="format-filter-scroller"
            role="group"
            class="flex min-w-0 cursor-grab scrollbar-none gap-1.5 overflow-x-auto select-none [-ms-overflow-style:none] active:cursor-grabbing lg:ml-auto lg:w-fit lg:max-w-full [&::-webkit-scrollbar]:hidden"
            aria-label="Filter by viewing format or screen shape"
          >
            <button
              type="button"
              class="filter-button shrink-0 rounded-full border border-white/10 px-3 py-2 text-sm font-medium text-neutral-400 transition hover:border-white/20 hover:text-white focus-visible:ring-1 focus-visible:ring-inset aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950 aria-pressed:focus-visible:ring-neutral-950"
              data-filter="all"
              aria-pressed="true"
            >
              All
            </button>
            {
              formatOptions.map((format) => (
                <button
                  type="button"
                  class="filter-button inline-flex shrink-0 cursor-pointer items-center rounded-full border border-white/10 px-3 py-2 text-sm font-medium text-neutral-300 shadow-sm shadow-neutral-950/40 transition duration-200 hover:border-white/20 hover:text-white hover:shadow-xs focus-visible:ring-1 focus-visible:ring-inset active:border-white/20 active:bg-neutral-800 active:text-white active:shadow-2xs aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950 aria-pressed:shadow-amber-200/20 aria-pressed:hover:border-amber-200/20 aria-pressed:hover:bg-amber-300/85 aria-pressed:hover:shadow-amber-200/20 aria-pressed:focus-visible:ring-neutral-950 aria-pressed:active:border-amber-200/20 aria-pressed:active:bg-amber-300/70 aria-pressed:active:shadow-amber-200/20"
                  data-filter-type="format"
                  data-filter-value={format}
                  aria-label={`Filter by ${format}`}
                  aria-pressed="false"
                >
                  <ExperienceBadge format={format} />
                </button>
              ))
            }
            <span class="my-1 w-px shrink-0 bg-white/15" aria-hidden="true"
            ></span>
            {
              screenShapeOptions.map((shape) => (
                <button
                  type="button"
                  class="filter-button inline-flex shrink-0 cursor-pointer items-center rounded-full border border-white/10 px-3 py-2 text-sm font-bold text-neutral-300 shadow-sm shadow-neutral-950/40 transition duration-200 hover:border-white/20 hover:text-white hover:shadow-xs focus-visible:ring-1 focus-visible:ring-inset active:border-white/20 active:bg-neutral-800 active:text-white active:shadow-2xs aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950 aria-pressed:shadow-amber-200/20 aria-pressed:hover:border-amber-200/20 aria-pressed:hover:bg-amber-300/85 aria-pressed:hover:shadow-amber-200/20 aria-pressed:focus-visible:ring-neutral-950 aria-pressed:active:border-amber-200/20 aria-pressed:active:bg-amber-300/70 aria-pressed:active:shadow-amber-200/20"
                  data-filter-type="screen-shape"
                  data-filter-value={shape}
                  aria-label={`Filter by ${shape} screens`}
                  aria-pressed="false"
                >
                  {shape}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div
        class="motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0"
      >
        <div
          class="mt-2 flex flex-col gap-y-0.5 text-sm text-neutral-500 sm:flex-row sm:gap-x-2"
        >
          <p id="result-count" class="sm:whitespace-nowrap" aria-live="polite">
            Showing all {theatres.length} locations
          </p>
          <div class="flex items-center gap-1">
            <p
              id="location-status"
              class="before:mr-2 before:hidden before:content-['·'] empty:hidden sm:whitespace-nowrap sm:before:inline"
              aria-live="polite"
            >
            </p>
            <button
              id="clear-distance-sort"
              type="button"
              class="hidden rounded-sm p-0.5 text-neutral-500 transition hover:bg-neutral-800 hover:text-neutral-200 focus-visible:ring-1 focus-visible:ring-neutral-400"
              aria-label="Clear distance sorting"
              title="Clear distance sorting"
            >
              <XIcon className="size-3.5" aria-hidden="true" />
            </button>
          </div>
        </div>

        <ul id="theatre-grid" class="mt-4 grid gap-4 lg:grid-cols-2">
          {
            theatres.map((theatre, index) => {
              const formats = JSON.stringify(theatre.formats)
              const searchableAddress = theatre.data.location
                ? Object.values(theatre.data.location.address).join(' ')
                : ''
              const googleMapsUrl = theatre.data.location
                ? `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(`${theatre.data.name}, ${searchableAddress}`)}`
                : undefined
              const appleMapsUrl = theatre.data.location
                ? `https://maps.apple.com/?q=${encodeURIComponent(`${theatre.data.name}, ${searchableAddress}`)}`
                : undefined
              const screenShapes = JSON.stringify(
                Array.from(
                  new Set(
                    theatre.data.auditoriums
                      .map(
                        ({ screen }) =>
                          getScreenShape(screen.ratio)?.filterLabel,
                      )
                      .filter(Boolean),
                  ),
                ),
              )
              return (
                <li class="h-full" data-theatre-id={theatre.data.id}>
                  <article
                    class="theatre-card h-full overflow-hidden rounded-lg border border-white/10 bg-(--theatre-card-background) transition duration-200"
                    data-name={`${theatre.data.name} ${theatre.data.area} ${searchableAddress}`.toLowerCase()}
                    data-formats={formats}
                    data-screen-shapes={screenShapes}
                    data-latitude={theatre.data.location?.coordinates.latitude}
                    data-longitude={
                      theatre.data.location?.coordinates.longitude
                    }
                    style={`--card-delay: ${Math.min(index * 30, 240)}ms; --theatre-card-background: oklch(0.1638 0 0)`}
                  >
                    <header class="border-b border-white/8 px-5 py-5 sm:px-6">
                      <div>
                        <div class="mb-1 flex flex-wrap items-center gap-x-2">
                          <p class="text-xs font-semibold tracking-wider text-amber-300/80 uppercase">
                            {theatre.data.area}
                          </p>
                          <span
                            class="distance-label hidden text-xs text-amber-300/80 before:mr-2 before:text-neutral-700 before:content-['•']"
                            aria-live="polite"
                          />
                        </div>
                        <h3 class="text-lg leading-snug font-semibold text-white">
                          {theatre.data.name}
                        </h3>
                        {theatre.data.location && (
                          <div class="mt-1 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-neutral-500">
                            <address class="not-italic">
                              <a
                                href={googleMapsUrl}
                                class="underline decoration-neutral-700 underline-offset-2 transition hover:text-neutral-300"
                                aria-label={`Open ${theatre.data.name} in Google Maps`}
                              >
                                {theatre.data.location.address.streetAddress},{' '}
                                {theatre.data.location.address.addressLocality},{' '}
                                {theatre.data.location.address.addressRegion}
                              </a>
                            </address>
                            <a
                              href={appleMapsUrl}
                              class="text-xs underline decoration-neutral-700 underline-offset-2 transition hover:text-neutral-300"
                              aria-label={`Open ${theatre.data.name} in Apple Maps`}
                            >
                              Apple Maps
                            </a>
                          </div>
                        )}
                      </div>
                    </header>

                    <ul>
                      {theatre.data.auditoriums.map((auditorium) => {
                        const diagram = getRatioDiagram(auditorium.screen.ratio)
                        const screenShape = getScreenShape(
                          auditorium.screen.ratio,
                        )
                        const isScreenX = auditorium.formats.includes('SCREENX')
                        const right = diagram.x + diagram.width
                        const bottom = diagram.y + diagram.height
                        const corner = 6
                        const screenXDiagram = {
                          x: 23,
                          y: Math.max(13, diagram.y),
                          width: 46,
                          height: Math.min(32, diagram.height),
                        }
                        const screenXRight =
                          screenXDiagram.x + screenXDiagram.width
                        const screenXBottom =
                          screenXDiagram.y + screenXDiagram.height
                        const screenXLeftEdge = diagram.x
                        const screenXRightEdge = right

                        return (
                          <li
                            class="auditorium-row grid grid-cols-[5.75rem_1fr] items-center gap-4 border-white/7 px-5 py-4 sm:grid-cols-[6.5rem_1fr] sm:px-6"
                            data-auditorium-number={auditorium.auditoriums}
                            data-auditorium-formats={JSON.stringify(
                              auditorium.formats,
                            )}
                            data-auditorium-features={JSON.stringify(
                              auditorium.features,
                            )}
                            data-auditorium-ratio={auditorium.screen.ratio}
                            data-auditorium-details={auditorium.details}
                            data-auditorium-screen-shape={
                              screenShape?.filterLabel
                            }
                          >
                            <svg
                              class:list={[
                                'w-full overflow-visible text-neutral-500',
                                isScreenX && 'translate-y-px',
                              ]}
                              viewBox="0 0 92 62"
                              role="img"
                              aria-label={`${auditorium.screen.ratio} screen proportions`}
                            >
                              {isScreenX ? (
                                <>
                                  <path
                                    d={`M ${screenXDiagram.x} ${screenXDiagram.y} L ${screenXLeftEdge} ${screenXDiagram.y - 4} V ${screenXBottom + 5} L ${screenXDiagram.x} ${screenXBottom} Z M ${screenXRight} ${screenXDiagram.y} L ${screenXRightEdge} ${screenXDiagram.y - 4} V ${screenXBottom + 5} L ${screenXRight} ${screenXBottom} Z`}
                                    class="fill-current opacity-[0.07]"
                                  />
                                  <path
                                    d={`M ${screenXDiagram.x} ${screenXDiagram.y} L ${screenXLeftEdge} ${screenXDiagram.y - 4} V ${screenXBottom + 5} L ${screenXDiagram.x} ${screenXBottom} M ${screenXRight} ${screenXDiagram.y} L ${screenXRightEdge} ${screenXDiagram.y - 4} V ${screenXBottom + 5} L ${screenXRight} ${screenXBottom} M ${screenXDiagram.x} ${screenXDiagram.y} H ${screenXRight} V ${screenXBottom} H ${screenXDiagram.x} Z`}
                                    class="stroke-linejoin-round fill-none stroke-current stroke-[1.5] opacity-75 [vector-effect:non-scaling-stroke]"
                                  />
                                </>
                              ) : (
                                <>
                                  <line
                                    x1={diagram.x + 2}
                                    y1="31"
                                    x2={right - 2}
                                    y2="31"
                                    class="stroke-current stroke-[1.25] opacity-55 [stroke-dasharray:4_3] [stroke-linecap:round] [vector-effect:non-scaling-stroke]"
                                  />
                                  <path
                                    d={`M ${diagram.x} ${diagram.y + corner} V ${diagram.y} H ${diagram.x + corner} M ${right - corner} ${diagram.y} H ${right} V ${diagram.y + corner} M ${right} ${bottom - corner} V ${bottom} H ${right - corner} M ${diagram.x + corner} ${bottom} H ${diagram.x} V ${bottom - corner}`}
                                    class="stroke-linecap-round stroke-linejoin-round fill-none stroke-current stroke-[1.5] [vector-effect:non-scaling-stroke]"
                                  />
                                </>
                              )}
                              <rect
                                x="26.5"
                                y="22.5"
                                width="39"
                                height="14"
                                fill="var(--theatre-card-background)"
                              />
                              <text
                                x="46"
                                y={isScreenX ? '30' : '31'}
                                text-anchor="middle"
                                dominant-baseline="middle"
                                class="fill-current text-[13px] font-semibold tracking-[0.02em]"
                              >
                                {auditorium.screen.ratio}
                              </text>
                            </svg>
                            <div class="min-w-0">
                              <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                                {auditorium.formats.map((format) => (
                                  <span class="inline-flex min-h-8 items-center rounded-md border border-white/10 bg-white/4 px-2.5 py-1">
                                    <ExperienceBadge
                                      format={format}
                                      class="text-white"
                                    />
                                  </span>
                                ))}
                                <p class="text-sm text-neutral-500">
                                  {auditorium.screen.ratio}
                                  {screenShape?.listingLabel && (
                                    <span class="ml-1">
                                      ({screenShape.listingLabel})
                                    </span>
                                  )}
                                </p>
                              </div>
                              <p class="mt-2 text-sm text-neutral-400">
                                <span class="text-neutral-600">
                                  {getAuditoriumHeading(auditorium.auditoriums)}
                                </span>{' '}
                                {auditorium.auditoriums}
                              </p>
                              {auditorium.details && (
                                <p class="mt-1 text-sm leading-snug text-neutral-500">
                                  {auditorium.details}
                                </p>
                              )}
                              {auditorium.features.length > 0 && (
                                <div class="mt-2 flex flex-wrap gap-1.5">
                                  {auditorium.features.map((feature) => (
                                    <span class="inline-flex min-h-6 items-center rounded-md border border-neutral-500/15 bg-neutral-500/5 px-2 py-0.5">
                                      <ExperienceBadge
                                        format={feature}
                                        class="text-neutral-300"
                                      />
                                    </span>
                                  ))}
                                </div>
                              )}
                            </div>
                          </li>
                        )
                      })}
                    </ul>

                    {theatre.data.notes.length > 0 && (
                      <div class="border-t border-amber-300/10 bg-amber-300/4 px-5 py-4 sm:px-6">
                        <p class="mb-2 text-xs font-semibold tracking-wider text-amber-200/70 uppercase">
                          Good to know
                        </p>
                        <ul class="space-y-1.5 text-sm leading-relaxed text-neutral-400">
                          {theatre.data.notes.map((note) => (
                            <li class="pl-3 before:mr-2 before:-ml-3 before:text-amber-300/60 before:content-['•']">
                              {note}
                            </li>
                          ))}
                        </ul>
                      </div>
                    )}
                  </article>
                </li>
              )
            })
          }
        </ul>

        <div
          id="no-results"
          class="mt-4 hidden rounded-2xl border border-dashed border-white/15 px-6 py-14 text-center"
        >
          <p class="font-medium text-neutral-300">
            No matching theatres found.
          </p>
          <p class="mt-1 text-sm text-neutral-500">
            Try another search or screen format.
          </p>
        </div>

        <p class="mt-4 text-xs text-neutral-600">
          Location data ©{' '}
          <a
            href="https://www.openstreetmap.org/copyright"
            target="_blank"
            rel="noopener"
            class="underline decoration-neutral-700 underline-offset-2 transition hover:text-neutral-400"
          >
            OpenStreetMap contributors
          </a>.
        </p>
      </div>
    </section>

    <!-- <aside
      class="mt-8 rounded-2xl border border-white/8 bg-white/3 p-5 text-sm leading-relaxed text-neutral-500 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0 sm:p-6"
    >
      <p>
        <strong class="font-semibold text-neutral-300">About this guide.</strong
        > This is a community-compiled, work-in-progress reference—not official Cineplex
        information. Auditorium configurations can change, so confirm with the theatre
        when a specific presentation matters.
      </p>
      <p class="mt-2">
        “Viewing format” is the clearest umbrella here: Regular, UltraAVX, IMAX,
        SCREENX, and 4DX. SCREENX is a 270-degree image experience; 4DX is
        separate, adding motion seats and environmental effects. 2D/3D is
        deliberately left out unless it changes a listed auditorium detail.
      </p>
      <p class="mt-2">
        Screen labels are derived from aspect ratio: Flat is 1.85:1, Scope is
        2.39:1, Digital is 1.90:1, and IMAX 1.43 is 1.43:1. A screen’s physical
        ratio does not guarantee that every film fills it. Dolby Atmos, D-BOX,
        and laser projection are listed against the specific auditorium where
        community evidence identifies them.
      </p>
    </aside> -->
  </PageContainer>

  <script>
    import Fuse from 'fuse.js'

    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname !== '/cineplex-toronto') {
        return
      }

      const searchInput =
        document.querySelector<HTMLInputElement>('#theatre-search')
      const sortByDistanceButton =
        document.querySelector<HTMLButtonElement>('#sort-by-distance')
      const clearDistanceSortButton = document.querySelector<HTMLButtonElement>(
        '#clear-distance-sort',
      )
      const filterScroller = document.querySelector<HTMLElement>(
        '#format-filter-scroller',
      )
      const filterButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.filter-button'),
      )
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>('.theatre-card'),
      )
      const resultCount = document.querySelector<HTMLElement>('#result-count')
      const locationStatus =
        document.querySelector<HTMLElement>('#location-status')
      const noResults = document.querySelector<HTMLElement>('#no-results')
      const directory = document.querySelector<HTMLElement>('#directory')
      const theatreGrid = document.querySelector<HTMLElement>('#theatre-grid')
      const locations = cards.map((card, originalIndex) => {
        const latitude = Number(card.dataset.latitude)
        const longitude = Number(card.dataset.longitude)

        return {
          card,
          listItem: card.parentElement as HTMLLIElement,
          originalIndex,
          latitude:
            card.dataset.latitude && Number.isFinite(latitude)
              ? latitude
              : undefined,
          longitude:
            card.dataset.longitude && Number.isFinite(longitude)
              ? longitude
              : undefined,
          distance: undefined as number | undefined,
          name: card.dataset.name ?? '',
          formats: JSON.parse(card.dataset.formats ?? '[]') as string[],
          screenShapes: JSON.parse(
            card.dataset.screenShapes ?? '[]',
          ) as string[],
          auditoriumRows: Array.from(
            card.querySelectorAll<HTMLElement>('[data-auditorium-formats]'),
          ).map((row) => {
            const formats = JSON.parse(
              row.dataset.auditoriumFormats ?? '[]',
            ) as string[]
            const features = JSON.parse(
              row.dataset.auditoriumFeatures ?? '[]',
            ) as string[]
            const screenShapes = row.dataset.auditoriumScreenShape
              ? [row.dataset.auditoriumScreenShape]
              : []
            const auditoriumNumber = row.dataset.auditoriumNumber ?? ''
            const ratio = row.dataset.auditoriumRatio ?? ''
            const details = row.dataset.auditoriumDetails ?? ''

            return {
              row,
              auditoriumNumber,
              formats,
              features,
              screenShapes,
              ratio,
              details,
              searchText: [
                auditoriumNumber,
                ...formats,
                ...features,
                ...screenShapes,
                ratio,
                details,
              ].join(' '),
            }
          }),
        }
      })
      const theatreFuse = new Fuse(locations, {
        keys: [{ name: 'name', weight: 1 }],
        ignoreLocation: true,
        threshold: 0.3,
      })
      const auditoriumRows = locations.flatMap((location) =>
        location.auditoriumRows.map((auditorium) => ({
          ...auditorium,
          card: location.card,
        })),
      )
      const auditoriumFuse = new Fuse(auditoriumRows, {
        keys: [
          { name: 'auditoriumNumber', weight: 0.35 },
          { name: 'formats', weight: 0.3 },
          { name: 'features', weight: 0.2 },
          { name: 'ratio', weight: 0.1 },
          { name: 'details', weight: 0.05 },
        ],
        ignoreLocation: true,
        threshold: 0.3,
      })
      const auditoriumNumberFuse = new Fuse(auditoriumRows, {
        keys: [
          { name: 'auditoriumNumber', weight: 0.9 },
          { name: 'searchText', weight: 0.1 },
        ],
        ignoreLocation: true,
        threshold: 0.2,
      })
      const auditoriumPrefixes = new Set([
        'a',
        'au',
        'aud',
        'audi',
        'audit',
        'audito',
        'auditor',
        'auditori',
        'auditorium',
      ])
      let activeFilter:
        { type: 'format' | 'screen-shape'; value: string } | undefined
      let animationFrame: number | undefined
      let hasAutoScrolledToDirectory = false

      function distanceInKilometres(
        fromLatitude: number,
        fromLongitude: number,
        toLatitude: number,
        toLongitude: number,
      ) {
        const toRadians = (degrees: number) => (degrees * Math.PI) / 180
        const latitudeDelta = toRadians(toLatitude - fromLatitude)
        const longitudeDelta = toRadians(toLongitude - fromLongitude)
        const fromLatitudeRadians = toRadians(fromLatitude)
        const toLatitudeRadians = toRadians(toLatitude)
        const haversine =
          Math.sin(latitudeDelta / 2) ** 2 +
          Math.cos(fromLatitudeRadians) *
            Math.cos(toLatitudeRadians) *
            Math.sin(longitudeDelta / 2) ** 2

        return (
          6371 * 2 * Math.atan2(Math.sqrt(haversine), Math.sqrt(1 - haversine))
        )
      }

      function formatDistance(distance: number) {
        return distance < 1
          ? `${Math.round(distance * 1000)} m away`
          : `${distance.toFixed(distance < 10 ? 1 : 0)} km away`
      }

      function parseSearchQuery(query: string) {
        const auditoriumQuery = query.match(
          /^([a-z]+)(?:(?:\s+|\s*[:#-]\s*)(.*))?$/i,
        )
        const targetsAuditorium = auditoriumPrefixes.has(
          auditoriumQuery?.[1]?.toLowerCase() ?? '',
        )

        return {
          term: targetsAuditorium
            ? (auditoriumQuery?.[2]?.trim().replace(/^[:#-]\s*/, '') ?? '')
            : query,
          targetsAuditorium,
        }
      }

      function includesAuditoriumNumber(label: string, query: string) {
        const number = Number(query.match(/^\s*(?:vip\s*)?(\d+)\s*$/i)?.[1])
        if (!Number.isInteger(number)) return false

        return Array.from(label.matchAll(/(\d+)(?:\s*-\s*(\d+))?/g)).some(
          ([, startValue, endValue]) => {
            const start = Number(startValue)
            const end = endValue ? Number(endValue) : start
            return (
              number >= Math.min(start, end) && number <= Math.max(start, end)
            )
          },
        )
      }

      function searchAuditoriums(term: string, targetsAuditorium: boolean) {
        if (!term) return auditoriumRows

        const exactNumberMatches = auditoriumRows.filter(
          ({ auditoriumNumber }) =>
            includesAuditoriumNumber(auditoriumNumber, term),
        )
        if (exactNumberMatches.length > 0) return exactNumberMatches

        return (targetsAuditorium ? auditoriumNumberFuse : auditoriumFuse)
          .search(term)
          .map(({ item }) => item)
      }

      function sortByDistance(latitude: number, longitude: number) {
        locations.forEach((location) => {
          location.distance =
            location.latitude !== undefined && location.longitude !== undefined
              ? distanceInKilometres(
                  latitude,
                  longitude,
                  location.latitude,
                  location.longitude,
                )
              : undefined

          const distanceLabel =
            location.card.querySelector<HTMLElement>('.distance-label')
          if (distanceLabel && location.distance !== undefined) {
            distanceLabel.textContent = formatDistance(location.distance)
            distanceLabel.classList.remove('hidden')
          }
        })

        const sortedLocations = [...locations].sort(
          (a, b) =>
            (a.distance ?? Number.POSITIVE_INFINITY) -
              (b.distance ?? Number.POSITIVE_INFINITY) ||
            a.originalIndex - b.originalIndex,
        )
        theatreGrid?.append(...sortedLocations.map(({ listItem }) => listItem))
      }

      function clearDistanceSort() {
        locations.forEach((location) => {
          location.distance = undefined
          const distanceLabel =
            location.card.querySelector<HTMLElement>('.distance-label')
          if (distanceLabel) {
            distanceLabel.textContent = ''
            distanceLabel.classList.add('hidden')
          }
        })

        const originalLocations = [...locations].sort(
          (a, b) => a.originalIndex - b.originalIndex,
        )
        theatreGrid?.append(
          ...originalLocations.map(({ listItem }) => listItem),
        )
        sortByDistanceButton?.setAttribute('aria-pressed', 'false')
        clearDistanceSortButton?.classList.add('hidden')
        if (locationStatus) locationStatus.textContent = ''
      }

      function applyUrlState() {
        const params = new URLSearchParams(window.location.search)
        const format = params.get('format')
        const screenShape = params.get('screen')

        if (searchInput) {
          searchInput.value = params.get('q') ?? ''
        }

        activeFilter = format
          ? { type: 'format', value: format }
          : screenShape
            ? { type: 'screen-shape', value: screenShape }
            : undefined

        const hasMatchingFilter = filterButtons.some(
          (button) =>
            activeFilter &&
            button.dataset.filterType === activeFilter.type &&
            button.dataset.filterValue === activeFilter.value,
        )

        if (!hasMatchingFilter) {
          activeFilter = undefined
        }
      }

      function syncUrl({ replace = true } = {}) {
        const url = new URL(window.location.href)
        const query = searchInput?.value.trim() ?? ''

        if (query) {
          url.searchParams.set('q', query)
        } else {
          url.searchParams.delete('q')
        }

        url.searchParams.delete('format')
        url.searchParams.delete('screen')

        if (activeFilter) {
          url.searchParams.set(
            activeFilter.type === 'format' ? 'format' : 'screen',
            activeFilter.value,
          )
        }

        const nextUrl = `${url.pathname}${url.search}${url.hash}`
        const currentUrl = `${window.location.pathname}${window.location.search}${window.location.hash}`

        if (nextUrl !== currentUrl) {
          window.history[replace ? 'replaceState' : 'pushState'](
            null,
            '',
            nextUrl,
          )
        }
      }

      function matchesActiveFilter({
        formats,
        screenShapes,
      }: {
        formats: string[]
        screenShapes: string[]
      }) {
        if (!activeFilter) return true

        return activeFilter.type === 'format'
          ? formats.includes(activeFilter.value) ||
              (activeFilter.value === 'IMAX' && formats.includes('IMAX 70mm'))
          : screenShapes.includes(activeFilter.value)
      }

      function updateFilterButtons() {
        filterButtons.forEach((button) => {
          const filterType = button.dataset.filterType
          const filterValue = button.dataset.filterValue
          button.setAttribute(
            'aria-pressed',
            String(
              !filterType
                ? !activeFilter
                : activeFilter?.type === filterType &&
                    activeFilter.value === filterValue,
            ),
          )
        })
      }

      function updateResults({
        scrollToDirectory = false,
        sync = false,
        replaceHistory = true,
      } = {}) {
        const query = searchInput?.value.trim() ?? ''
        const { term, targetsAuditorium } = parseSearchQuery(query)
        const hasSearchTerm = Boolean(term)
        const theatreSearchMatches = new Set(
          hasSearchTerm && !targetsAuditorium
            ? theatreFuse.search(query).map(({ item }) => item.card)
            : [],
        )
        const auditoriumSearchMatches = new Set(
          searchAuditoriums(term, targetsAuditorium).map(({ row }) => row),
        )
        let visibleCount = 0

        locations.forEach(
          ({ card, listItem, formats, screenShapes, auditoriumRows }) => {
            const matchesTheatreSearch = theatreSearchMatches.has(card)
            const matchesSearch =
              !hasSearchTerm ||
              matchesTheatreSearch ||
              auditoriumRows.some(({ row }) => auditoriumSearchMatches.has(row))
            const matchesFilter = matchesActiveFilter({ formats, screenShapes })
            const visible = matchesSearch && matchesFilter
            if (listItem.hidden === visible) listItem.hidden = !visible

            const visibleAuditoriumRows = auditoriumRows.filter(
              ({ row, formats, screenShapes }) => {
                const rowMatchesSearch =
                  !hasSearchTerm ||
                  matchesTheatreSearch ||
                  auditoriumSearchMatches.has(row)
                const rowIsVisible =
                  rowMatchesSearch &&
                  matchesActiveFilter({ formats, screenShapes })
                row.hidden = !rowIsVisible
                return rowIsVisible
              },
            )

            visibleAuditoriumRows.forEach(({ row }, index) => {
              row.classList.toggle(
                'border-b',
                index < visibleAuditoriumRows.length - 1,
              )
            })

            if (visible) {
              visibleCount += 1
            }
          },
        )

        if (resultCount) {
          resultCount.textContent =
            visibleCount === cards.length
              ? `Showing all ${cards.length} locations`
              : `Showing ${visibleCount} of ${cards.length} locations`
        }
        noResults?.classList.toggle('hidden', visibleCount !== 0)

        if (sync) {
          syncUrl({ replace: replaceHistory })
        }

        if (
          scrollToDirectory &&
          visibleCount > 0 &&
          directory &&
          !hasAutoScrolledToDirectory
        ) {
          hasAutoScrolledToDirectory = true
          directory.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
            inline: 'start',
          })
        }
      }

      function scheduleResultsUpdate() {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = requestAnimationFrame(() => {
          animationFrame = undefined
          updateResults({ scrollToDirectory: true, sync: true })
        })
      }

      applyUrlState()
      updateFilterButtons()
      updateResults()

      searchInput?.addEventListener('input', scheduleResultsUpdate)
      sortByDistanceButton?.addEventListener('click', () => {
        if (!navigator.geolocation) {
          if (locationStatus) {
            locationStatus.textContent =
              'Location is unavailable in this browser.'
          }
          return
        }

        sortByDistanceButton.disabled = true
        sortByDistanceButton.setAttribute('aria-busy', 'true')
        if (locationStatus) locationStatus.textContent = 'Sorting by distance…'

        navigator.geolocation.getCurrentPosition(
          ({ coords }) => {
            sortByDistance(coords.latitude, coords.longitude)
            sortByDistanceButton.disabled = false
            sortByDistanceButton.removeAttribute('aria-busy')
            sortByDistanceButton.setAttribute('aria-pressed', 'true')
            if (locationStatus) {
              // const locatedCount = locations.filter(
              //   ({ distance }) => distance !== undefined,
              // ).length
              locationStatus.textContent = `Sorted by distance` //  · ${locatedCount} of ${locations.length} theatres located
            }
            clearDistanceSortButton?.classList.remove('hidden')
          },
          (error) => {
            sortByDistanceButton.disabled = false
            sortByDistanceButton.removeAttribute('aria-busy')
            if (locationStatus) {
              locationStatus.textContent =
                error.code === error.PERMISSION_DENIED
                  ? 'Location permission was not granted.'
                  : 'Your location could not be determined.'
            }
          },
          {
            enableHighAccuracy: false,
            timeout: 10_000,
            maximumAge: 300_000,
          },
        )
      })
      clearDistanceSortButton?.addEventListener('click', clearDistanceSort)
      if (filterScroller) {
        let pointerId: number | undefined
        let startX = 0
        let startScrollLeft = 0
        let hasDragged = false
        const dragThreshold = 6

        filterScroller.addEventListener('pointerdown', (event) => {
          if (event.pointerType === 'touch' || event.button !== 0) return

          pointerId = event.pointerId
          startX = event.clientX
          startScrollLeft = filterScroller.scrollLeft
          hasDragged = false
        })

        filterScroller.addEventListener('pointermove', (event) => {
          if (event.pointerId !== pointerId) return

          const distance = event.clientX - startX
          if (!hasDragged && Math.abs(distance) < dragThreshold) return

          if (!hasDragged) {
            hasDragged = true
            filterScroller.setPointerCapture(event.pointerId)
          }

          event.preventDefault()
          filterScroller.scrollLeft = startScrollLeft - distance
        })

        const stopDragging = (event: PointerEvent) => {
          if (event.pointerId !== pointerId) return

          if (filterScroller.hasPointerCapture(event.pointerId)) {
            filterScroller.releasePointerCapture(event.pointerId)
          }
          pointerId = undefined
        }

        filterScroller.addEventListener('pointerup', stopDragging)
        filterScroller.addEventListener('pointercancel', stopDragging)
        filterScroller.addEventListener(
          'click',
          (event) => {
            if (!hasDragged) return

            event.preventDefault()
            event.stopPropagation()
            hasDragged = false
          },
          true,
        )
      }
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const filterType = button.dataset.filterType
          const filterValue = button.dataset.filterValue

          if (!filterType || !filterValue) {
            activeFilter = undefined
          } else if (
            activeFilter?.type === filterType &&
            activeFilter.value === filterValue
          ) {
            activeFilter = undefined
          } else {
            activeFilter = {
              type: filterType as 'format' | 'screen-shape',
              value: filterValue,
            }
          }

          updateFilterButtons()
          updateResults({ sync: true, replaceHistory: false })
        })
      })

      window.addEventListener('popstate', () => {
        applyUrlState()
        updateFilterButtons()
        updateResults()
      })
    })
  </script>
</Layout>
