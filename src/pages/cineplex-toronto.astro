---
import { getCollection } from 'astro:content'
import { SearchIcon } from 'lucide-react'
import ExperienceBadge from '@components/cineplex-badges/ExperienceBadge.astro'
import PageContainer from '@components/PageContainer.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'

const theatres = (await getCollection('cinemas'))
  .map((theatre) => ({
    ...theatre,
    formats: Array.from(
      new Set(theatre.data.auditoriums.flatMap(({ formats }) => formats))
    )
  }))
  .sort((a, b) => a.data.name.localeCompare(b.data.name))

const auditoriumCount = theatres.reduce(
  (total, theatre) => total + theatre.data.auditoriumCount,
  0
)

const premiumFormatCount = new Set(
  theatres.flatMap((theatre) =>
    theatre.formats.filter((format) => format !== 'Regular')
  )
).size

const formatPriority: Record<string, number> = {
  'IMAX 70mm': 0,
  IMAX: 1,
  UltraAVX: 2,
  SCREENX: 3,
  '70mm': 4,
  'VIP 19+': 5,
  '4DX': 6,
  Regular: 7
}

const formatOptions = Array.from(
  new Set(theatres.flatMap((theatre) => theatre.formats))
).sort(
  (a, b) =>
    (formatPriority[a] ?? Number.POSITIVE_INFINITY) -
      (formatPriority[b] ?? Number.POSITIVE_INFINITY) || a.localeCompare(b)
)

type ScreenShape = {
  filterLabel: string
  listingLabel?: string
}

const screenShapeByRatio = new Map<string, ScreenShape>([
  ['1.43:1', { filterLabel: 'IMAX 1.43' }],
  ['1.90:1', { filterLabel: 'IMAX 1.90', listingLabel: 'Digital' }],
  ['2.20:1', { filterLabel: '70mm' }],
  ['1.85:1', { filterLabel: 'Flat', listingLabel: 'Flat' }],
  ['2.39:1', { filterLabel: 'Scope', listingLabel: 'Scope' }]
])

const getScreenShape = (ratio: string) => screenShapeByRatio.get(ratio)

const screenShapeOptions = Array.from(screenShapeByRatio.values())
  .filter(({ filterLabel }) =>
    theatres.some((theatre) =>
      theatre.data.auditoriums.some(
        ({ screen }) =>
          getScreenShape(screen.ratio)?.filterLabel === filterLabel
      )
    )
  )
  .map(({ filterLabel }) => filterLabel)

const getRatioDiagram = (ratio: string) => {
  const [width = 1, height = 1] = ratio.split(':').map(Number)
  const canvasWidth = 92
  const canvasHeight = 62
  const screenWidth = 80
  const screenHeight = screenWidth / (width / height)

  return {
    x: (canvasWidth - screenWidth) / 2,
    y: (canvasHeight - screenHeight) / 2,
    width: screenWidth,
    height: screenHeight
  }
}

const getAuditoriumHeading = (auditoriums: string) => {
  return /[-,]/.test(auditoriums) ? 'Auditoriums' : 'Auditorium'
}
---

<Layout
  title="Toronto Cineplex Screen Guide"
  description="A community-compiled reference to Cineplex viewing formats, Dolby Atmos availability, and screen aspect ratios at theatres in and around Toronto."
  bodyClass="cinema-guide"
  footerClass="cinema-footer motion-safe:animate-[fadeUp_0.6s_forwards_0.45s] motion-safe:opacity-0"
>
  <PageContainer>
    <ReturnHome />

    <header
      class="cinema-hero relative mt-2 overflow-hidden rounded-3xl border border-amber-300/15 bg-neutral-950 px-5 py-8 motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0 sm:px-9 sm:py-11 lg:px-12 lg:py-12 xl:px-14 xl:py-14"
    >
      <div class="screen-glow" aria-hidden="true"></div>
      <div
        class="relative grid items-center gap-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-8 xl:grid-cols-[minmax(0,1fr)_23rem] xl:gap-14"
      >
        <div>
          <p
            class="mb-5 flex items-center gap-2 text-xs font-bold tracking-[0.2em] text-amber-300 uppercase"
          >
            <!-- <span
              class="inline-block size-1.5 rounded-full bg-amber-300 shadow-[0_0_12px_#fcd34d]"
            ></span> -->
            Toronto cinema field guide
          </p>
          <h1
            class="max-w-190 text-4xl leading-[0.98] font-bold tracking-[-0.045em] text-white sm:text-6xl lg:text-[4rem] xl:text-7xl"
          >
            Pick the screen,<br /><span class="text-amber-300"
              >not just the showtime.</span
            >
          </h1>
          <p
            class="mt-6 max-w-165 text-base leading-relaxed text-neutral-300 sm:text-lg"
          >
            Find the exact Cineplex auditorium that fits your film. Compare
            screen shape, viewing format, audio configuration, projector
            technology and more.
          </p>
          <div class="mt-7 flex flex-wrap items-center gap-3">
            <a
              href="#directory"
              class="rounded-full bg-amber-300 px-5 py-2.5 text-sm font-semibold text-neutral-950 transition hover:bg-amber-200 active:translate-y-0.5"
            >
              Explore the directory
            </a>
            <span class="text-sm text-neutral-500"
              >Community-maintained reference</span
            >
          </div>
        </div>

        <!-- <div class="screen-match" aria-label="Screen ratio quick guide">
          <div class="screen-match__topline">
            <span>Screen match</span>
            <span class="screen-match__status">Quick guide</span>
          </div>
          <div class="screen-match__stage" aria-hidden="true">
            <div class="screen-match__screen">
              <span>2.39:1</span>
            </div>
            <div class="screen-match__seats screen-match__seats--back"></div>
            <div class="screen-match__seats screen-match__seats--front"></div>
          </div>
          <div class="screen-match__comparison">
            <div>
              <span class="screen-match__ratio screen-match__ratio--scope"
              ></span>
              <span><strong>Scope</strong> 2.39:1</span>
            </div>
            <div>
              <span class="screen-match__ratio screen-match__ratio--flat"
              ></span>
              <span><strong>Flat</strong> 1.85:1</span>
            </div>
          </div>
          <p>
            Match the film’s shape to the auditorium for the best presentation.
          </p>
        </div> -->
      </div>

      <dl
        class="relative mt-9 grid grid-cols-2 gap-x-4 gap-y-5 border-t border-white/10 pt-6 sm:flex sm:flex-wrap sm:gap-x-10 lg:mt-11"
      >
        <div>
          <dt class="text-xs tracking-wider text-neutral-500 uppercase">
            Locations
          </dt>
          <dd class="mt-1 text-xl font-semibold text-neutral-100 sm:text-2xl">
            {theatres.length}
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-neutral-500 uppercase">
            Auditoriums
          </dt>
          <dd class="mt-1 text-xl font-semibold text-neutral-100 sm:text-2xl">
            {auditoriumCount}
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-neutral-500 uppercase">
            Premium formats
          </dt>
          <dd class="mt-1 text-xl font-semibold text-neutral-100 sm:text-2xl">
            {premiumFormatCount}
          </dd>
        </div>
        <div>
          <dt class="text-xs tracking-wider text-neutral-500 uppercase">
            Coverage
          </dt>
          <dd class="mt-1 text-base font-semibold text-neutral-100 sm:text-lg">
            Greater Toronto Area
          </dd>
        </div>
      </dl>
    </header>

    <section
      id="directory"
      class="mt-6 scroll-mt-14"
      aria-labelledby="directory-title"
    >
      <div
        class="sticky top-14 z-20 -mx-1 box-content bg-neutral-900 px-1 py-2 text-neutral-200 after:pointer-events-none after:absolute after:-bottom-2 after:left-0 after:z-10 after:h-2 after:w-full after:bg-linear-to-b after:from-neutral-900 after:to-transparent after:content-[''] motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0"
      >
        <h2 id="directory-title" class="sr-only">Theatre directory</h2>
        <div
          class="flex flex-col gap-3 lg:grid lg:grid-cols-[minmax(15rem,25rem)_minmax(0,1fr)] lg:items-center lg:gap-5"
        >
          <label class="relative block">
            <span class="sr-only">Search theatres or areas</span>
            <SearchIcon
              className="pointer-events-none absolute top-1/2 left-3 size-4 -translate-y-1/2 text-neutral-500"
              aria-hidden="true"
            />
            <input
              id="theatre-search"
              type="search"
              placeholder="Search theatre or area..."
              autocomplete="off"
              class="w-full rounded-md border border-neutral-700 bg-neutral-800 py-1.5 pr-9 pl-10 text-sm text-neutral-200 transition outline-none placeholder:text-neutral-400 placeholder:select-none hover:border-neutral-600 hover:bg-neutral-700 focus-visible:border-neutral-600 focus-visible:bg-neutral-700 focus-visible:ring-neutral-300!"
            />
          </label>
          <div
            class="flex min-w-0 scrollbar-thin gap-2 overflow-x-auto pb-1 lg:ml-auto lg:w-fit lg:max-w-full lg:pb-0"
            aria-label="Filter by viewing format or screen shape"
          >
            <button
              type="button"
              class="filter-button shrink-0 rounded-full border border-white/10 px-3 py-2 text-sm font-medium text-neutral-400 transition hover:border-white/20 hover:text-white aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950"
              data-filter="all"
              aria-pressed="true"
            >
              All
            </button>
            {
              formatOptions.map((format) => (
                <button
                  type="button"
                  class="filter-button inline-flex shrink-0 cursor-pointer items-center rounded-full border border-white/10 px-3 py-2 text-sm font-medium text-neutral-400 transition hover:border-white/20 hover:text-white aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950"
                  data-filter-type="format"
                  data-filter-value={format}
                  aria-label={`Filter by ${format}`}
                  aria-pressed="false"
                >
                  <ExperienceBadge format={format} />
                </button>
              ))
            }
            <span class="my-1 w-px shrink-0 bg-white/15" aria-hidden="true"
            ></span>
            {
              screenShapeOptions.map((shape) => (
                <button
                  type="button"
                  class="filter-button shrink-0 rounded-full border border-white/10 px-3 py-2 text-sm font-medium text-neutral-400 transition hover:border-white/20 hover:text-white aria-pressed:border-amber-300/30 aria-pressed:bg-amber-300 aria-pressed:text-neutral-950"
                  data-filter-type="screen-shape"
                  data-filter-value={shape}
                  aria-label={`Filter by ${shape} screens`}
                  aria-pressed="false"
                >
                  {shape}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div
        class="motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0"
      >
        <p
          id="result-count"
          class="mt-2 text-sm text-neutral-500"
          aria-live="polite"
        >
          Showing all {theatres.length} locations
        </p>

        <div id="theatre-grid" class="mt-3 grid gap-4 lg:grid-cols-2">
          {
            theatres.map((theatre, index) => {
              const formats = JSON.stringify(theatre.formats)
              const screenShapes = JSON.stringify(
                Array.from(
                  new Set(
                    theatre.data.auditoriums
                      .map(
                        ({ screen }) =>
                          getScreenShape(screen.ratio)?.filterLabel
                      )
                      .filter(Boolean)
                  )
                )
              )
              return (
                <article
                  class="theatre-card overflow-hidden rounded-2xl border border-white/10 bg-neutral-950/70 transition duration-200 hover:border-white/20"
                  data-name={`${theatre.data.name} ${theatre.data.area}`.toLowerCase()}
                  data-formats={formats}
                  data-screen-shapes={screenShapes}
                  style={`--card-delay: ${Math.min(index * 30, 240)}ms`}
                >
                  <header class="border-b border-white/8 px-5 py-5 sm:px-6">
                    <div>
                      <p class="mb-1 text-xs font-semibold tracking-wider text-amber-300/80 uppercase">
                        {theatre.data.area}
                      </p>
                      <h3 class="text-lg leading-snug font-semibold text-white">
                        {theatre.data.name}
                      </h3>
                    </div>
                  </header>

                  <div class="divide-y divide-white/7">
                    {theatre.data.auditoriums.map((auditorium) => {
                      const diagram = getRatioDiagram(auditorium.screen.ratio)
                      const screenShape = getScreenShape(
                        auditorium.screen.ratio
                      )
                      const right = diagram.x + diagram.width
                      const bottom = diagram.y + diagram.height
                      const corner = 6

                      return (
                        <div
                          class="auditorium-row grid grid-cols-[5.75rem_1fr] items-center gap-4 px-5 py-4 sm:grid-cols-[6.5rem_1fr] sm:px-6"
                          data-auditorium-formats={JSON.stringify(
                            auditorium.formats
                          )}
                          data-auditorium-screen-shape={
                            screenShape?.filterLabel
                          }
                        >
                          <svg
                            class="aspect-ratio-diagram w-full text-neutral-500"
                            viewBox="0 0 92 62"
                            role="img"
                            aria-label={`${auditorium.screen.ratio} screen proportions`}
                          >
                            <line
                              x1={diagram.x}
                              y1={bottom}
                              x2={right}
                              y2={diagram.y}
                              class="aspect-ratio-diagonal"
                            />
                            <path
                              d={`M ${diagram.x} ${diagram.y + corner} V ${diagram.y} H ${diagram.x + corner} M ${right - corner} ${diagram.y} H ${right} V ${diagram.y + corner} M ${right} ${bottom - corner} V ${bottom} H ${right - corner} M ${diagram.x + corner} ${bottom} H ${diagram.x} V ${bottom - corner}`}
                              class="aspect-ratio-corners"
                            />
                          </svg>
                          <div class="min-w-0">
                            <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
                              {auditorium.formats.map((format) => (
                                <span class="inline-flex min-h-8 items-center rounded-md border border-white/10 bg-white/4 px-2.5 py-1">
                                  <ExperienceBadge format={format} />
                                </span>
                              ))}
                              <p class="text-sm text-neutral-500">
                                {auditorium.screen.ratio}
                                {screenShape?.listingLabel && (
                                  <span class="ml-1">
                                    ({screenShape.listingLabel})
                                  </span>
                                )}
                              </p>
                            </div>
                            <p class="mt-2 text-sm text-neutral-400">
                              <span class="text-neutral-600">
                                {getAuditoriumHeading(auditorium.auditoriums)}
                              </span>{' '}
                              {auditorium.auditoriums}
                            </p>
                            {auditorium.details && (
                              <p class="mt-1 text-sm leading-snug text-neutral-500">
                                {auditorium.details}
                              </p>
                            )}
                            {auditorium.features.length > 0 && (
                              <div class="mt-2 flex flex-wrap gap-1.5">
                                {auditorium.features.map((feature) => (
                                  <span class="inline-flex min-h-6 items-center rounded-md border border-cyan-300/15 bg-cyan-300/5 px-2 py-0.5">
                                    <ExperienceBadge format={feature} />
                                  </span>
                                ))}
                              </div>
                            )}
                          </div>
                        </div>
                      )
                    })}
                  </div>

                  {theatre.data.notes.length > 0 && (
                    <div class="border-t border-amber-300/10 bg-amber-300/4 px-5 py-4 sm:px-6">
                      <p class="mb-2 text-xs font-semibold tracking-wider text-amber-200/70 uppercase">
                        Good to know
                      </p>
                      <ul class="space-y-1.5 text-sm leading-relaxed text-neutral-400">
                        {theatre.data.notes.map((note) => (
                          <li class="pl-3 before:mr-2 before:-ml-3 before:text-amber-300/60 before:content-['•']">
                            {note}
                          </li>
                        ))}
                      </ul>
                    </div>
                  )}
                </article>
              )
            })
          }
        </div>

        <div
          id="no-results"
          class="mt-4 hidden rounded-2xl border border-dashed border-white/15 px-6 py-14 text-center"
        >
          <p class="font-medium text-neutral-300">
            No matching theatres found.
          </p>
          <p class="mt-1 text-sm text-neutral-500">
            Try another search or screen format.
          </p>
        </div>
      </div>
    </section>

    <!-- <aside
      class="mt-8 rounded-2xl border border-white/8 bg-white/3 p-5 text-sm leading-relaxed text-neutral-500 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0 sm:p-6"
    >
      <p>
        <strong class="font-semibold text-neutral-300">About this guide.</strong
        > This is a community-compiled, work-in-progress reference—not official Cineplex
        information. Auditorium configurations can change, so confirm with the theatre
        when a specific presentation matters.
      </p>
      <p class="mt-2">
        “Viewing format” is the clearest umbrella here: Regular, UltraAVX, IMAX,
        SCREENX, and 4DX. SCREENX is a 270-degree image experience; 4DX is
        separate, adding motion seats and environmental effects. 2D/3D is
        deliberately left out unless it changes a listed auditorium detail.
      </p>
      <p class="mt-2">
        Screen labels are derived from aspect ratio: Flat is 1.85:1, Scope is
        2.39:1, Digital is 1.90:1, and IMAX 1.43 is 1.43:1. A screen’s physical
        ratio does not guarantee that every film fills it. Dolby Atmos, D-BOX,
        and laser projection are listed against the specific auditorium where
        community evidence identifies them.
      </p>
    </aside> -->
  </PageContainer>

  <script>
    import Fuse from 'fuse.js'

    document.addEventListener('astro:page-load', () => {
      if (window.location.pathname !== '/cineplex-toronto') {
        return
      }

      const searchInput =
        document.querySelector<HTMLInputElement>('#theatre-search')
      const filterButtons = Array.from(
        document.querySelectorAll<HTMLButtonElement>('.filter-button')
      )
      const cards = Array.from(
        document.querySelectorAll<HTMLElement>('.theatre-card')
      )
      const resultCount = document.querySelector<HTMLElement>('#result-count')
      const noResults = document.querySelector<HTMLElement>('#no-results')
      const directory = document.querySelector<HTMLElement>('#directory')
      const locations = cards.map((card) => ({
        card,
        name: card.dataset.name ?? '',
        formats: JSON.parse(card.dataset.formats ?? '[]') as string[],
        screenShapes: JSON.parse(card.dataset.screenShapes ?? '[]') as string[],
        auditoriumRows: Array.from(
          card.querySelectorAll<HTMLElement>('[data-auditorium-formats]')
        ).map((row) => ({
          row,
          formats: JSON.parse(
            row.dataset.auditoriumFormats ?? '[]'
          ) as string[],
          screenShapes: row.dataset.auditoriumScreenShape
            ? [row.dataset.auditoriumScreenShape]
            : []
        }))
      }))
      const fuse = new Fuse(locations, {
        keys: [{ name: 'name', weight: 1 }],
        ignoreLocation: true,
        threshold: 0.3
      })
      let activeFilter:
        { type: 'format' | 'screen-shape'; value: string } | undefined
      let animationFrame: number | undefined
      let hasAutoScrolledToDirectory = false

      function matchesActiveFilter({
        formats,
        screenShapes
      }: {
        formats: string[]
        screenShapes: string[]
      }) {
        if (!activeFilter) return true

        return activeFilter.type === 'format'
          ? formats.includes(activeFilter.value) ||
              (activeFilter.value === 'IMAX' && formats.includes('IMAX 70mm'))
          : screenShapes.includes(activeFilter.value)
      }

      function updateFilterButtons() {
        filterButtons.forEach((button) => {
          const filterType = button.dataset.filterType
          const filterValue = button.dataset.filterValue
          button.setAttribute(
            'aria-pressed',
            String(
              !filterType
                ? !activeFilter
                : activeFilter?.type === filterType &&
                    activeFilter.value === filterValue
            )
          )
        })
      }

      function updateResults({ scrollToDirectory = false } = {}) {
        const query = searchInput?.value.trim() ?? ''
        const searchResults = query
          ? fuse.search(query).map(({ item }) => item)
          : locations
        const searchMatches = new Set(searchResults.map(({ card }) => card))
        let visibleCount = 0

        locations.forEach(({ card, formats, screenShapes, auditoriumRows }) => {
          const matchesSearch = searchMatches.has(card)
          const matchesFilter = matchesActiveFilter({ formats, screenShapes })
          const visible = matchesSearch && matchesFilter
          if (card.hidden === visible) card.hidden = !visible

          auditoriumRows.forEach(({ row, formats, screenShapes }) => {
            row.hidden = !matchesActiveFilter({ formats, screenShapes })
          })

          if (visible) {
            visibleCount += 1
          }
        })

        if (resultCount) {
          resultCount.textContent =
            visibleCount === cards.length
              ? `Showing all ${cards.length} locations`
              : `Showing ${visibleCount} of ${cards.length} locations`
        }
        noResults?.classList.toggle('hidden', visibleCount !== 0)

        if (
          scrollToDirectory &&
          visibleCount > 0 &&
          directory &&
          !hasAutoScrolledToDirectory
        ) {
          hasAutoScrolledToDirectory = true
          directory.scrollIntoView({
            behavior: 'smooth',
            block: 'start',
            inline: 'start'
          })
        }
      }

      function scheduleResultsUpdate() {
        if (animationFrame) cancelAnimationFrame(animationFrame)
        animationFrame = requestAnimationFrame(() => {
          animationFrame = undefined
          updateResults({ scrollToDirectory: true })
        })
      }

      searchInput?.addEventListener('input', scheduleResultsUpdate)
      filterButtons.forEach((button) => {
        button.addEventListener('click', () => {
          const filterType = button.dataset.filterType
          const filterValue = button.dataset.filterValue

          if (!filterType || !filterValue) {
            activeFilter = undefined
          } else if (
            activeFilter?.type === filterType &&
            activeFilter.value === filterValue
          ) {
            activeFilter = undefined
          } else {
            activeFilter = {
              type: filterType as 'format' | 'screen-shape',
              value: filterValue
            }
          }

          updateFilterButtons()
          updateResults()
        })
      })
    })
  </script>
</Layout>

<style>
  :global(.cinema-guide) {
    background:
      radial-gradient(
        circle at 50% -12rem,
        rgb(120 53 15 / 0.2),
        transparent 35rem
      ),
      #171717;
  }

  :global(.cinema-guide > footer) {
    border-top: 1px solid rgb(255 255 255 / 0.06);
    padding-top: 1.5rem;
  }

  .screen-glow {
    position: absolute;
    top: -10rem;
    right: -8rem;
    width: 34rem;
    height: 34rem;
    border-radius: 9999px;
    background: radial-gradient(
      circle,
      rgb(245 158 11 / 0.16),
      rgb(245 158 11 / 0.04) 42%,
      transparent 68%
    );
    filter: blur(4px);
  }

  .cinema-hero::after {
    position: absolute;
    inset: 0;
    pointer-events: none;
    background-image: linear-gradient(
      rgb(255 255 255 / 0.022) 1px,
      transparent 1px
    );
    background-size: 100% 4rem;
    mask-image: linear-gradient(to right, transparent 35%, black);
    content: '';
  }

  .screen-match {
    position: relative;
    z-index: 1;
    border: 1px solid rgb(255 255 255 / 0.11);
    border-radius: 1.25rem;
    background: rgb(10 10 10 / 0.8);
    box-shadow:
      0 1.5rem 4rem rgb(0 0 0 / 0.35),
      inset 0 1px rgb(255 255 255 / 0.04);
    padding: 1rem;
    backdrop-filter: blur(12px);
  }

  .screen-match__topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: rgb(212 212 212);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .screen-match__status {
    border: 1px solid rgb(252 211 77 / 0.2);
    border-radius: 9999px;
    background: rgb(252 211 77 / 0.08);
