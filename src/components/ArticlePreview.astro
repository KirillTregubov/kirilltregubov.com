---
import type { CollectionEntry } from 'astro:content'
import { ArrowRightIcon } from 'lucide-react'

interface Props {
  article: CollectionEntry<'blog'>
}

const { article } = Astro.props
const href = `/blog/${article.id}`

const displayDate = article.data.updatedDate ?? article.data.pubDate
const formattedDate = displayDate.toLocaleDateString('en-CA', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
})
---

<div class="group rounded-xl">
  <a
    href={href}
    class="grid min-h-32 grid-cols-[minmax(0,1fr)_auto] rounded-xl"
  >
    <div class="flex min-w-0 flex-col justify-center px-4 py-6 lg:px-6">
      <div class="flex flex-wrap items-center gap-2 text-sm text-neutral-500">
        <time datetime={displayDate.toISOString()}>
          {article.data.updatedDate ? 'Updated ' : ''}
          {formattedDate}
        </time>
        {import.meta.env.DEV && article.data.hidden && (
          <span class="rounded-sm bg-violet-950 px-1.5 py-0.5 text-violet-300">
            Development only
          </span>
        )}
        {import.meta.env.DEV && article.data.draft && (
          <span class="rounded-sm bg-amber-950 px-1.5 py-0.5 text-amber-300">
            Draft
          </span>
        )}
      </div>
      <h2 class="mt-1 text-lg font-semibold text-neutral-200 sm:text-xl">
        {article.data.title}
      </h2>
      <p class="mt-1.5 line-clamp-2 text-sm leading-relaxed text-neutral-400 sm:text-base">
        {article.data.description}
      </p>
    </div>
    <div class="flex items-center pr-3 pl-3 sm:pr-6 sm:pl-5">
      <span class="inline-flex items-center gap-1.5 whitespace-nowrap rounded-lg px-2 py-2 text-sm font-medium text-neutral-400 transition group-has-focus-visible:text-white group-hover:text-white sm:px-3">
        <span class="sr-only sm:not-sr-only">Read article</span>
        <ArrowRightIcon
          className="size-4 transition-transform group-has-focus-visible:translate-x-0.5 group-hover:translate-x-0.5 will-change-transform"
          aria-hidden="true"
        />
      </span>
    </div>
  </a>
</div>
