---
import CopyButton from '@components/markdown/CopyButton.astro'
import { codeToHtml } from 'shiki'

export type PackageManager = 'npm' | 'pnpm' | 'nub' | 'bun' | 'deno' | 'vite+'
export interface InstallTab {
  label: string
  command: string
}

interface Props {
  /** The package specifier, for example `@astrojs/mdx` or `my-package@latest`. */
  package: string
  /** Install as a development dependency. */
  devDependency?: boolean
  /** Tabs to display. All commonly used package managers are shown by default. */
  managers?: PackageManager[]
  /** The initially selected tab. */
  defaultManager?: PackageManager
  /** Replace a generated command for one or more tabs. Useful for project scaffolding commands. */
  commands?: Partial<Record<PackageManager, string>>
  /** Fully custom tabs, such as `npx` or Vite project-generator commands. */
  tabs?: InstallTab[]
}

const {
  package: packageName,
  devDependency = false,
  managers = ['npm', 'pnpm', 'nub', 'bun', 'deno', 'vite+'],
  defaultManager = managers[0] ?? 'npm',
  commands = {},
  tabs,
} = Astro.props

const generatedCommands: Record<PackageManager, string> = {
  npm: `npm install${devDependency ? ' --save-dev' : ''} ${packageName}`,
  pnpm: `pnpm add${devDependency ? ' --save-dev' : ''} ${packageName}`,
  nub: `nub add${devDependency ? ' --save-dev' : ''} ${packageName}`,
  bun: `bun add${devDependency ? ' --dev' : ''} ${packageName}`,
  deno: `deno add${devDependency ? ' --dev' : ''} ${packageName}`,
  'vite+': `vp add${devDependency ? ' -D' : ''} ${packageName}`,
}

const installTabs =
  tabs ??
  managers.map((manager) => ({
    label: manager,
    command: commands[manager] ?? generatedCommands[manager],
  }))
const selectedManager = installTabs.some((tab) => tab.label === defaultManager)
  ? defaultManager
  : (installTabs[0]?.label ?? 'npm')
const tabId = `install-${crypto.randomUUID()}`
const highlightedCommands = Object.fromEntries(
  await Promise.all(
    installTabs.map(async (tab) => {
      const html = await codeToHtml(tab.command, {
        lang: 'shellscript',
        theme: 'github-dark',
      })

      return [tab.label, html.match(/<code>([\s\S]*)<\/code>/)?.[1]] as const
    }),
  ),
)
---

<div
  class="not-prose my-6 overflow-hidden rounded-xl border border-neutral-700 bg-neutral-900"
  data-install-tabs
>
  <div
    class="relative flex overflow-x-auto border-b border-neutral-700 px-1 py-1 after:absolute after:bottom-0 after:left-(--indicator-left,0px) after:h-0.5 after:w-(--indicator-width,0px) after:rounded-full after:bg-orange-400 after:transition-all after:duration-200 after:content-[''] motion-reduce:after:transition-none"
    role="tablist"
    aria-label="Package manager"
  >
    {installTabs.map((tab) => (
      <button
        id={`${tabId}-tab-${tab.label}`}
        class:list={[
          'relative shrink-0 cursor-pointer rounded-md px-3 py-1.5 text-sm font-medium transition-colors hover:bg-neutral-800 hover:text-neutral-100 focus-visible:z-10 focus-visible:ring-inset',
          tab.label === selectedManager
            ? 'text-neutral-100'
            : 'text-neutral-400',
        ]}
        type="button"
        role="tab"
        aria-selected={tab.label === selectedManager ? 'true' : 'false'}
        aria-controls={`${tabId}-panel-${tab.label}`}
        data-install-tab={tab.label}
      >
        {tab.label}
      </button>
    ))}
  </div>
  <div
    class="relative"
    role="tabpanel"
    id={`${tabId}-panel-${selectedManager}`}
    aria-labelledby={`${tabId}-tab-${selectedManager}`}
    data-install-panel
  >
    {installTabs.map((tab) => (
      <code
        class:list={[
          'block overflow-x-auto px-4 py-4 font-mono text-sm leading-6 text-neutral-100',
          tab.label !== selectedManager && 'hidden',
        ]}
        data-install-command={tab.label}
        set:html={highlightedCommands[tab.label]}
      />
    ))}
    <CopyButton
      variant="button"
      from="[data-install-command]:not(.hidden)"
      label="Copy install command"
      copiedLabel="Install command copied"
    />
  </div>
</div>

<script>
  const setupInstallTabs = (container: HTMLElement) => {
    if (container.dataset.installInit !== undefined) return
    container.dataset.installInit = ''

    const tabs = Array.from(
      container.querySelectorAll<HTMLButtonElement>('[data-install-tab]'),
    )
    const commands = Array.from(
      container.querySelectorAll<HTMLElement>('[data-install-command]'),
    )
    const panel = container.querySelector<HTMLElement>('[data-install-panel]')
    const tablist = container.querySelector<HTMLElement>('[role="tablist"]')

    const moveIndicator = (active: HTMLButtonElement | undefined) => {
      if (!tablist || !active) return
      tablist.style.setProperty('--indicator-left', `${active.offsetLeft}px`)
      tablist.style.setProperty('--indicator-width', `${active.offsetWidth}px`)
    }

    const select = (manager: string) => {
      tabs.forEach((tab) => {
        const selected = tab.dataset.installTab === manager
        tab.setAttribute('aria-selected', String(selected))
        tab.classList.toggle('text-neutral-100', selected)
        tab.classList.toggle('text-neutral-400', !selected)
      })
      commands.forEach((command) =>
        command.classList.toggle(
          'hidden',
          command.dataset.installCommand !== manager,
        ),
      )
      const tab = tabs.find((item) => item.dataset.installTab === manager)
      if (panel && tab) {
        panel.id = tab.getAttribute('aria-controls') ?? panel.id
        panel.setAttribute('aria-labelledby', tab.id)
      }
      moveIndicator(tab)
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => select(tab.dataset.installTab ?? ''))
      tab.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key))
          return
        event.preventDefault()
        const nextIndex =
          event.key === 'Home'
            ? 0
            : event.key === 'End'
              ? tabs.length - 1
              : (index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) %
                tabs.length
        tabs[nextIndex]?.focus()
        select(tabs[nextIndex]?.dataset.installTab ?? '')
      })
    })

    const placeIndicator = () =>
      moveIndicator(
        tabs.find((tab) => tab.getAttribute('aria-selected') === 'true'),
      )
    requestAnimationFrame(placeIndicator)
    document.fonts?.ready.then(placeIndicator).catch(() => {})
  }

  const repositionIndicators = () => {
    document
      .querySelectorAll<HTMLElement>('[data-install-tabs]')
      .forEach((container) => {
        const tablist = container.querySelector<HTMLElement>('[role="tablist"]')
        const active = container.querySelector<HTMLButtonElement>(
          '[data-install-tab][aria-selected="true"]',
        )
        if (!tablist || !active) return
        tablist.style.setProperty('--indicator-left', `${active.offsetLeft}px`)
        tablist.style.setProperty(
          '--indicator-width',
          `${active.offsetWidth}px`,
        )
      })
  }

  const initInstallTabs = () => {
    document
      .querySelectorAll<HTMLElement>('[data-install-tabs]')
      .forEach(setupInstallTabs)
  }

  document.addEventListener('astro:page-load', () => {
    initInstallTabs()

    if (!document.documentElement.hasAttribute('data-install-resize')) {
      document.documentElement.setAttribute('data-install-resize', '')
      window.addEventListener('resize', repositionIndicators)
    }
  })
</script>
