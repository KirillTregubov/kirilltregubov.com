---
export type PackageManager = 'npm' | 'pnpm' | 'nub' | 'bun' | 'deno' | 'vite+'
export interface InstallTab {
  label: string
  command: string
}

interface Props {
  /** The package specifier, for example `@astrojs/mdx` or `my-package@latest`. */
  package: string
  /** Install as a development dependency. */
  devDependency?: boolean
  /** Tabs to display. All commonly used package managers are shown by default. */
  managers?: PackageManager[]
  /** The initially selected tab. */
  defaultManager?: PackageManager
  /** Replace a generated command for one or more tabs. Useful for project scaffolding commands. */
  commands?: Partial<Record<PackageManager, string>>
  /** Fully custom tabs, such as `npx` or Vite project-generator commands. */
  tabs?: InstallTab[]
}

const {
  package: packageName,
  devDependency: dev = false,
  managers = ['npm', 'pnpm', 'nub', 'bun', 'deno', 'vite+'],
  defaultManager = managers[0] ?? 'npm',
  commands = {},
  tabs,
} = Astro.props

const generatedCommands: Record<PackageManager, string> = {
  npm: `npm install${dev ? ' --save-dev' : ''} ${packageName}`,
  pnpm: `pnpm add${dev ? ' --save-dev' : ''} ${packageName}`,
  nub: `nub add${dev ? ' --save-dev' : ''} ${packageName}`,
  bun: `bun add${dev ? ' --dev' : ''} ${packageName}`,
  deno: `deno add${dev ? ' --dev' : ''} ${packageName}`,
  'vite+': `vp add${dev ? ' -D' : ''} ${packageName}`,
}

const installTabs =
  tabs ??
  managers.map((manager) => ({
    label: manager,
    command: commands[manager] ?? generatedCommands[manager],
  }))
const selectedManager = installTabs.some((tab) => tab.label === defaultManager)
  ? defaultManager
  : (installTabs[0]?.label ?? 'npm')
const tabId = `install-${crypto.randomUUID()}`
---

<div
  class="not-prose my-6 overflow-hidden rounded-xl border border-neutral-700 bg-neutral-900"
  data-install-tabs
>
  <div
    class="flex overflow-x-auto border-b border-neutral-700 px-2"
    role="tablist"
    aria-label="Package manager"
  >
    {
      installTabs.map((tab) => (
        <button
          id={`${tabId}-tab-${tab.label}`}
          class:list={[
            'shrink-0 border-b-2 px-3 py-2.5 text-sm font-medium transition-colors focus-visible:z-10',
            tab.label === selectedManager
              ? 'border-orange-400 text-neutral-100'
              : 'border-transparent text-neutral-400 hover:text-neutral-200',
          ]}
          type="button"
          role="tab"
          aria-selected={tab.label === selectedManager ? 'true' : 'false'}
          aria-controls={`${tabId}-panel-${tab.label}`}
          data-install-tab={tab.label}
        >
          {tab.label}
        </button>
      ))
    }
  </div>
  <div
    class="relative"
    role="tabpanel"
    id={`${tabId}-panel-${selectedManager}`}
    aria-labelledby={`${tabId}-tab-${selectedManager}`}
    data-install-panel
  >
    {
      installTabs.map((tab) => (
        <code
          class:list={[
            'block overflow-x-auto px-4 py-4 font-mono text-sm leading-6 text-neutral-100',
            tab.label !== selectedManager && 'hidden',
          ]}
          data-install-command={tab.label}
        >
          {tab.command}
        </code>
      ))
    }
    <button
      class="absolute top-1/2 right-3 -translate-y-1/2 rounded-md p-2 text-neutral-400 transition hover:bg-neutral-800 hover:text-neutral-100 focus-visible:text-neutral-100"
      type="button"
      aria-label="Copy install command"
      data-copy-command
    >
      <svg
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="size-4 fill-none stroke-current stroke-2"
        ><rect x="9" y="9" width="11" height="11" rx="2"></rect><path
          d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"
        ></path></svg
      >
    </button>
  </div>
</div>

<script>
  document
    .querySelectorAll<HTMLElement>('[data-install-tabs]')
    .forEach((container) => {
      const tabs = Array.from(
        container.querySelectorAll<HTMLButtonElement>('[data-install-tab]'),
      )
      const commands = Array.from(
        container.querySelectorAll<HTMLElement>('[data-install-command]'),
      )
      const panel = container.querySelector<HTMLElement>('[data-install-panel]')
      const copyButton = container.querySelector<HTMLButtonElement>(
        '[data-copy-command]',
      )

      const select = (manager: string) => {
        tabs.forEach((tab) => {
          const selected = tab.dataset.installTab === manager
          tab.setAttribute('aria-selected', String(selected))
          tab.classList.toggle('border-orange-400', selected)
          tab.classList.toggle('text-neutral-100', selected)
          tab.classList.toggle('border-transparent', !selected)
          tab.classList.toggle('text-neutral-400', !selected)
        })
        commands.forEach((command) =>
          command.classList.toggle(
            'hidden',
            command.dataset.installCommand !== manager,
          ),
        )
        const tab = tabs.find((item) => item.dataset.installTab === manager)
        if (panel && tab) {
          panel.id = tab.getAttribute('aria-controls') ?? panel.id
          panel.setAttribute('aria-labelledby', tab.id)
        }
      }

      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () =>
          select(tab.dataset.installTab ?? ''),
        )
        tab.addEventListener('keydown', (event) => {
          if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key))
            return
          event.preventDefault()
          const nextIndex =
            event.key === 'Home'
              ? 0
              : event.key === 'End'
                ? tabs.length - 1
                : (index +
                    (event.key === 'ArrowRight' ? 1 : -1) +
                    tabs.length) %
                  tabs.length
          tabs[nextIndex]?.focus()
          select(tabs[nextIndex]?.dataset.installTab ?? '')
        })
      })

      copyButton?.addEventListener('click', async () => {
        const activeCommand = commands
          .find((command) => !command.classList.contains('hidden'))
          ?.textContent?.trim()
        if (!activeCommand || !navigator.clipboard) return
        await navigator.clipboard.writeText(activeCommand)
        copyButton.setAttribute('aria-label', 'Install command copied')
        window.setTimeout(
          () => copyButton.setAttribute('aria-label', 'Copy install command'),
          1500,
        )
      })
    })
</script>
