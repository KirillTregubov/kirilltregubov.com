---
interface Props {
  href: string
  target?: string
  className?: string
}

let { target, className, ...props } = Astro.props
if (!target) {
  target = '_blank'
}
---

<a
  class:list={[
    '-m-0.5 inline-block will-change-transform active:scale-[0.99] rounded-sm p-0.5 text-nowrap text-white underline transition duration-150 hover:text-neutral-300 focus-visible:text-neutral-300 active:text-neutral-300',
    className,
  ]}
  {...props}
  {target}
  rel="noopener"
>
  <slot />
</a>
