---
import EditorFileIcon from './icons/EditorFileIcon.astro'
import AnimatedLink from './AnimatedLink.astro'
import SocialButtons from './SocialButtons.astro'
import { getCollection } from 'astro:content'
import filesIcon from '../assets/vscode-icons/files.svg?raw'
import searchIcon from '../assets/vscode-icons/search.svg?raw'
import sourceControlIcon from '../assets/vscode-icons/source-control.svg?raw'
import debugIcon from '../assets/vscode-icons/debug-alt.svg?raw'
import extensionsIcon from '../assets/vscode-icons/extensions.svg?raw'
import gitBranchIcon from '../assets/vscode-icons/git-branch.svg?raw'
import {
  ArrowLeftIcon,
  ArrowRightIcon,
  ChevronRightIcon,
  RotateCwIcon,
  XIcon,
} from 'lucide-react'

interface Props {
  app: 'terminal' | 'browser' | 'editor'
}

const { app } = Astro.props
const vscodeLogo =
  app === 'editor'
    ? (await getCollection('technologies')).find((item) => item.id === 'vscode')
        ?.body
    : undefined
const activityIcons = [
  filesIcon,
  searchIcon,
  sourceControlIcon,
  debugIcon,
  extensionsIcon,
]
const windowNavigationClass =
  'flex gap-[0.16rem] text-[#737aa2] [&>span]:grid [&>span]:size-4 [&>span]:place-items-center [&_svg]:size-[0.62rem] [&_svg]:stroke-2'
---

{app === 'terminal' && (
  <div
    class="dummy-app leading-4 dummy-terminal absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[rgb(22_22_30/0.98)] font-mono [--window-font-body:10px]!"
    aria-hidden="true"
  >
    <div class="terminal-titlebar grid h-7 shrink-0 grid-cols-[auto_1fr_auto] items-center gap-[0.45rem] py-0 pl-2 pr-1 border-b border-[#292b3a] bg-[#1a1b26] text-[#737aa2] text-[calc(var(--window-font-address)-1px)] leading-none">
      <span class="terminal-mark relative top-px text-[#ff9e64]">›_</span>
      <span class="relative top-px">kirill@omarchy:~</span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close terminal window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="terminal-body flex min-h-0 flex-1 flex-col gap-[0.45rem] p-[0.65rem_0.75rem] overflow-hidden text-[#a9b1d6] text-(length:--window-font-body) leading-(--window-leading-terminal)">
      <div class="terminal-commandline flex items-baseline gap-[0.35rem] whitespace-nowrap">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span class="command text-[#c0caf5]">fastfetch</span>
      </div>
      <div class="fastfetch flex min-w-0 items-center gap-[0.8rem] @max-[28rem]:flex-col @max-[28rem]:items-start">
        <pre class="fastfetch-logo flex-[0_0_auto] m-0 text-[#ff9e64] font-bold text-(length:--window-font-logo) leading-none font-[ui-monospace,SFMono-Regular,Menlo,monospace] tracking-[-0.04em]">██████████████████████████████████████████████████████
██████████████████████████████████████████████████████
████                     ████                     ████
████                     ████                     ████
████    █████████████████████         ████████    ████
████    █████████████████████         ████████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████████████                              ████    ████
████████████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ██████████████████████████████████████    ████
████    ██████████████████████████████████████    ████
████                     ████                     ████
████                     ████                     ████
█████████████████████████████     ████████████████████
█████████████████████████████     ████████████████████</pre>
        <div class="fetch-details grid min-w-0 gap-[0.38rem] text-[#9aa5ce] text-(length:--window-font-body) whitespace-nowrap">
          <span>
            <b>Hardware</b> Ryzen 5 5600X · RTX 4070
          </span>
          <span>
            <b>Software</b> Arch Linux · Omarchy · Hyprland
          </span>
          <span>
            <b>Theme</b> Tokyo Night
          </span>
        </div>
      </div>
      <div class="terminal-commandline terminal-input flex items-baseline gap-[0.35rem] whitespace-nowrap mt-0">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span
          class="cursor relative top-px inline-block h-[1em] w-[0.5ch] shrink-0 bg-[#c0caf5] opacity-0 animate-[terminal-blink_1.1s_steps(1)_infinite_both] motion-reduce:opacity-100"
          aria-hidden="true"
        ></span>
      </div>
    </div>
  </div>
)}

{app === 'browser' && (
  <div
    class="dummy-app leading-4 dummy-browser absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden select-none flex-col bg-[#171717] text-[#d4d4d8] font-sans pointer-events-auto [--window-font-body:10px]!"
    aria-hidden="true"
  >
    <div class="browser-toolbar grid h-7 shrink-0 grid-cols-[auto_minmax(0,1fr)] items-center gap-2 pr-7 pl-2 border-b border-[#292b3a] bg-[#1a1b26] text-[#737aa2] text-(length:--window-font-chrome) leading-none">
      <div class:list={['browser-nav', windowNavigationClass]}>
        <span>
          <ArrowLeftIcon aria-hidden="true" />
        </span>
        <span>
          <ArrowRightIcon aria-hidden="true" />
        </span>
        <span>
          <RotateCwIcon aria-hidden="true" />
        </span>
      </div>
      <div class="address-bar flex h-4.5 w-full max-w-80 min-w-0 items-center justify-self-center gap-1.5 overflow-hidden rounded-sm border border-[#34374a] bg-[#202230] px-2 text-[#9aa5ce] text-[calc(var(--window-font-address)-1px)] whitespace-nowrap">
        <span class="site-lock text-[#9ece6a] text-(length:--window-font-chrome)">
          ●
        </span>
        <span class="truncate">kirilltregubov.com</span>
      </div>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close browser window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="browser-page min-h-0 flex-1 overflow-x-hidden overflow-y-auto bg-[#171717]">
      <div class="browser-preview mx-auto max-w-2xl">
        <div class="browser-preview-copy text-(length:--window-font-body) leading-(--window-leading-body)">
          <p>
            Hey! I'm <span class="text-accent-400">Kirill Tregubov</span>, a{' '}
            <span class="text-accent-400">software developer</span> in Canada. I
            build tools and apps with TypeScript and React. I studied{' '}
            <span class="text-accent-400">Computer Science</span> at the
            University of Toronto. I like open source, design, science fiction,
            and astronomy.
          </p>
          <p>
            If you want to get in touch, you can email me at{' '}
            <span class="whitespace-nowrap">
              <AnimatedLink
                thinUnderline
                href="mailto:contact@kirilltregubov.com"
                draggable="false"
              >
                contact@kirilltregubov.com
              </AnimatedLink>
              .
            </span>
          </p>
          <SocialButtons />
        </div>
        <figure
          class="browser-preview-saturn"
          title="My favourite planet, Saturn."
        >
          <img
            src="/assets/SaturnPlaceholder.jpg"
            alt="Saturn"
            class="w-full max-w-52 object-contain"
            loading="lazy"
            draggable="false"
          />
          <figcaption class="w-full text-center text-(length:--window-font-meta) leading-(--window-leading-body) font-medium text-neutral-400/80">
            My favourite planet, Saturn.{' '}
            <a
              class="-m-0.5 rounded-sm p-0.5 underline transition select-none hover:text-neutral-200 focus-visible:text-neutral-200 active:text-neutral-200"
              href="https://science.nasa.gov/resource/saturn-3d-model/"
              target="_blank"
              rel="noopener"
            >
              Source
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
)}

{app === 'editor' && (
  <div
    class="dummy-app leading-4 dummy-editor absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[#16161e] font-sans [--window-font-chrome:10px]! [--window-font-meta:10px]! [--window-font-address:11px]! [--window-font-body:10px]! [--window-leading-code:14px]! [--window-leading-tree:14px]!"
    aria-hidden="true"
  >
    <div class="editor-menubar grid h-7 shrink-0 grid-cols-[minmax(3.75rem,1fr)_minmax(0,16rem)_minmax(3.75rem,1fr)] items-center gap-2 px-2 border-b border-[#292b3a]/50 bg-[#16161e] text-[#9aa5ce] text-(length:--window-font-chrome) leading-none @max-[36rem]:grid-cols-[minmax(3.75rem,1fr)_minmax(0,12rem)_minmax(3.75rem,1fr)]">
      <div class="flex min-w-0 items-center gap-2">
        <span
          class="editor-appmark grid size-3 place-items-center text-[#7aa2f7] [&_svg]:size-2.5"
          set:html={vscodeLogo}
        />
        <div class="editor-menu flex gap-2 @max-[36rem]:hidden">
          <span>File</span>
          <span>Edit</span>
          <span>Selection</span>
          <span>…</span>
        </div>
        <div
          class:list={[
            'editor-history ml-auto shrink-0',
            windowNavigationClass,
          ]}
        >
          <span>
            <ArrowLeftIcon aria-hidden="true" />
          </span>
          <span>
            <ArrowRightIcon aria-hidden="true" />
          </span>
        </div>
      </div>
      <span class="command-center flex h-4.5 w-full max-w-64 min-w-0 items-center justify-center justify-self-center overflow-hidden rounded-sm border border-[#2f3346] bg-[#1f2130] px-2 py-0 font-sans text-[#9aa5ce] text-[calc(var(--window-font-address)-1px)] leading-none whitespace-nowrap @max-[36rem]:max-w-48">
        <span class="truncate">kirilltregubov.com</span>
      </span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close editor window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="editor-workbench flex min-h-0 flex-1 gap-0.5 p-0.5 px-0.75 pb-0">
      <div class="activity-rail flex w-8 shrink-0 flex-col items-center gap-2 overflow-hidden rounded-md border border-[#292b3a]/50 bg-[#181922] py-1 text-[#737aa2]">
        {activityIcons.map((icon) => (
          <span
            class="grid size-6 shrink-0 place-items-center rounded-sm first:bg-[#292b3a] first:text-[#c0caf5] [&_svg]:size-4 [@container_(max-width:28rem)_and_(max-height:13rem)]:last:hidden"
            set:html={icon}
          />
        ))}
      </div>
      <aside class="editor-sidebar flex w-30 shrink-0 overflow-hidden rounded-md border border-[#292b3a]/50 bg-[#181922]">
        <div class="file-tree flex min-w-0 flex-1 flex-col overflow-hidden pb-2 text-[#9aa5ce] text-(length:--window-font-chrome) leading-(--window-leading-tree) [&>span]:min-h-(--window-leading-tree) [&>span]:shrink-0 [&>span]:overflow-hidden [&>span]:text-ellipsis [&>span]:whitespace-nowrap [&_svg]:size-2.5! [&_svg]:basis-2.5!">
          <div class="explorer-heading flex h-7 shrink-0 items-center justify-between px-2 text-(length:--window-font-chrome) font-semibold text-[#a9b1d6]">
            <span>Explorer</span>
            <span>•••</span>
          </div>
          <strong class="mb-1 flex shrink-0 items-center gap-1 overflow-hidden px-2 text-(length:--window-font-chrome) font-semibold text-[#c0caf5]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0 rotate-90"
            />
            <span class="truncate">kirilltregubov.com</span>
          </strong>
          <span class="tree-folder flex items-center gap-1 pl-2 text-[#9aa5ce]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0 rotate-90"
            />{' '}
            src
          </span>
          <span class="tree-folder nested flex items-center gap-1 pl-3 text-[#9aa5ce]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0 rotate-90"
            />{' '}
            components
          </span>
          <span class="tree-file flex items-center gap-1 pl-4">
            <EditorFileIcon type="astro" /> AboutMe.astro
          </span>
          <span class="tree-file flex items-center gap-1 pl-4">
            <EditorFileIcon type="react" /> Age.tsx
          </span>
          <span class="tree-file active mx-1 flex items-center gap-1 rounded-sm bg-[#292e42] pl-3 text-[#c0caf5]">
            <EditorFileIcon type="astro" /> HomeHero.astro
          </span>
          <span class="tree-file flex items-center gap-1 pl-4">
            <EditorFileIcon type="react" /> Saturn.tsx
          </span>
          <span class="tree-folder flex items-center gap-1 pl-2 text-[#9aa5ce]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0"
            />{' '}
            content
          </span>
          <span class="tree-folder flex items-center gap-1 pl-2 text-[#9aa5ce]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0"
            />{' '}
            layouts
          </span>
          <span class="tree-folder flex items-center gap-1 pl-2 text-[#9aa5ce]">
            <ChevronRightIcon
              aria-hidden="true"
              className="tree-chevron shrink-0"
            />{' '}
            pages
          </span>
        </div>
      </aside>
      <div class="editor-main flex min-w-0 min-h-0 flex-1 flex-col overflow-hidden rounded-md border border-[#292b3a]/50 bg-[#1a1b26]">
        <div class="editor-tabs flex h-6 shrink-0 border-b border-[#292b3a]/50 bg-[#181922] text-[#a9b1d6] text-(length:--window-font-chrome) leading-none [@container_(max-height:13rem)]:h-5">
          <span class="flex min-w-0 items-center gap-1 rounded-t-sm bg-[#222436] px-1.5 text-[#c0caf5] [&_svg]:size-2.5! [&_svg]:basis-2.5! [&_svg]:shrink-0">
            <EditorFileIcon type="astro" />{' '}
            <span class="truncate">HomeHero.astro</span>{' '}
            <XIcon aria-hidden="true" className="ml-0.5 size-2!" />
          </span>
        </div>
        <div class="breadcrumbs flex h-5 shrink-0 items-center gap-1 overflow-hidden border-b border-[#292b3a]/30 px-2.5 text-[#737aa2] text-(length:--window-font-meta) leading-none whitespace-nowrap [&_svg]:size-2.5! [&_svg]:basis-2.5! [&_svg]:shrink-0">
          src › components › <EditorFileIcon type="astro" /> HomeHero.astro
        </div>
        <!-- Tiny tiles show the end of the file, including the active cursor line. -->
        <div class="code-pane flex min-h-0 flex-1 flex-col overflow-hidden py-1.5 font-mono text-[#a9b1d6] text-(length:--window-font-body) leading-(--window-leading-code) [@container_(max-width:28rem)_and_(max-height:13rem)]:justify-end [&_.line]:shrink-0 [&_.line]:grid-cols-[3em_minmax(0,1fr)] [&_.line]:pr-2 [&_i]:text-[#565f89]">
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">1</i>
            <code class="text-(length:--window-font-body)">
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">2</i>
            <code class="text-(length:--window-font-body)">
              <b>import</b> <span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              <b>from</b> <q>./AboutMe</q>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">3</i>
            <code class="text-(length:--window-font-body)">
              <b>import</b> <span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <b>from</b> <q>./Saturn</q>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">4</i>
            <code class="text-(length:--window-font-body)"></code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">5</i>
            <code class="text-(length:--window-font-body)">
              <b>interface</b> <span class="type text-[#7aa2f7]">Props</span>{' '}
              &#123;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">6</i>
            <code class="text-(length:--window-font-body)">
              &nbsp;&nbsp;<span class="variable text-[#e0af68]">preview</span>?:{' '}
              <span class="type text-[#7aa2f7]">boolean</span>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">7</i>
            <code class="text-(length:--window-font-body)">&#125;</code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">8</i>
            <code class="text-(length:--window-font-body)"></code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">9</i>
            <code class="text-(length:--window-font-body)">
              <b>const</b> &#123;{' '}
              <span class="variable text-[#e0af68]">preview</span> &#125; ={' '}
              <span class="type text-[#7aa2f7]">Astro</span>.
              <span class="variable text-[#e0af68]">props</span>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">10</i>
            <code class="text-(length:--window-font-body)">
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">11</i>
            <code class="text-(length:--window-font-body)"></code>
          </div>
          <div class="line active-line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)] bg-[#1f2335]">
            <i class="text-(length:--window-font-meta)">12</i>
            <code class="text-(length:--window-font-body)">
              &lt;<span class="tag text-[#f7768e]">section</span>{' '}
              <span class="attr text-[#7aa2f7]">class</span>=
              <q>
                home-hero
                <span
                  class="cursor editor-cursor relative inline-block h-[1em] w-0 align-[-0.15em] before:absolute before:inset-y-0 before:left-0 before:w-0.5 before:bg-[#c0caf5] animate-[editor-blink_1s_steps(1)_infinite] motion-reduce:animate-none"
                  aria-hidden="true"
                ></span>
              </q>
              &gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">13</i>
            <code class="text-(length:--window-font-body)">
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">14</i>
            <code class="text-(length:--window-font-body)">
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <span class="attr text-[#7aa2f7]">client:visible</span> /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-meta)">15</i>
            <code class="text-(length:--window-font-body)">
              &lt;/<span class="tag text-[#f7768e]">section</span>&gt;
            </code>
          </div>
        </div>
      </div>
    </div>
    <div class="editor-status flex h-5 shrink-0 items-center justify-between gap-2 overflow-hidden bg-[#16161e] px-2 text-[#858ba3] text-[0.5625rem] leading-none whitespace-nowrap [@container_(max-height:13rem)]:h-4">
      <span class="flex items-center gap-[0.18rem]">
        <span
          class="block size-1.5 mb-px [&_svg]:size-full"
          set:html={gitBranchIcon}
        />
        <span>main</span>
      </span>
      <span class="truncate">
        Astro&nbsp;&nbsp;UTF-8&nbsp;&nbsp;Ln 12, Col 26
      </span>
    </div>
  </div>
)}

<style>
  :global(.window[data-app='terminal']) .dummy-terminal,
  :global(.window[data-app='browser']) .dummy-browser,
  :global(.window[data-app='editor']) .dummy-editor {
    display: flex;
  }
  .window-close:hover {
    background: #4b5068;
    color: #c0caf5;
  }
  .window-close svg {
    width: 0.7rem;
    height: 0.7rem;
    stroke-width: 2;
  }
  .fetch-details b {
    display: block;
    margin-bottom: 0.04rem;
    color: #bb9af7;
    font-weight: 650;
  }
  .browser-preview {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
