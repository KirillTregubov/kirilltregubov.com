---
import HomeHero from './HomeHero.astro'
import EditorFileIcon from './icons/EditorFileIcon.astro'
import { getCollection } from 'astro:content'
import filesIcon from '../assets/vscode-icons/files.svg?raw'
import searchIcon from '../assets/vscode-icons/search.svg?raw'
import sourceControlIcon from '../assets/vscode-icons/source-control.svg?raw'
import debugIcon from '../assets/vscode-icons/debug-alt.svg?raw'
import extensionsIcon from '../assets/vscode-icons/extensions.svg?raw'
import gitBranchIcon from '../assets/vscode-icons/git-branch.svg?raw'
import {
  ArrowLeftIcon,
  ArrowRightIcon,
  RotateCwIcon,
  XIcon,
} from 'lucide-react'

interface Props {
  app: 'terminal' | 'browser' | 'editor'
}

const { app } = Astro.props
const vscodeLogo =
  app === 'editor'
    ? (await getCollection('technologies')).find((item) => item.id === 'vscode')
        ?.body
    : undefined
const activityIcons = [
  filesIcon,
  searchIcon,
  sourceControlIcon,
  debugIcon,
  extensionsIcon,
]
---

{app === 'terminal' && (
  <div
    class="dummy-app dummy-terminal absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[rgb(22_22_30/0.98)] font-mono"
    aria-hidden="true"
  >
    <div class="terminal-titlebar grid min-h-6 grid-cols-[auto_1fr_auto] items-center gap-[0.45rem] p-[0_0.55rem] [border-bottom:1px_solid_#292b3a] bg-[#1a1b26] text-[#737aa2] text-[0.48rem]">
      <span class="terminal-mark text-[#ff9e64]">›_</span>
      <span>kirill@omarchy:~</span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close terminal window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="terminal-body flex min-h-0 flex-1 flex-col gap-[0.45rem] p-[0.65rem_0.75rem] overflow-hidden text-[#a9b1d6] text-[0.5rem] leading-[1.35]">
      <div class="terminal-commandline flex items-center gap-[0.35rem] whitespace-nowrap">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span class="command text-[#c0caf5]">fastfetch</span>
      </div>
      <div class="fastfetch flex min-w-0 items-center gap-[0.8rem]">
        <pre class="fastfetch-logo flex-[0_0_auto] m-0 text-[#ff9e64] [font:700_0.22rem/1_ui-monospace,SFMono-Regular,Menlo,monospace] tracking-[-0.04em]">██████████████████████████████████████████████████████
██████████████████████████████████████████████████████
████                     ████                     ████
████                     ████                     ████
████    █████████████████████         ████████    ████
████    █████████████████████         ████████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████████████                              ████    ████
████████████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ██████████████████████████████████████    ████
████    ██████████████████████████████████████    ████
████                     ████                     ████
████                     ████                     ████
█████████████████████████████     ████████████████████
█████████████████████████████     ████████████████████</pre>
        <div class="fetch-details grid min-w-0 gap-[0.38rem] text-[#9aa5ce] text-[0.5rem] whitespace-nowrap">
          <span>
            <b>Hardware</b> Ryzen 5 5600X · RTX 4070
          </span>
          <span>
            <b>Software</b> Arch Linux · Omarchy · Hyprland
          </span>
          <span>
            <b>Theme</b> Tokyo Night
          </span>
        </div>
      </div>
      <div class="terminal-commandline terminal-input flex items-center gap-[0.35rem] whitespace-nowrap mt-0">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span class="cursor text-[#c0caf5] animate-[terminal-blink_1.1s_steps(1)_infinite]">
          {'▌'}
        </span>
      </div>
    </div>
  </div>
)}

{app === 'browser' && (
  <div
    class="dummy-app dummy-browser absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden select-none flex-col bg-[#171717] text-[#d4d4d8] font-[Inter,ui-sans-serif,system-ui,sans-serif] pointer-events-auto"
    aria-hidden="true"
  >
    <div class="browser-toolbar grid min-h-[1.45rem] grid-cols-[auto_minmax(2rem,1fr)_auto] items-center gap-[0.4rem] p-[0_0.25rem] [border-bottom:1px_solid_#292b3a] bg-[#1a1b26] text-[#737aa2] text-[0.48rem]">
      <div class="browser-nav flex gap-[0.16rem]">
        <span>
          <ArrowLeftIcon aria-hidden="true" />
        </span>
        <span>
          <ArrowRightIcon aria-hidden="true" />
        </span>
        <span>
          <RotateCwIcon aria-hidden="true" />
        </span>
      </div>
      <div class="address-bar flex min-w-0 items-center gap-[0.35rem] p-[0.14rem_0.45rem] overflow-hidden [border:1px_solid_#34374a] rounded-[0.32rem] bg-[#202230] text-[#9aa5ce] whitespace-nowrap">
        <span class="site-lock text-[#9ece6a] text-[0.4rem]">●</span>
        <span>kirilltregubov.com</span>
      </div>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close browser window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="browser-page min-h-0 flex-1 overflow-hidden bg-[#171717]">
      <HomeHero preview />
    </div>
  </div>
)}

{app === 'editor' && (
  <div
    class="dummy-app dummy-editor absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[#1a1b26] font-mono"
    aria-hidden="true"
  >
    <div class="editor-menubar grid min-h-[1.4rem] grid-cols-[auto_auto_auto_minmax(3rem,1fr)_auto] items-center gap-[0.55rem] p-[0_0.25rem] [border-bottom:1px_solid_#292b3a] bg-[#16161e] text-[#737aa2] text-[0.4375rem]">
      <span
        class="editor-appmark grid size-4 place-items-center text-[#7aa2f7] [&_svg]:size-[0.55rem]"
        set:html={vscodeLogo}
      />
      <div class="editor-menu flex gap-[0.48rem]">
        <span>File</span>
        <span>Edit</span>
        <span>Selection</span>
        <span>…</span>
      </div>
      <span class="editor-history flex items-center gap-[0.12rem] whitespace-nowrap">
        <ArrowLeftIcon aria-hidden="true" className="size-2 stroke-2" />
        <ArrowRightIcon aria-hidden="true" className="size-2 stroke-2" />
      </span>
      <span class="command-center justify-self-stretch p-[0.1rem_0.4rem] overflow-hidden [border:1px_solid_#2f3346] rounded-sm bg-[#1f2130] text-[#565f89] text-left text-ellipsis whitespace-nowrap">
        kirilltregubov.com
      </span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close editor window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="editor-workbench flex min-h-0 flex-1">
      <aside class="editor-sidebar flex w-[37%] min-w-20 [border-right:1px_solid_#292b3a] bg-[#16161e]">
        <div class="activity-rail flex w-[1.55rem] flex-[0_0_1.55rem] flex-col items-center gap-[0.68rem] pt-2 [border-right:1px_solid_#252735] text-[#565f89]">
          {activityIcons.map((icon) => (
            <span
              class="block size-[0.85rem] [&_svg]:size-full"
              set:html={icon}
            />
          ))}
        </div>
        <div class="file-tree flex min-w-0 flex-1 flex-col overflow-hidden text-[#9aa5ce] text-[0.38rem] leading-[1.65]">
          <div class="explorer-heading flex justify-between p-[0.38rem_0.42rem_0.3rem] text-[#737aa2]">
            <span>EXPLORER</span>
            <span>•••</span>
          </div>
          <strong>⌄ KIRILLTREGUBOV.COM</strong>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">⌄ src</span>
          <span class="tree-folder nested pl-[0.55rem] text-[#7dcfff]">
            ⌄ components
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="astro" /> AboutMe.astro
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="react" /> Age.tsx
          </span>
          <span class="tree-file active flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="astro" /> HomeHero.astro
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="react" /> Saturn.tsx
          </span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› content</span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› layouts</span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› pages</span>
        </div>
      </aside>
      <div class="editor-main flex min-w-0 min-h-0 flex-1 flex-col">
        <div class="editor-tabs flex min-h-[1.35rem] [border-bottom:1px_solid_#292b3a] bg-[#16161e] text-[#a9b1d6] text-[0.4rem]">
          <span>
            <EditorFileIcon type="astro" /> HomeHero.astro&nbsp; ×
          </span>
        </div>
        <div class="breadcrumbs flex items-center gap-[0.2rem] p-[0.25rem_0.55rem] text-[#565f89] text-[0.34rem]">
          src › components › <EditorFileIcon type="astro" /> HomeHero.astro
        </div>
        <div class="code-pane min-h-0 flex-1 overflow-hidden pt-[0.15rem] text-[#a9b1d6] text-[0.42rem] leading-normal">
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>1</i>
            <code>
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>2</i>
            <code>
              <b>import</b> <span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              <b>from</b> <q>./AboutMe.astro</q>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>3</i>
            <code>
              <b>import</b> <span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <b>from</b> <q>./Saturn</q>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>4</i>
            <code></code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>5</i>
            <code>
              <b>interface</b> <span class="type text-[#7aa2f7]">Props</span>{' '}
              &#123;
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>6</i>
            <code>
              &nbsp;&nbsp;<span class="variable text-[#e0af68]">preview</span>?:{' '}
              <span class="type text-[#7aa2f7]">boolean</span>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>7</i>
            <code>&#125;</code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>8</i>
            <code></code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>9</i>
            <code>
              <b>const</b> &#123;{' '}
              <span class="variable text-[#e0af68]">preview</span> ={' '}
              <span class="constant text-[#ff9e64]">false</span> &#125; ={' '}
              <span class="type text-[#7aa2f7]">Astro</span>.
              <span class="variable text-[#e0af68]">props</span>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>10</i>
            <code>
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>11</i>
            <code></code>
          </div>
          <div class="line active-line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)] bg-[#1f2335]">
            <i>12</i>
            <code>
              &lt;<span class="tag text-[#f7768e]">section</span>{' '}
              <span class="attr text-[#7aa2f7]">class:list</span>
              =&#123;[...]&#125;&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>13</i>
            <code>
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>14</i>
            <code>
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <span class="attr text-[#7aa2f7]">client:visible</span> /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.5em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i>15</i>
            <code>
              &lt;/<span class="tag text-[#f7768e]">section</span>&gt;
            </code>
          </div>
        </div>
        <div class="editor-status flex min-h-4 items-center justify-between p-[0_0.4rem] bg-[#16161e] text-[#858ba3] text-[0.3125rem]">
          <span class="flex items-center gap-[0.18rem]">
            <span
              class="block size-1.5 mb-px [&_svg]:size-full"
              set:html={gitBranchIcon}
            />
            <span>main</span>
          </span>
          <span>Astro&nbsp;&nbsp;UTF-8&nbsp;&nbsp;Ln 12, Col 26</span>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  :global(.window[data-app='terminal']) .dummy-terminal,
  :global(.window[data-app='browser']) .dummy-browser,
  :global(.window[data-app='editor']) .dummy-editor {
    display: flex;
  }
  .window-close:hover {
    background: #4b5068;
    color: #c0caf5;
  }
  .window-close svg {
    width: 0.7rem;
    height: 0.7rem;
    stroke-width: 2;
  }
  .fetch-details b {
    display: block;
    margin-bottom: 0.04rem;
    color: #bb9af7;
    font-weight: 650;
  }
  .browser-nav span {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
  }
  .browser-nav svg {
    width: 0.62rem;
    height: 0.62rem;
    stroke-width: 2;
  }
  .activity-rail span:first-child {
    color: #c0caf5;
  }
  .file-tree strong {
    padding: 0 0.35rem;
    color: #c0caf5;
    font-weight: 600;
  }
  .file-tree > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tree-folder.nested {
    padding-left: 0.85rem;
  }
  .tree-file.active {
    background: #292e42;
    color: #c0caf5;
  }
  .editor-tabs span {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0 0.55rem;
    border-top: 1px solid #bb9af7;
    background: #1a1b26;
  }
  .line i {
    padding-right: 0.7em;
    color: #3b4261;
    font-style: normal;
    text-align: right;
  }
  .line code {
    overflow: hidden;
    white-space: nowrap;
  }
  .code-pane b,
  .code-pane em {
    color: #bb9af7;
    font-style: normal;
    font-weight: 500;
  }
  .code-pane q {
    color: #9ece6a;
  }
  .code-pane q::before,
  .code-pane q::after {
    content: "'";
  }

  @container (max-height: 13rem) {
    .terminal-body {
      gap: 0.25rem;
      padding-block: 0.4rem;
    }
    .fetch-details {
      gap: 0.22rem;
    }
    .breadcrumbs,
    .file-tree > span:nth-of-type(n + 7) {
      display: none;
    }
    .code-pane {
      padding-top: 0.08rem;
      font-size: 0.34rem;
      line-height: 1.3;
    }
    .line {
      min-height: 1.3em;
    }
  }

  @container (max-width: 18rem) {
    .browser-nav span:nth-child(2),
    .editor-menu,
    .editor-history,
    .editor-sidebar {
      display: none;
    }
    .editor-menubar {
      grid-template-columns: auto minmax(3rem, 1fr) auto;
    }
    .fastfetch {
      gap: 0.45rem;
    }
  }

  @keyframes terminal-blink {
    50% {
      opacity: 0;
    }
  }

  :global(.window:not([data-focused])) .cursor {
    animation: none;
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor {
      animation: none;
    }
  }
</style>
