---
import EditorFileIcon from './icons/EditorFileIcon.astro'
import SocialButtons from './SocialButtons.astro'
import { getCollection } from 'astro:content'
import filesIcon from '../assets/vscode-icons/files.svg?raw'
import searchIcon from '../assets/vscode-icons/search.svg?raw'
import sourceControlIcon from '../assets/vscode-icons/source-control.svg?raw'
import debugIcon from '../assets/vscode-icons/debug-alt.svg?raw'
import extensionsIcon from '../assets/vscode-icons/extensions.svg?raw'
import gitBranchIcon from '../assets/vscode-icons/git-branch.svg?raw'
import {
  ArrowLeftIcon,
  ArrowRightIcon,
  RotateCwIcon,
  XIcon,
} from 'lucide-react'

interface Props {
  app: 'terminal' | 'browser' | 'editor'
}

const { app } = Astro.props
const vscodeLogo =
  app === 'editor'
    ? (await getCollection('technologies')).find((item) => item.id === 'vscode')
        ?.body
    : undefined
const activityIcons = [
  filesIcon,
  searchIcon,
  sourceControlIcon,
  debugIcon,
  extensionsIcon,
]
---

{app === 'terminal' && (
  <div
    class="dummy-app leading-4 dummy-terminal absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[rgb(22_22_30/0.98)] font-mono"
    aria-hidden="true"
  >
    <div class="terminal-titlebar grid min-h-6 grid-cols-[auto_1fr_auto] items-center gap-[0.45rem] py-0 pl-[0.55rem] pr-1 [border-bottom:1px_solid_#292b3a] bg-[#1a1b26] text-[#737aa2] text-(length:--window-font-8)">
      <span class="terminal-mark text-[#ff9e64]">›_</span>
      <span>kirill@omarchy:~</span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close terminal window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="terminal-body flex min-h-0 flex-1 flex-col gap-[0.45rem] p-[0.65rem_0.75rem] overflow-hidden text-[#a9b1d6] text-(length:--window-font-8) leading-(--window-leading-11)">
      <div class="terminal-commandline flex items-center gap-[0.35rem] whitespace-nowrap">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span class="command text-[#c0caf5]">fastfetch</span>
      </div>
      <div class="fastfetch flex min-w-0 items-center gap-[0.8rem]">
        <pre class="fastfetch-logo flex-[0_0_auto] m-0 text-[#ff9e64] font-bold text-(length:--window-font-4) leading-none [font-family:ui-monospace,SFMono-Regular,Menlo,monospace] tracking-[-0.04em]">██████████████████████████████████████████████████████
██████████████████████████████████████████████████████
████                     ████                     ████
████                     ████                     ████
████    █████████████████████         ████████    ████
████    █████████████████████         ████████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████████████                              ████    ████
████████████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ████                              ████    ████
████    ██████████████████████████████████████    ████
████    ██████████████████████████████████████    ████
████                     ████                     ████
████                     ████                     ████
█████████████████████████████     ████████████████████
█████████████████████████████     ████████████████████</pre>
        <div class="fetch-details grid min-w-0 gap-[0.38rem] text-[#9aa5ce] text-(length:--window-font-8) whitespace-nowrap">
          <span>
            <b>Hardware</b> Ryzen 5 5600X · RTX 4070
          </span>
          <span>
            <b>Software</b> Arch Linux · Omarchy · Hyprland
          </span>
          <span>
            <b>Theme</b> Tokyo Night
          </span>
        </div>
      </div>
      <div class="terminal-commandline terminal-input flex items-center gap-[0.35rem] whitespace-nowrap mt-0">
        <span class="path text-[#7dcfff]">~</span>
        <span class="prompt text-[#ff9e64]">❯</span>
        <span class="cursor text-[#c0caf5] animate-[terminal-blink_1.1s_steps(1)_infinite]">
          {'▌'}
        </span>
      </div>
    </div>
  </div>
)}

{app === 'browser' && (
  <div
    class="dummy-app leading-4 dummy-browser absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden select-none flex-col bg-[#171717] text-[#d4d4d8] font-[Inter,ui-sans-serif,system-ui,sans-serif] pointer-events-auto"
    aria-hidden="true"
  >
    <div class="browser-toolbar grid min-h-6 grid-cols-[auto_minmax(2rem,1fr)_auto] items-center gap-[0.4rem] p-[0_0.25rem] [border-bottom:1px_solid_#292b3a] bg-[#1a1b26] text-[#737aa2] text-(length:--window-font-9)">
      <div class="browser-nav flex gap-[0.16rem]">
        <span>
          <ArrowLeftIcon aria-hidden="true" />
        </span>
        <span>
          <ArrowRightIcon aria-hidden="true" />
        </span>
        <span>
          <RotateCwIcon aria-hidden="true" />
        </span>
      </div>
      <div class="address-bar flex min-w-0 items-center gap-[0.35rem] p-[0.14rem_0.45rem] overflow-hidden [border:1px_solid_#34374a] rounded-[0.32rem] bg-[#202230] text-[#9aa5ce] whitespace-nowrap">
        <span class="site-lock text-[#9ece6a] text-(length:--window-font-6)">
          ●
        </span>
        <span>kirilltregubov.com</span>
      </div>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close browser window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="browser-page min-h-0 flex-1 overflow-hidden bg-[#171717]">
      <div class="browser-preview mx-auto max-w-[42rem]">
        <div class="browser-preview-copy text-(length:--window-font-8) leading-(--window-leading-12)">
          <p>
            Hey! I'm <span class="text-accent-400">Kirill Tregubov</span>, a{' '}
            <span class="text-accent-400">software developer</span> in Canada. I
            build tools and apps with TypeScript and React. I studied{' '}
            <span class="text-accent-400">Computer Science</span> at the
            University of Toronto. I like open source, design, science fiction,
            and astronomy.
          </p>
          <p>
            If you want to get in touch, you can email me at{' '}
            <a
              class="font-medium text-neutral-200 underline decoration-accent-700 underline-offset-2"
              href="mailto:contact@kirilltregubov.com"
            >
              contact@kirilltregubov.com
            </a>
            .
          </p>
          <SocialButtons />
        </div>
        <figure
          class="browser-preview-saturn"
          title="My favourite planet, Saturn."
        >
          <img
            src="/assets/SaturnPlaceholder.jpg"
            alt="Saturn"
            class="w-full max-w-52 object-contain"
            loading="lazy"
            draggable="false"
          />
          <figcaption class="text-(length:--window-font-7) leading-(--window-leading-12)">
            My favourite planet, Saturn.{' '}
            <a
              href="https://science.nasa.gov/resource/saturn-3d-model/"
              target="_blank"
              rel="noopener"
            >
              Source
            </a>
          </figcaption>
        </figure>
      </div>
    </div>
  </div>
)}

{app === 'editor' && (
  <div
    class="dummy-app leading-4 dummy-editor absolute inset-0 hidden min-w-0 min-h-0 overflow-hidden text-[#a9b1d6] pointer-events-none select-none flex-col bg-[#1a1b26] font-mono"
    aria-hidden="true"
  >
    <div class="editor-menubar grid min-h-6 grid-cols-[auto_auto_auto_minmax(3rem,1fr)_auto] items-center gap-[0.55rem] p-[0_0.25rem] [border-bottom:1px_solid_#292b3a] bg-[#16161e] text-[#737aa2] text-(length:--window-font-6)">
      <span
        class="editor-appmark grid size-4 place-items-center text-[#7aa2f7] [&_svg]:size-[0.55rem]"
        set:html={vscodeLogo}
      />
      <div class="editor-menu flex gap-[0.48rem]">
        <span>File</span>
        <span>Edit</span>
        <span>Selection</span>
        <span>…</span>
      </div>
      <span class="editor-history flex items-center gap-[0.12rem] whitespace-nowrap">
        <ArrowLeftIcon aria-hidden="true" className="size-2 stroke-2" />
        <ArrowRightIcon aria-hidden="true" className="size-2 stroke-2" />
      </span>
      <span class="command-center justify-self-stretch p-[0.1rem_0.4rem] overflow-hidden [border:1px_solid_#2f3346] rounded-sm bg-[#1f2130] text-[#565f89] text-left text-ellipsis whitespace-nowrap">
        kirilltregubov.com
      </span>
      <button
        class="window-close grid w-[1.15rem] h-[1.15rem] flex-[0_0_1.15rem] place-items-center p-0 border-0 rounded-full bg-transparent text-[#a9b1d6] cursor-pointer pointer-events-auto"
        type="button"
        data-window-close
        tabindex="-1"
        aria-label="Close editor window"
      >
        <XIcon aria-hidden="true" />
      </button>
    </div>
    <div class="editor-workbench flex min-h-0 flex-1">
      <aside class="editor-sidebar flex w-[round(nearest,32%,1px)] max-w-48 min-w-[9rem] [border-right:1px_solid_#292b3a] bg-[#16161e]">
        <div class="activity-rail flex w-[25px] flex-[0_0_25px] flex-col items-center gap-[0.68rem] pt-2 [border-right:1px_solid_#252735] text-[#565f89]">
          {activityIcons.map((icon) => (
            <span
              class="block size-[0.85rem] [&_svg]:size-full"
              set:html={icon}
            />
          ))}
        </div>
        <div class="file-tree flex min-w-0 flex-1 flex-col overflow-hidden text-[#9aa5ce] text-(length:--window-font-6) leading-(--window-leading-9)">
          <div class="explorer-heading flex justify-between p-[6px_7px_5px] text-[#737aa2]">
            <span>EXPLORER</span>
            <span>•••</span>
          </div>
          <strong class="max-w-48 truncate text-(length:--window-font-6)">
            ⌄ KIRILLTREGUBOV.COM
          </strong>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">⌄ src</span>
          <span class="tree-folder nested pl-[0.55rem] text-[#7dcfff]">
            ⌄ components
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="astro" /> AboutMe.astro
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="react" /> Age.tsx
          </span>
          <span class="tree-file active flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="astro" /> HomeHero.astro
          </span>
          <span class="tree-file flex items-center gap-[0.24rem] pl-[1.15rem]">
            <EditorFileIcon type="react" /> Saturn.tsx
          </span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› content</span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› layouts</span>
          <span class="tree-folder pl-[0.55rem] text-[#7dcfff]">› pages</span>
        </div>
      </aside>
      <div class="editor-main flex min-w-0 min-h-0 flex-1 flex-col">
        <div class="editor-tabs flex min-h-4.5 [border-bottom:1px_solid_#292b3a] bg-[#16161e] text-[#a9b1d6] text-(length:--window-font-6)">
          <span class="flex items-center gap-[0.12rem] p-[0_0.25rem] [border-top:1px_solid_#bb9af7] bg-[#1a1b26] [&_svg]:size-[0.3rem] [&_svg]:basis-[0.3rem]">
            <EditorFileIcon type="astro" /> HomeHero.astro&nbsp; ×
          </span>
        </div>
        <div class="breadcrumbs flex items-center gap-[0.2rem] p-[0.25rem_0.55rem] text-[#565f89] text-(length:--window-font-7)">
          src › components › <EditorFileIcon type="astro" /> HomeHero.astro
        </div>
        <div class="code-pane min-h-0 flex-1 overflow-hidden pt-0.5 text-[#a9b1d6] text-(length:--window-font-8) leading-(--window-leading-8)">
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">1</i>
            <code class="text-(length:--window-font-6)">
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">2</i>
            <code class="text-(length:--window-font-6)">
              <b>import</b> <span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              <b>from</b> <q>./AboutMe</q>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">3</i>
            <code class="text-(length:--window-font-6)">
              <b>import</b> <span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <b>from</b> <q>./Saturn</q>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">4</i>
            <code class="text-(length:--window-font-6)"></code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">5</i>
            <code class="text-(length:--window-font-6)">
              <b>interface</b> <span class="type text-[#7aa2f7]">Props</span>{' '}
              &#123;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">6</i>
            <code class="text-(length:--window-font-6)">
              &nbsp;&nbsp;<span class="variable text-[#e0af68]">preview</span>?:{' '}
              <span class="type text-[#7aa2f7]">boolean</span>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">7</i>
            <code class="text-(length:--window-font-6)">&#125;</code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">8</i>
            <code class="text-(length:--window-font-6)"></code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">9</i>
            <code class="text-(length:--window-font-6)">
              <b>const</b> &#123;{' '}
              <span class="variable text-[#e0af68]">preview</span> &#125; ={' '}
              <span class="type text-[#7aa2f7]">Astro</span>.
              <span class="variable text-[#e0af68]">props</span>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">10</i>
            <code class="text-(length:--window-font-6)">
              <em>---</em>
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">11</i>
            <code class="text-(length:--window-font-6)"></code>
          </div>
          <div class="line active-line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)] bg-[#1f2335]">
            <i class="text-(length:--window-font-7)">12</i>
            <code class="text-(length:--window-font-6)">
              &lt;<span class="tag text-[#f7768e]">section</span>{' '}
              <span class="attr text-[#7aa2f7]">class</span>=<q>home-hero</q>
              &gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">13</i>
            <code class="text-(length:--window-font-6)">
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">AboutMe</span>{' '}
              /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">14</i>
            <code class="text-(length:--window-font-6)">
              &nbsp;&nbsp;&lt;<span class="type text-[#7aa2f7]">Saturn</span>{' '}
              <span class="attr text-[#7aa2f7]">client:visible</span> /&gt;
            </code>
          </div>
          <div class="line grid min-h-[1.25em] grid-cols-[2.4em_minmax(0,1fr)]">
            <i class="text-(length:--window-font-7)">15</i>
            <code class="text-(length:--window-font-6)">
              &lt;/<span class="tag text-[#f7768e]">section</span>&gt;
            </code>
          </div>
        </div>
        <div class="editor-status flex min-h-4 items-center justify-between p-[0_0.4rem] bg-[#16161e] text-[#858ba3] text-(length:--window-font-6)">
          <span class="flex items-center gap-[0.18rem]">
            <span
              class="block size-1.5 mb-px [&_svg]:size-full"
              set:html={gitBranchIcon}
            />
            <span>main</span>
          </span>
          <span>Astro&nbsp;&nbsp;UTF-8&nbsp;&nbsp;Ln 12, Col 26</span>
        </div>
      </div>
    </div>
  </div>
)}

<style>
  :global(.window[data-app='terminal']) .dummy-terminal,
  :global(.window[data-app='browser']) .dummy-browser,
  :global(.window[data-app='editor']) .dummy-editor {
    display: flex;
  }
  .window-close:hover {
    background: #4b5068;
    color: #c0caf5;
  }
  .window-close svg {
    width: 0.7rem;
    height: 0.7rem;
    stroke-width: 2;
  }
  .fetch-details b {
    display: block;
    margin-bottom: 0.04rem;
    color: #bb9af7;
    font-weight: 650;
  }
  .browser-nav span {
    display: grid;
    width: 1rem;
    height: 1rem;
    place-items: center;
  }
  .browser-nav svg {
    width: 0.62rem;
    height: 0.62rem;
    stroke-width: 2;
  }
  .browser-preview {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    overflow: hidden;
    background: #171717;
    color: #e5e5e5;
  }
  .browser-preview-copy {
    min-width: 0;
    padding: 10px 0 10px 1.25rem;
    color: #d4d4d8;
  }
  .browser-preview-copy > p {
    display: block;
    margin: 0;
  }
  .browser-preview-copy > p + p {
    margin-top: 0.34rem;
  }
  .browser-preview :global(.browser-preview-copy > div) {
    gap: 0.28rem;
    margin-top: 0.45rem;
  }
  .browser-preview :global(.browser-preview-copy > div a) {
    padding: 0.22rem;
    border-radius: 0.18rem;
  }
  .browser-preview :global(.browser-preview-copy > div svg) {
    width: 0.72rem;
    height: 0.72rem;
  }
  .browser-preview-saturn {
    display: flex;
    box-sizing: content-box;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.35rem;
    width: 100%;
    height: 100%;
    min-width: 0;
    margin: 0;
  }
  .browser-preview-saturn > img {
    max-height: calc(100% - 1.5rem);
  }
  .browser-preview-saturn figcaption {
    width: 100%;
    color: rgb(163 163 163 / 0.8);
    font-weight: 500;
    text-align: center;
  }
  .browser-preview-saturn figcaption a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .activity-rail span:first-child {
    color: #c0caf5;
  }
  .file-tree strong {
    padding: 0 0.35rem;
    color: #c0caf5;
    font-weight: 600;
  }
  .file-tree > span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .tree-folder.nested {
    padding-left: 0.85rem;
  }
  .tree-file.active {
    background: #292e42;
    color: #c0caf5;
  }
  .line i {
    padding-right: 0.7em;
    color: #3b4261;
    font-style: normal;
    text-align: right;
  }
  .line code {
    overflow: hidden;
    white-space: nowrap;
  }
  .code-pane b,
  .code-pane em {
    color: #bb9af7;
    font-style: normal;
    font-weight: 500;
  }
  .code-pane q {
    color: #9ece6a;
  }
  .code-pane q::before,
  .code-pane q::after {
    content: "'";
  }

  @container (max-height: 13rem) {
    .terminal-body {
      gap: 0.25rem;
      padding-block: 0.4rem;
    }
    .fetch-details {
      gap: 0.22rem;
    }
    .breadcrumbs,
    .file-tree > span:nth-of-type(n + 7) {
      display: none;
    }
    .code-pane {
      padding-top: 1px;
    }
    .line {
      min-height: 8px;
    }
  }

  @container (max-width: 18rem) {
    .browser-nav span:nth-child(2),
    .editor-menu,
    .editor-history,
    .editor-sidebar {
      display: none;
    }
    .editor-menubar {
      grid-template-columns: auto minmax(3rem, 1fr) auto;
    }
    .fastfetch {
      gap: 0.45rem;
    }
    .browser-preview {
      grid-template-columns: 1.2fr 0.8fr;
    }
    .browser-preview-copy {
