---
// Every screen ratio found at Toronto Cineplex theatres, drawn at equal area
// and nested like a projectionist's framing leader. Saved from a hero draft.
import type { HeroStats } from './stats'

interface Props {
  stats: HeroStats
  class?: string
}

const { stats, class: className } = Astro.props

// Every shape drawn at the same screen area, centred, so the eye compares
// shape rather than size. Callouts run from each top-right corner to a
// label column.
const W = 440
const H = 260
const cx = 165
const cy = 140
const scale = 186

const frames = stats.ratios.map((ratio, i) => {
  const [w, h] = ratio.split(':').map(Number)
  const r = w / h
  const width = scale * Math.sqrt(r)
  const height = scale / Math.sqrt(r)
  return {
    ratio,
    x: cx - width / 2,
    y: cy - height / 2,
    width,
    height,
    labelY: 34 + i * 26,
    accent: ratio === '1.43:1',
  }
})
const labelX = 356
---

<figure
  class:list={[
    'rounded-2xl border border-[#2b221b] bg-[#0f0b08] p-4 sm:p-6',
    className,
  ]}
>
  <svg
    viewBox={`0 0 ${W} ${H}`}
    class="block w-full"
    role="img"
    aria-label="Every screen aspect ratio found in Toronto Cineplex auditoriums, overlaid"
  >
    <line
      x1={cx}
      y1="10"
      x2={cx}
      y2={H - 10}
      stroke="#2b221b"
      stroke-dasharray="2 4"
    />
    <line
      x1="10"
      y1={cy}
      x2={labelX - 30}
      y2={cy}
      stroke="#2b221b"
      stroke-dasharray="2 4"
    />
    <circle cx={cx} cy={cy} r="14" fill="none" stroke="#3a2e25" />
    {frames.map((f) => (
      <g>
        <rect
          x={f.x}
          y={f.y}
          width={f.width}
          height={f.height}
          fill="none"
          stroke={f.accent ? '#fcd34d' : '#78716c'}
          stroke-width={f.accent ? 1.75 : 1}
        />
        <polyline
          points={`${f.x + f.width},${f.y} ${labelX - 18},${f.labelY} ${labelX - 6},${f.labelY}`}
          fill="none"
          stroke={f.accent ? '#fcd34d' : '#57534e'}
          stroke-width="0.75"
        />
        <circle
          cx={f.x + f.width}
          cy={f.y}
          r="2"
          fill={f.accent ? '#fcd34d' : '#a8a29e'}
        />
        <text
          x={labelX}
          y={f.labelY + 3.5}
          fill={f.accent ? '#fcd34d' : '#d6d3d1'}
          font-size="11"
          font-family="ui-monospace, monospace"
        >
          {f.ratio}
        </text>
      </g>
    ))}
  </svg>
  <figcaption class="mt-3 flex justify-between font-mono text-[11px] text-stone-500">
    <span>{stats.ratios.length} screen shapes, equal area</span>
    <span>{stats.auditoriumCount} auditoriums</span>
  </figcaption>
</figure>
