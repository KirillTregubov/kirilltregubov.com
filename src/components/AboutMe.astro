---
import Age from './Age'
import AnimatedLink from './AnimatedLink.astro'
import Highlight from './Highlight.astro'
import SocialButtons from './SocialButtons.astro'

interface Props {
  class?: string
}

const { class: className } = Astro.props
---

<div class:list={['text-lg text-pretty', className]}>
  <p>
    Hey! I'm <Highlight>Kirill Tregubov</Highlight>, a <Age client:load />{' '}
    year-old <Highlight>software developer</Highlight> based in{' '}
    <span class="whitespace-nowrap">
      <span class="canadian-flag" aria-hidden>
        🇨🇦
      </span>
      Canada
    </span>
    . I specialize in TypeScript and spend most of my time building CLI tools
    and modern web, mobile and desktop apps using React. My preferred tech stack
    also includes React Native, Tauri (Rust), Vite, TailwindCSS, Node.js and
    PostgreSQL. I graduated from the University of Toronto with an{' '}
    <Highlight>Honours Bachelor of Science in Computer Science</Highlight>. I'm
    passionate about <span class="whitespace-nowrap">open-source</span>{' '}
    software, interface design, science fiction and astronomy. I use arch btw.
  </p>
  <script>
    function isCanadianFlagSupported() {
      const emoji = '🇨🇦'
      const c = document.createElement('canvas')
      const ctx = c.getContext('2d')
      if (!ctx) return false

      c.width = c.height = 20
      ctx.textBaseline = 'top'
      ctx.font = '20px sans-serif'
      ctx.fillText(emoji, 0, 0)

      const data = ctx.getImageData(0, 0, c.width, c.height).data

      let redPixels = 0,
        totalPixels = 0
      for (let i = 0; i < data.length; i += 4) {
        const [r, g, b, a] = data.slice(i, i + 4)
        if (!a) continue
        totalPixels++
        if (r > 150 && r > 1.3 * g && r > 1.3 * b) redPixels++
      }

      // If at least ~5% of pixels are clearly red, assume the flag rendered.
      return redPixels / totalPixels > 0.05
    }

    document.addEventListener('astro:page-load', () => {
      const flags = document.querySelectorAll('.canadian-flag')
      if (flags.length === 0) return

      const showFlag = isCanadianFlagSupported()
      flags.forEach((button) => {
        if (!showFlag) {
          button.textContent = ''
          button.innerHTML =
            '<img src="/assets/canada.svg" alt="Canada" class="inline-block size-[1em] w-auto align-middle mb-0.5 mr-px" />'
        }
      })
    })
  </script>
  <p class="mt-4">
    If you want to get in touch, you can email me at{' '}
    <span class="whitespace-nowrap">
      <AnimatedLink href="mailto:contact@kirilltregubov.com" draggable="false">
        contact@kirilltregubov.com
      </AnimatedLink>
      .
    </span>
  </p>
  <!-- <p class="mt-3">
    I also write about software, design, and the projects I build on my{' '}
    <a
      href="/blog"
      class="-m-0.5 rounded-sm p-0.5 font-medium text-neutral-200 underline decoration-neutral-500 underline-offset-3 transition hover:decoration-neutral-200 focus-visible:decoration-neutral-200"
    >
      blog
    </a>
    .
  </p> -->
  <SocialButtons />
</div>
