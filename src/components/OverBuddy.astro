---
import { Image } from 'astro:assets'
import MDLink from './markdown/MDLink.astro'
import { AlertTriangleIcon } from 'lucide-react'

export interface Props {
  showTitle?: boolean
  repository: string
  download: string
}

const { repository, download, showTitle = false } = Astro.props
---

<aside
  class="col-span-full rounded-md border border-amber-300/30 bg-amber-300/10 p-4 text-amber-100"
>
  <div class="flex items-center gap-2 font-semibold text-amber-200/80">
    <AlertTriangleIcon className="size-5 shrink-0" aria-hidden="true" />
    <span>Warning</span>
  </div>
  <div class="text-sm leading-6 text-amber-50/80">
    <p class="mt-2">
      OverBuddy has been archived and is no longer actively maintained due to
      the removal of menu customization in Season 2: Summit (2026).
    </p>
    <p class="mt-1 text-amber-100/80">
      The project is preserved as a demonstration of the app's past
      functionality, but the app is not expected to keep working with current or
      future Overwatch updates.
    </p>
  </div>
</aside>
<div class="flex flex-col justify-center gap-6">
  {
    showTitle && (
      <div class="flex items-center justify-start gap-3">
        <Image
          class="select-none"
          src={`/assets/projects/overbuddy/icon.png`}
          alt="OverBuddy icon"
          width={48}
          height={48}
          loading="eager"
          draggable="false"
        />
        <h1 class="text-2xl leading-none font-bold text-neutral-200">
          OverBuddy
        </h1>
      </div>
    )
  }
  <ul class="flex flex-col gap-3 text-neutral-400">
    <li>
      <h3 class="-mr-0.5 text-lg font-medium text-neutral-200">
        Personalize your Overwatch™ Experience
      </h3>
      <p class="">
        OverBuddy allowed you to customize your Overwatch in-game main menu
        background. Browse the archived gallery of backgrounds the app
        previously supported.
      </p>
    </li>
    <li>
      <h3 class="text-lg font-medium text-neutral-200">Free and Transparent</h3>
      <p class="">
        OverBuddy is free to use and{' '}
        <MDLink
          href={repository}
          className="text-neutral-300! hover:text-neutral-200! focus-visible:text-neutral-200! active:text-neutral-200!"
          >open source</MDLink
        >. It operated independently and is not affiliated with Blizzard
        Entertainment® or Valve®. You could undo the changes it made at any time
        by reverting to the default background.
      </p>
    </li>
    <li>
      <h3 class="text-lg font-medium text-neutral-200">
        Built with Privacy in Mind
      </h3>
      <p class="">
        To change the menu background, OverBuddy needed to read and write your
        Battle.net® and/or Steam® configuration files. It did
        <span class="font-semibold">NOT</span> modify any game files and did
        <span class="font-semibold">NOT</span> collect your personal data. Your game
        client(s) were automatically restarted to apply the changes.
      </p>
    </li>
    <li>
      <h3 class="text-lg font-medium text-neutral-200">Frequently Updated</h3>
      <p class="">
        Major Overwatch patches changed the availability of backgrounds,
        including adding new backgrounds and removing existing ones. The app is
        no longer updated now that menu customization has been removed.
      </p>
    </li>
  </ul>
  <div class="flex flex-wrap gap-3">
    <a
      class="inline-flex h-14 items-center justify-center rounded-[0.2rem] border-2 border-orange-800/40 bg-orange-500 px-10 text-center text-lg font-semibold tracking-wide text-orange-50 uppercase shadow-md ring-white! transition will-change-transform select-none hover:scale-105 hover:rounded-sm hover:border-orange-50 focus-visible:scale-105 focus-visible:border-white focus-visible:ring-1! focus-visible:outline-hidden active:scale-95 max-[480px]:w-full"
      href={download}
    >
      Get the App
    </a>
    <a
      class="inline-flex h-14 items-center justify-center rounded-[0.2rem] border-2 border-neutral-800/40 bg-neutral-700 px-6 text-center text-lg font-semibold tracking-wide text-neutral-100 uppercase shadow-md ring-white! transition will-change-transform select-none hover:scale-105 hover:rounded-sm hover:border-neutral-50 focus-visible:scale-105 focus-visible:border-white focus-visible:ring-1! focus-visible:outline-hidden active:scale-95 max-[480px]:w-full"
      href={repository}
      target="_blank"
      rel="noopener"
    >
      View on GitHub
    </a>
    <!-- <div class="flex items-center">
        <a
          class:list={[
            'underline-fade-in relative select-none text-center text-lg font-medium uppercase tracking-wide transition will-change-transform after:bg-zinc-300 hover:text-zinc-300 focus-visible:text-zinc-300 focus-visible:outline-hidden active:scale-95 disabled:pointer-events-none'
          ]}
          href={projectInfo.data.download!}
          target="_blank"
          rel="noopener"
        >
          Read the Latest Release
        </a>
      </div> -->
  </div>
</div>
<div class="flex w-full items-center">
  <Image
    class="fade-in rounded-sm select-none"
    src="/assets/projects/overbuddy/screenshot-2.png"
    alt="Screenshot of the OverBuddy app"
    width={684}
    height={533}
    loading="eager"
    draggable="false"
  />
</div>
