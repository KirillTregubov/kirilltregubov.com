---
interface Props {
  type: 'astro' | 'react'
}

const { type } = Astro.props
---

{type === 'astro' ? (
  <svg
    class="editor-file-icon astro-icon"
    viewBox="0 0 256 366"
    fill="currentColor"
    aria-hidden="true"
  >
    <path d="M182.0219 9.1473c2.9817 3.7017 4.5021 8.6967 7.5431 18.6866L256 246.0732c-24.563-12.7423-51.2653-21.9322-79.426-26.8905L133.3181 73.0084c-.7077-2.3918-2.9047-4.0326-5.3988-4.0326-2.5006 0-4.7013 1.6494-5.4037 4.0494L79.7837 219.109C51.4922 224.0448 24.668 233.2516 0 246.04L66.7608 27.7834c3.0504-9.9728 4.5758-14.9592 7.5579-18.654a24.5413 24.5413 0 0 1 9.9459-7.3586C88.6702 0 93.8846 0 104.3136 0h47.6835c10.4426 0 15.6638 0 20.0735 1.7745a24.5453 24.5453 0 0 1 9.9513 7.3728Z" />
    <path
      class="astro-flame"
      d="M189.9716 256.4593c-10.9518 9.3651-32.8117 15.7518-57.9911 15.7518-30.9047 0-56.8073-9.6212-63.6808-22.5606-2.4572 7.4159-3.0082 15.9031-3.0082 21.3248 0 0-1.6191 26.6226 16.8975 45.1396 0-9.615 7.7947-17.4092 17.4093-17.4092 16.4799 0 16.4615 14.3777 16.4463 26.0425-.0004.3493-.0008.6966-.0008 1.041 0 17.705 10.821 32.8825 26.2099 39.2799-2.2985-4.7276-3.588-10.0364-3.588-15.6467 0-16.886 9.9137-23.1734 21.4354-30.4808 9.167-5.814 19.3527-12.2736 26.3722-25.2318 3.6624-6.761 5.742-14.505 5.742-22.7345 0-5.0609-.7862-9.9382-2.2437-14.516Z"
    />
  </svg>
) : (
  <svg
    class="editor-file-icon react-icon"
    viewBox="-11.5 -10.232 23 20.463"
    fill="currentColor"
    stroke="currentColor"
    aria-hidden="true"
  >
    <circle r="2.05" stroke="none" />
    <g fill="none">
      <ellipse rx="11" ry="4.2" />
      <ellipse rx="11" ry="4.2" transform="rotate(60)" />
      <ellipse rx="11" ry="4.2" transform="rotate(120)" />
    </g>
  </svg>
)}

<style>
  .editor-file-icon {
    width: 0.52rem;
    height: 0.52rem;
    flex: 0 0 0.52rem;
  }
  .astro-icon {
    color: #e4e4e7;
  }
  .astro-flame {
    fill: #f472b6;
  }
  .react-icon {
    color: #7dcfff;
    stroke-width: 1;
  }
</style>
