---
import {
  LayoutGridIcon,
  // Maximize2Icon,
  // Minimize2Icon,
  MoveHorizontalIcon,
  RotateCcwIcon,
} from 'lucide-react'
import OmarchyDummyApps from './OmarchyDummyApps.astro'
import Keybind from './markdown/Keybind.astro'
---

<section
  class="omarchy-demo not-prose shadow-lg [--orange:#ff8a3d] [--focus-blue:#8bd5ff] m-[2.5rem_0] overflow-hidden [border:1px_solid_rgb(255_255_255/0.1)] rounded-[1.25rem] bg-[#111116] data-transitioning:relative data-transitioning:z-50"
  aria-labelledby="omarchy-demo-title"
>
  <div class="demo-heading flex items-center justify-between gap-5 p-[18px_20px] [border-bottom:1px_solid_rgb(255_255_255/0.08)]">
    <div>
      <!-- <p class="eyebrow m-[0_0_0.2rem] text-[#fb923c] text-[0.75rem] font-bold tracking-[0.12em] uppercase">
        See it in action
      </p> -->
      <h2
        id="omarchy-demo-title"
        class="m-0 text-[1.0625rem] font-[650] leading-5 tracking-[-0.01em] text-[#f5f5f5]"
      >
        See it in action
      </h2>
      <p class="m-0 pt-1 text-[0.8125rem] leading-5 text-[#a1a1ad]">
        Try the keyboard shortcuts for the full experience.
      </p>
    </div>

    <div class="flex items-center gap-2">
      <div
        class="layout-switcher grid grid-cols-[repeat(2,6rem)] gap-1 p-1 [border:1px_solid_rgb(255_255_255/0.08)] rounded-[0.625rem] bg-[#09090d]"
        role="group"
        aria-label="Window layout"
      >
        <button
          class="select-none"
          type="button"
          data-layout-button="dwindle"
          aria-pressed="true"
        >
          <LayoutGridIcon aria-hidden="true" />
          <span>Dwindle</span>
        </button>
        <button
          class="select-none"
          type="button"
          data-layout-button="scrolling"
          aria-pressed="false"
        >
          <MoveHorizontalIcon aria-hidden="true" />
          <span>Scrolling</span>
        </button>
      </div>
      <!-- Fullscreen feature disabled for now.
      <button
        type="button"
        class="fullscreen-button group grid size-12 shrink-0 place-items-center rounded-[0.625rem] [border:1px_solid_rgb(255_255_255/0.08)] bg-[#09090d] text-[#9999a4] transition-colors hover:text-white focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--focus-blue)"
        data-fullscreen-button
        aria-label="Enter fullscreen"
        aria-pressed="false"
        title="Enter fullscreen"
      >
        <span class="grid place-items-center" aria-hidden="true">
          <Maximize2Icon className="size-4 [grid-area:1/1] scale-100 opacity-100 blur-none transition duration-200 will-change-transform group-aria-pressed:scale-50 group-aria-pressed:opacity-0 group-aria-pressed:blur-[2px] motion-reduce:transition-none" />
          <Minimize2Icon className="size-4 [grid-area:1/1] scale-50 opacity-0 blur-[2px] transition duration-200 group-aria-pressed:scale-100 group-aria-pressed:opacity-100 group-aria-pressed:blur-none motion-reduce:transition-none" />
        </span>
      </button>
      -->
    </div>
  </div>

  <div class="desktop-experience p-[1.5rem_1.25rem_1.25rem] bg-[radial-gradient(ellipse_at_50%_0%,#241b28_0,#15141a_45%,#0c0c10_100%)] select-none">
    <div class="monitor-shell w-full [--bezel-color:#1b1b20] [--hardware-highlight:#24242b]">
      <div class="monitor-frame overflow-hidden rounded-t-xl bg-(--bezel-color) p-2 pb-0">
        <div
          class="screen relative isolate aspect-video overflow-hidden [--window-gap:0.375rem] rounded-t-sm [clip-path:inset(0_round_0.25rem_0.25rem_0_0)] bg-[#14141f]"
          role="group"
          data-layout="dwindle"
          data-window-count="0"
          aria-label="Workspace 1, 0 windows, dwindle layout"
        >
          <div
            class="wallpaper absolute -inset-6 [clip-path:inset(3rem_0_0)] bg-[linear-gradient(rgb(24_8_25/0.08),rgb(13_7_18/0.18)),url('/assets/blog/quattro.jpg')] bg-center bg-cover"
            aria-hidden="true"
          ></div>

          <div class="topbar absolute z-5 inset-[0_0_auto] grid grid-cols-[1fr_auto_1fr] items-center h-6 px-3 py-0 bg-[#14141f] text-[#9999ac] font-mono text-[0.625rem] leading-2.5 shadow-[0_1px_rgb(255_255_255/0.04)]">
            <div class="topbar-left flex items-center gap-1.5">
              <svg
                class="omarchy-logo size-2.5 shrink-0 text-[#dedeea]"
                viewBox="0 0 1200 1200"
                fill="currentColor"
                aria-label="Omarchy"
              >
                <path
                  fill-rule="evenodd"
                  d="M1200 1200H720v-80h400V80H640.004v160h-400v720h720V240h-80v-80H1040v880H640v160H0V0h1200ZM80 1120h480v-80H160l.004-400H80Zm0-560h80.004V160h400V80H80Z"
                  clip-rule="evenodd"
                ></path>
              </svg>
              <div
                class="workspaces flex items-center gap-0"
                role="group"
                aria-label="Workspaces"
              >
                {[1, 2, 3, 4, 5].map((workspace) => (
                  <button
                    type="button"
                    class="workspace-button relative grid size-2.5 flex-[0_0_0.875rem] place-items-center p-0 pt-px border-0 rounded-[0.1875rem] bg-transparent text-[#777789] font-[inherit] [font-weight:inherit] leading-none cursor-pointer [transition:color_140ms_ease,background-color_140ms_ease]"
                    data-workspace-button={workspace}
                    aria-label={`Switch to workspace ${workspace}`}
                    aria-pressed={workspace === 1 ? 'true' : 'false'}
                  >
                    <span class="workspace-number">{workspace}</span>
                    <span
                      class="workspace-dot absolute top-1/2 left-1/2 hidden size-1.5 -translate-x-1/2 -translate-y-1/2 rounded-xs bg-[#c6b8e9]"
                      aria-hidden="true"
                    ></span>
                  </button>
                ))}
              </div>
            </div>
            <time
              class="clock text-[#bdbdcc] whitespace-nowrap"
              data-system-time
            ></time>
            <div
              class="status-icons flex items-center justify-end gap-2"
              aria-hidden="true"
            >
              <!--
                Paths reproduced from the system's JetBrainsMono Nerd Font:
                Ethernet (f0200), volume-high (f028), and monitor (f0379).
                Keeping the outlines inline makes the demo match Omarchy without
                requiring visitors to have the Nerd Font installed.
              -->
              <svg
                class="status-icon ethernet-icon block size-2.5 shrink-0 fill-current"
                viewBox="0 0 832 792"
                preserveAspectRatio="none"
              >
                <path d="M207 626V500H291V626H375V500H457V626H541V500H625V626H707V250H541V126H291V250H125V626H207ZM98 0H734Q775 0 803.5 30Q832 60 832 100V694Q832 734 803.5 763Q775 792 734 792H98Q57 792 28.5 763Q0 734 0 694V100Q0 60 28.5 30Q57 0 98 0Z"></path>
              </svg>
              <svg
                class="status-icon audio-icon block h-2.5 w-3.5 shrink-0 fill-current"
                viewBox="0 0 1154 828"
                preserveAspectRatio="none"
              >
                <path d="M962 11Q1052 84 1103 189Q1154 294 1154 414Q1154 534 1103 639Q1052 744 962 817Q948 828 930 826Q912 824 901 811Q890 797 892 779Q894 761 907 750Q982 690 1024 602Q1066 514 1067 414Q1066 314 1024 226Q982 138 907 78Q894 67 892 49Q890 31 901 17Q912 4 930 2Q948 0 962 11ZM853 145Q913 194 947 264Q981 334 981 414Q981 494 947 564Q913 634 853 683Q839 694 821 692Q803 690 792 677Q780 663 782 645Q784 627 798 616Q894 538 894 414Q894 291 798 213Q784 202 782 184Q780 166 792 152Q803 138 821 136Q839 134 853 145ZM744 280Q808 333 808 414Q808 496 744 549Q730 560 712 558Q694 556 683 542Q672 528 674 510Q676 492 689 481Q721 454 721 414Q721 374 689 347Q676 336 674 318Q672 300 683 286Q694 272 712 270Q730 268 744 280ZM543 16Q577 31 577 68V760Q577 798 543 813Q508 828 481 804L238 587H115Q68 588 34 554Q0 520 0 472V357Q0 309 34 275Q68 241 115 241H238L481 25Q508 1 543 16Z"></path>
              </svg>
              <svg
                class="status-icon monitor-icon block h-2.5 w-2.75 shrink-0 fill-current"
                viewBox="0 0 918 832"
                preserveAspectRatio="none"
              >
                <path d="M834 82V582H84V82H834ZM834 0H84Q49 0 24.5 24.5Q0 49 0 82V582Q0 617 24.5 641.5Q49 666 84 666H375V750H293V832H625V750H543V666H834Q869 666 893.5 641.5Q918 617 918 582V82Q918 49 893.5 24.5Q869 0 834 0Z"></path>
              </svg>
            </div>
          </div>

          <div
            class="workspace absolute z-2 top-[calc(1.5rem+var(--window-gap))] right-(--window-gap) bottom-(--window-gap) left-(--window-gap) overflow-hidden"
            aria-live="polite"
          ></div>
        </div>
      </div>
      <div
        class="monitor-chin grid h-4 place-items-center rounded-b-xl bg-(--bezel-color) text-[#72727c] text-[0.4375rem] leading-2 font-bold tracking-[0.16em]"
        aria-hidden="true"
      >
        <span class="translate-y-px">OMARCHY</span>
      </div>
      <div
        class="monitor-stand mx-auto h-2 w-[11%] bg-[linear-gradient(180deg,var(--bezel-color),var(--hardware-highlight))] [clip-path:polygon(35%_0,65%_0,100%_100%,0_100%)]"
        aria-hidden="true"
      ></div>
      <div
        class="monitor-base mx-auto h-1 w-[18%] rounded-[50%_50%_0.2rem_0.2rem] bg-[linear-gradient(180deg,var(--hardware-highlight),var(--bezel-color))] shadow-[0_3px_8px_rgb(0_0_0/0.25)]"
        aria-hidden="true"
      ></div>
    </div>

    <div class="demo-controls flex flex-wrap items-center justify-between gap-x-4 gap-y-3 mt-5">
      <div class="demo-copy min-w-0 flex-1 basis-60 select-text">
        <p class="step-copy m-0 text-[#a1a1ad] text-[0.8125rem] leading-5">
          This workspace is empty. Open an app.
        </p>
        <p class="mode-copy m-[0.2rem_0_0] text-[#82828f] text-[0.6875rem] leading-4 capitalize">
          Dwindle · workspace 1 · empty
        </p>
      </div>
      <div class="action-buttons ml-auto flex shrink-0 gap-[0.35rem]">
        <button
          class="reset-button text-[0.8125rem] leading-5 bg-[#292930] text-[#c6c6cf]"
          type="button"
          aria-label="Reset demo"
          disabled
        >
          <RotateCcwIcon aria-hidden="true" />
          Reset
        </button>
        <button
          class="app-button text-[0.8125rem] leading-5 terminal-button shrink-0 whitespace-nowrap bg-[#24242b] text-[#9999a4] will-change-transform"
          type="button"
          data-app-button="terminal"
          aria-label="Open Terminal"
        >
          <span
            class="app-color size-2 [border:1px_solid_rgb(255_255_255/0.24)] rounded-[0.18rem]"
            aria-hidden="true"
          ></span>
          Terminal
        </button>
        <button
          class="app-button text-[0.8125rem] leading-5 browser-button shrink-0 whitespace-nowrap bg-[#24242b] text-[#9999a4]"
          type="button"
          data-app-button="browser"
          aria-label="Open Browser"
        >
          <span
            class="app-color w-[0.55rem] h-[0.55rem] flex-[0_0_0.55rem] [border:1px_solid_rgb(255_255_255/0.24)] rounded-[0.18rem]"
            aria-hidden="true"
          ></span>
          Browser
        </button>
        <button
          class="app-button text-[0.8125rem] leading-5 editor-button shrink-0 whitespace-nowrap bg-[#24242b] text-[#9999a4]"
          type="button"
          data-app-button="editor"
          aria-label="Open Editor"
        >
          <span
            class="app-color w-[0.55rem] h-[0.55rem] flex-[0_0_0.55rem] [border:1px_solid_rgb(255_255_255/0.24)] rounded-[0.18rem]"
            aria-hidden="true"
          ></span>
          Editor
        </button>
      </div>
    </div>

    <div class="shortcut-panel mt-4 p-[0.85rem] [border:1px_solid_rgb(255_255_255/0.08)] rounded-xl bg-[rgb(8_8_12/0.72)]">
      <div class="shortcut-header flex items-center justify-between gap-4">
        <div>
          <p class="shortcut-title m-0 text-[#e7e7eb] text-[0.8125rem] font-bold leading-5">
            Keyboard shortcuts
          </p>
          <p
            class="shortcut-hint m-0 text-[#92929f] text-[0.6875rem] leading-4"
            data-shortcut-hint
          >
            Alt shortcuts are ready to use in the browser.
          </p>
        </div>

        <label class="shortcut-toggle inline-flex items-center gap-[0.45rem] shrink-0 text-[#b9b9c2] text-xs leading-4 font-[650] cursor-pointer">
          <input type="checkbox" data-shortcuts-toggle checked />
          <span
            class="toggle-track relative w-8 h-[1.1rem] rounded-full bg-[#393941] [transition:background-color_160ms_ease]"
            aria-hidden="true"
          >
            <span></span>
          </span>
          <span data-shortcuts-status>On</span>
        </label>
      </div>

      <div class="shortcut-controls flex items-start justify-between gap-4 mt-3 transition-opacity duration-200 data-shortcuts-disabled:opacity-40 motion-reduce:transition-none">
        <div
          class="modifier-switcher flex shrink-0 gap-[0.15rem] p-[0.16rem] [border:1px_solid_rgb(255_255_255/0.08)] rounded-lg bg-[#111117]"
          role="group"
          aria-label="Shortcut modifier"
        >
          <button
            type="button"
            class="text-[0.6875rem] leading-4"
            data-shortcut-modifier="Alt"
            aria-pressed="true"
          >
            Alt
          </button>
          <button
            type="button"
            class="text-[0.6875rem] leading-4"
            data-shortcut-modifier="Meta"
            aria-pressed="false"
          >
            Super
          </button>
        </div>
        <ul
          class="shortcut-list flex flex-wrap justify-end gap-[0.45rem_0.75rem] m-0 p-0 list-none"
          data-shortcut-list
          aria-label="Demo shortcuts"
        ></ul>
        <template data-shortcut-template>
          <li class="inline-flex items-center gap-[0.35rem] whitespace-nowrap text-[0.625rem] leading-4 text-[#898994]">
            <Keybind keys={['Alt']} size="small" />
            <span data-shortcut-label class="leading-4"></span>
          </li>
        </template>
      </div>
    </div>
  </div>

  <div class="mobile-disabled [&_p]:text-sm [&_p]:leading-5 [&_strong]:text-base hidden p-[2.5rem_1.5rem] text-center bg-[radial-gradient(circle_at_50%_0,#2a1a29,#101014_65%)]">
    <div class="mobile-monitor w-26 m-[0_auto_1.3rem]" aria-hidden="true">
      <div>
        <LayoutGridIcon />
      </div>
      <span></span>
    </div>
    <p>
      <strong>Desktop demo</strong>
    </p>
    <p>
      This workspace needs a little more room. Open the post on a desktop to try
      it.
    </p>
  </div>

  {(['terminal', 'browser', 'editor'] as const).map((app) => (
    <template data-app-template={app}>
      <div
        class="window absolute flex flex-col overflow-hidden [border:2px_solid_rgb(255_255_255/0.14)] rounded-[0.55rem] bg-[#050507] shadow-[0_0.7rem_2rem_rgb(0_0_0/0.4)] contain-[layout_paint] cursor-pointer @container-size [transition:opacity_240ms_ease,border-color_80ms_ease] data-closing:pointer-events-none data-closing:z-10"
        role="button"
        tabindex="0"
      >
        <OmarchyDummyApps app={app} />
      </div>
    </template>
  ))}
</section>

<script>
  import { defaultKeybindingsHandlerIgnore, tinykeys } from 'tinykeys'
  import { getKeyArrowPath } from '../lib/keybind'

  const setupOmarchyDemos = () => {
    document.querySelectorAll<HTMLElement>('.omarchy-demo').forEach((demo) => {
      if (demo.dataset.initialized !== undefined) return
      demo.dataset.initialized = ''
      const lifecycleController = new AbortController()
      const listenerOptions = { signal: lifecycleController.signal }

      const screen = demo.querySelector<HTMLElement>('.screen')
      const workspace = demo.querySelector<HTMLElement>('.workspace')
      // const fullscreenButton = demo.querySelector<HTMLButtonElement>(
      //   '[data-fullscreen-button]',
      // )
      const resetButton = demo.querySelector<HTMLButtonElement>('.reset-button')
      const modeCopy = demo.querySelector<HTMLElement>('.mode-copy')
      const stepCopy = demo.querySelector<HTMLElement>('.step-copy')
      const systemTime =
        demo.querySelector<HTMLTimeElement>('[data-system-time]')
      const layoutButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-layout-button]',
      )
      const workspaceButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-workspace-button]',
      )
      const appButtons =
        demo.querySelectorAll<HTMLButtonElement>('[data-app-button]')
      const shortcutsToggle = demo.querySelector<HTMLInputElement>(
        '[data-shortcuts-toggle]',
      )
      const shortcutsStatus = demo.querySelector<HTMLElement>(
        '[data-shortcuts-status]',
      )
      const shortcutHint = demo.querySelector<HTMLElement>(
        '[data-shortcut-hint]',
      )
      const shortcutList = demo.querySelector<HTMLUListElement>(
        '[data-shortcut-list]',
      )
      const shortcutControls =
        demo.querySelector<HTMLElement>('.shortcut-controls')
      const modifierButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-shortcut-modifier]',
      )

      if (
        !screen ||
        !workspace ||
        // !fullscreenButton ||
        !resetButton ||
        !modeCopy ||
        !stepCopy ||
        !systemTime ||
        !shortcutsToggle ||
        !shortcutsStatus ||
        !shortcutHint ||
        !shortcutList ||
        !shortcutControls
      )
        return

      const appIds = ['terminal', 'browser', 'editor'] as const
      type DemoApp = (typeof appIds)[number]
      type LayoutMode = 'dwindle' | 'scrolling'
      type DemoWindow = { id: number; app: DemoApp }

      // TODO(shipping): Set this to [] to restore the empty production default.
      const TEMPORARY_PRE_SHIP_DEFAULT_APPS: readonly DemoApp[] = appIds

      const appLabels: Record<DemoApp, string> = {
        terminal: 'Terminal',
        browser: 'Browser',
        editor: 'Editor',
      }
      const workspaceWindows: DemoWindow[][] = Array.from(
        workspaceButtons,
        () => [],
      )
      const workspaceFocus: (number | null)[] = Array.from(
        workspaceButtons,
        () => null,
      )
      const workspaceReveal: (number | null)[] = Array.from(
        workspaceButtons,
        () => null,
      )
      const workspaceFocusMemory: Map<string, number>[] = Array.from(
        workspaceButtons,
        () => new Map(),
      )
      const workspaceLayouts: LayoutMode[] = Array.from(
        workspaceButtons,
        () => 'dwindle',
      )
      let nextWindowId = 1
      let activeWorkspace = 1
      let workspaceSwitchVersion = 0
      let layoutTransitionVersion = 0
      let hoverFocusLocked = false
      let shortcutModifier: 'Meta' | 'Alt' = 'Alt'
      let unsubscribeShortcuts: (() => void) | undefined
      const windowAnimations = new Map<HTMLElement, Animation>()

      for (const app of TEMPORARY_PRE_SHIP_DEFAULT_APPS) {
        const demoWindow = { id: nextWindowId++, app }
        workspaceWindows[0].push(demoWindow)
        workspaceFocus[0] = demoWindow.id
        workspaceReveal[0] = demoWindow.id
      }

      const cancelWindowAnimation = (appWindow: HTMLElement) => {
        windowAnimations.get(appWindow)?.cancel()
        delete appWindow.dataset.opening
        windowAnimations.delete(appWindow)
      }

      const cancelWindowAnimations = () => {
        for (const appWindow of windowAnimations.keys())
          cancelWindowAnimation(appWindow)
      }

      const getAppWindows = () =>
        workspace.querySelectorAll<HTMLElement>('.window:not([data-closing])')

      const animateWindowClosing = (appWindow: HTMLElement) => {
        cancelWindowAnimation(appWindow)
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return

        // Keep a visual copy in place while the remaining windows reflow.
        const rect = appWindow.getBoundingClientRect()
        const workspaceRect = workspace.getBoundingClientRect()
        const closingWindow = appWindow.cloneNode(true) as HTMLElement
        delete closingWindow.dataset.windowId
        closingWindow.dataset.closing = ''
        closingWindow.inert = true
        closingWindow.setAttribute('aria-hidden', 'true')
        closingWindow.tabIndex = -1
        Object.assign(closingWindow.style, {
          inset: 'auto',
          left: `${rect.left - workspaceRect.left}px`,
          top: `${rect.top - workspaceRect.top}px`,
          width: `${rect.width}px`,
          height: `${rect.height}px`,
        })
        workspace.append(closingWindow)

        const animation = closingWindow.animate(
          [
            { opacity: 1, scale: '1', transformOrigin: 'center' },
            { opacity: 0, scale: '0.96', transformOrigin: 'center' },
          ],
          { duration: 100, easing: 'ease-out', fill: 'forwards' },
        )
        windowAnimations.set(closingWindow, animation)
        const removeClosingWindow = () => {
          closingWindow.remove()
          windowAnimations.delete(closingWindow)
        }
        animation.addEventListener('finish', removeClosingWindow, {
          once: true,
        })
        animation.addEventListener('cancel', removeClosingWindow, {
          once: true,
        })
      }

      const createAppWindow = (app: DemoApp) => {
        const template = demo.querySelector<HTMLTemplateElement>(
          `[data-app-template="${app}"]`,
        )
        const appWindow = template?.content.firstElementChild?.cloneNode(
          true,
        ) as HTMLElement | undefined
        if (!appWindow) return null

        const selectAppWindow = () => {
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) selectWindow(windowId)
        }
        const closeAppWindow = (event: Event) => {
          event.stopPropagation()
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) closeWindow(windowId)
        }

        appWindow.addEventListener('click', selectAppWindow)
        appWindow.addEventListener('focus', selectAppWindow)
        appWindow.addEventListener('mouseenter', () => {
          if (hoverFocusLocked) return
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) selectWindow(windowId, false)
        })
        appWindow
          .querySelector('[data-window-close]')
          ?.addEventListener('click', closeAppWindow)
        appWindow.addEventListener('keydown', (event) => {
          if (event.key !== 'Enter' && event.key !== ' ') return
          event.preventDefault()
          selectAppWindow()
        })
        return appWindow
      }

      type WindowRects = Map<HTMLElement, DOMRect>

      const captureWindowRects = (): WindowRects =>
        new Map(
          Array.from(getAppWindows()).map((appWindow) => [
            appWindow,
            appWindow.getBoundingClientRect(),
          ]),
        )

      const animateWindowLayout = (previousRects: WindowRects) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return []

        const animations: Animation[] = []
        for (const [appWindow, previousRect] of previousRects) {
          if (!appWindow.isConnected) continue

          const nextRect = appWindow.getBoundingClientRect()
          const translateX = previousRect.left - nextRect.left
          const translateY = previousRect.top - nextRect.top
          const scaleX = previousRect.width / nextRect.width
          const scaleY = previousRect.height / nextRect.height
          const positionChanged =
            Math.abs(translateX) > 0.5 || Math.abs(translateY) > 0.5
          const sizeChanged =
            Math.abs(scaleX - 1) > 0.005 || Math.abs(scaleY - 1) > 0.005
          if (!positionChanged && !sizeChanged) continue

          cancelWindowAnimation(appWindow)
          const animation = appWindow.animate(
            [
              {
                translate: `${translateX}px ${translateY}px`,
                scale: `${scaleX} ${scaleY}`,
                transformOrigin: 'top left',
              },
              {
                translate: '0 0',
                scale: '1 1',
                transformOrigin: 'top left',
              },
            ],
            {
              duration: 480,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            },
          )

          windowAnimations.set(appWindow, animation)
          animations.push(animation)
          const clearAnimation = () => {
            if (windowAnimations.get(appWindow) === animation)
              windowAnimations.delete(appWindow)
          }
          animation.addEventListener('finish', clearAnimation, { once: true })
          animation.addEventListener('cancel', clearAnimation, { once: true })
        }

        return animations
      }

      const animateWindowOpening = (windowId: number) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return

        const appWindow = workspace.querySelector<HTMLElement>(
          `[data-window-id="${windowId}"]`,
        )
        if (!appWindow) return

        cancelWindowAnimation(appWindow)
        appWindow.dataset.opening = ''
        const animation = appWindow.animate(
          [
            { opacity: 0, scale: '0.5' },
            { opacity: 1, scale: '1' },
          ],
          {
            duration: 480,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          },
        )

        windowAnimations.set(appWindow, animation)
        animation.addEventListener(
          'finish',
          () => {
            delete appWindow.dataset.opening
            windowAnimations.delete(appWindow)
          },
          { once: true },
        )
        animation.addEventListener(
          'cancel',
          () => windowAnimations.delete(appWindow),
          { once: true },
        )
      }

      const timeFormatter = new Intl.DateTimeFormat('en-GB', {
        weekday: 'short',
        day: '2-digit',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      })

      const updateSystemTime = () => {
        const now = new Date()
        const parts = Object.fromEntries(
          timeFormatter
            .formatToParts(now)
            .filter(({ type }) => type !== 'literal')
            .map(({ type, value }) => [type, value]),
        )

        systemTime.dateTime = now.toISOString()
        systemTime.textContent = `${parts.weekday} ${parts.day} ${parts.month} ${parts.hour}:${parts.minute}`
      }

      updateSystemTime()
      const clockInterval = window.setInterval(updateSystemTime, 1000)

      const update = () => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const layout = workspaceLayouts[activeWorkspace - 1] ?? 'dwindle'
        const windowCount = openWindows.length
        const focusIndex = activeWorkspace - 1
        const focusedWindowId = workspaceFocus[focusIndex]
        if (!openWindows.some(({ id }) => id === focusedWindowId))
          workspaceFocus[focusIndex] = openWindows.at(-1)?.id ?? null
        const revealedWindowId = workspaceReveal[focusIndex]
        if (!openWindows.some(({ id }) => id === revealedWindowId))
          workspaceReveal[focusIndex] = openWindows.at(-1)?.id ?? null
        const focusedWindow = openWindows.find(
          ({ id }) => id === workspaceFocus[focusIndex],
        )
        const revealedWindow = openWindows.find(
          ({ id }) => id === workspaceReveal[focusIndex],
        )

        screen.dataset.layout = layout
        screen.dataset.windowCount = String(windowCount)
        screen.dataset.workspace = String(activeWorkspace)
        screen.dataset.focusedPosition = String(
          revealedWindow ? openWindows.indexOf(revealedWindow) + 1 : 0,
        )
        screen.setAttribute(
          'aria-label',
          `Workspace ${activeWorkspace}, ${windowCount} ${windowCount === 1 ? 'window' : 'windows'}, ${layout} layout${focusedWindow ? `, ${focusedWindow.app} focused` : ''}`,
        )
        const layoutLabel = layout === 'dwindle' ? 'Dwindle' : 'Scrolling'

        modeCopy.textContent = `${layoutLabel} · workspace ${activeWorkspace} · ${windowCount === 0 ? 'empty' : `${windowCount} ${windowCount === 1 ? 'window' : 'windows'}`}`

        stepCopy.textContent =
          windowCount === 0
            ? 'This workspace is empty. Open an app.'
            : windowCount === 1
              ? 'You can open more windows to see the layout take shape.'
              : windowCount === 2
                ? 'You can open another window to complete the layout.'
                : 'You can change layout modes or switch workspaces.'

        const visibleIds = new Set(openWindows.map(({ id }) => id))
        getAppWindows().forEach((appWindow) => {
          if (visibleIds.has(Number(appWindow.dataset.windowId))) return
          cancelWindowAnimation(appWindow)
          appWindow.remove()
        })

        openWindows.forEach((demoWindow, position) => {
          let appWindow = workspace.querySelector<HTMLElement>(
            `[data-window-id="${demoWindow.id}"]`,
          )
          if (!appWindow) {
            appWindow = createAppWindow(demoWindow.app)
            if (!appWindow) return
            appWindow.dataset.windowId = String(demoWindow.id)
            workspace.append(appWindow)
          }
          const isFocused = demoWindow.id === workspaceFocus[focusIndex]
          appWindow.dataset.window = String(position + 1)
          appWindow.dataset.app = demoWindow.app
          appWindow.setAttribute(
            'aria-label',
            `Focus ${appLabels[demoWindow.app]} window ${position + 1}`,
          )
          if (isFocused) appWindow.dataset.focused = ''
          else delete appWindow.dataset.focused
          appWindow.setAttribute('aria-pressed', String(isFocused))
        })

        const isInitialState =
          activeWorkspace === 1 &&
          workspaceWindows.every((windows) => windows.length === 0) &&
          workspaceLayouts.every(
            (workspaceLayout) => workspaceLayout === 'dwindle',
          )

        resetButton.disabled = isInitialState

        appButtons.forEach((button) => {
          const app = button.dataset.appButton as DemoApp
          button.disabled = windowCount >= 3
          button.setAttribute('aria-label', `Open ${appLabels[app]}`)
        })

        layoutButtons.forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.layoutButton === layout),
          )
        })

        workspaceButtons.forEach((button) => {
          const workspaceIndex = Number(button.dataset.workspaceButton) - 1
          const hasWindows = (workspaceWindows[workspaceIndex]?.length ?? 0) > 0
          button.toggleAttribute('data-occupied', hasWindows)
          button.setAttribute(
            'aria-pressed',
            String(Number(button.dataset.workspaceButton) === activeWorkspace),
          )
        })
      }

      const updateFocusState = () => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const layout = workspaceLayouts[activeWorkspace - 1] ?? 'dwindle'
        const focusedWindowId = workspaceFocus[activeWorkspace - 1]
        const focusedWindow = openWindows.find(
          ({ id }) => id === focusedWindowId,
        )

        screen.setAttribute(
          'aria-label',
          `Workspace ${activeWorkspace}, ${openWindows.length} ${openWindows.length === 1 ? 'window' : 'windows'}, ${layout} layout${focusedWindow ? `, ${focusedWindow.app} focused` : ''}`,
        )
        getAppWindows().forEach((appWindow) => {
          const isFocused =
            Number(appWindow.dataset.windowId) === focusedWindowId
          if (isFocused) appWindow.dataset.focused = ''
          else delete appWindow.dataset.focused
          appWindow.setAttribute('aria-pressed', String(isFocused))
        })
      }

      const openApp = (app: DemoApp) => {
        workspaceSwitchVersion += 1
        delete screen.dataset.switchingWorkspace

        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        if (openWindows.length >= appIds.length) return

        const previousRects = captureWindowRects()
        const demoWindow = { id: nextWindowId++, app }
        openWindows.push(demoWindow)
        workspaceFocus[activeWorkspace - 1] = demoWindow.id
        workspaceReveal[activeWorkspace - 1] = demoWindow.id
        update()
        animateWindowLayout(previousRects)
        animateWindowOpening(demoWindow.id)
      }

      const closeWindow = (windowId: number) => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const windowIndex = openWindows.findIndex(({ id }) => id === windowId)
        if (windowIndex === -1) return
        const previousRects = captureWindowRects()

        const appWindow = workspace.querySelector<HTMLElement>(
          `[data-window-id="${windowId}"]`,
        )
        if (appWindow) animateWindowClosing(appWindow)
        openWindows.splice(windowIndex, 1)

        if (workspaceFocus[activeWorkspace - 1] === windowId)
          workspaceFocus[activeWorkspace - 1] = openWindows.at(-1)?.id ?? null
        if (workspaceReveal[activeWorkspace - 1] === windowId)
          workspaceReveal[activeWorkspace - 1] = openWindows.at(-1)?.id ?? null
        update()
        animateWindowLayout(previousRects)
      }

      const selectWindow = (windowId: number, reveal = true) => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        if (!openWindows.some(({ id }) => id === windowId)) return

        const workspaceIndex = activeWorkspace - 1
        const focusChanged = workspaceFocus[workspaceIndex] !== windowId
        const revealChanged =
          reveal && workspaceReveal[workspaceIndex] !== windowId
        if (!focusChanged && !revealChanged) return

        const previousRects = revealChanged ? captureWindowRects() : null
        workspaceFocus[workspaceIndex] = windowId
        if (reveal) workspaceReveal[workspaceIndex] = windowId
        if (revealChanged && previousRects) {
          update()
          animateWindowLayout(previousRects)
        } else {
          updateFocusState()
        }
      }

      const closeFocusedWindow = () => {
        const focusedWindowId = workspaceFocus[activeWorkspace - 1]
        if (focusedWindowId) closeWindow(focusedWindowId)
      }

      type FocusDirection = 'left' | 'right' | 'up' | 'down'
      type WindowPoint = { windowId: number; x: number; y: number }

      const oppositeFocusDirection = (
        direction: FocusDirection,
      ): FocusDirection =>
        direction === 'left'
          ? 'right'
          : direction === 'right'
            ? 'left'
            : direction === 'up'
              ? 'down'
              : 'up'

      const focusMemoryKey = (windowId: number, direction: FocusDirection) =>
        `${windowId}:${direction}`

      const getWindowPoints = (openWindows: DemoWindow[]): WindowPoint[] => {
        if (workspaceLayouts[activeWorkspace - 1] === 'scrolling')
          return openWindows.map(({ id }, index) => ({
            windowId: id,
            x: index,
            y: 0,
          }))

        const positions =
          openWindows.length === 3
            ? [
                [0, 0.5],
                [1, 0],
                [1, 1],
              ]
            : openWindows.length === 2
              ? [
                  [0, 0],
                  [1, 0],
                ]
              : [[0, 0]]

        return openWindows.map(({ id }, index) => ({
          windowId: id,
          x: positions[index]?.[0] ?? 0,
          y: positions[index]?.[1] ?? 0,
        }))
      }

      const focusWindow = (direction: FocusDirection) => {
        const workspaceIndex = activeWorkspace - 1
        const openWindows = workspaceWindows[workspaceIndex] ?? []
        const focusedWindowId = workspaceFocus[workspaceIndex]
        if (!focusedWindowId || openWindows.length < 2) return

        const points = getWindowPoints(openWindows)
        const current = points.find(
          ({ windowId }) => windowId === focusedWindowId,
        )
        if (!current) return

        const candidates = points
          .filter((point) => {
            if (direction === 'left') return point.x < current.x
            if (direction === 'right') return point.x > current.x
            if (direction === 'up') return point.y < current.y
            return point.y > current.y
          })
          .map((point) => {
            const primary =
              direction === 'left' || direction === 'right'
                ? Math.abs(point.x - current.x)
                : Math.abs(point.y - current.y)
            const secondary =
              direction === 'left' || direction === 'right'
                ? Math.abs(point.y - current.y)
                : Math.abs(point.x - current.x)
            return { ...point, distance: primary + secondary * 1.5 }
          })
          .sort((a, b) => a.distance - b.distance)

        if (workspaceLayouts[workspaceIndex] !== 'dwindle') {
          if (candidates[0]) selectWindow(candidates[0].windowId)
          return
        }

        const focusMemory = workspaceFocusMemory[workspaceIndex]
        const rememberedWindowId = (memoryDirection: FocusDirection) => {
          const windowId = focusMemory.get(
            focusMemoryKey(focusedWindowId, memoryDirection),
          )
          return points.find((point) => point.windowId === windowId)
        }
        const rememberedNext = rememberedWindowId(direction)
        let next: WindowPoint | undefined =
          candidates.find(
            ({ windowId }) => windowId === rememberedNext?.windowId,
          ) ?? candidates[0]

        if (!next && (direction === 'left' || direction === 'right')) {
          const edge =
            direction === 'left'
              ? Math.max(...points.map(({ x }) => x))
              : Math.min(...points.map(({ x }) => x))
          const wrappedCandidates = points
            .filter(({ x }) => x === edge)
            .sort(
              (a, b) => Math.abs(a.y - current.y) - Math.abs(b.y - current.y),
            )
          const rememberedOpposite = rememberedWindowId(
            oppositeFocusDirection(direction),
          )
          next =
            wrappedCandidates.find(
              ({ windowId }) => windowId === rememberedOpposite?.windowId,
            ) ?? wrappedCandidates[0]
        }

        if (!next) return
        focusMemory.set(
          focusMemoryKey(focusedWindowId, direction),
          next.windowId,
        )
        focusMemory.set(
          focusMemoryKey(next.windowId, oppositeFocusDirection(direction)),
          focusedWindowId,
        )
        selectWindow(next.windowId)
      }

      const setLayout = (nextLayout: LayoutMode) => {
        if (workspaceLayouts[activeWorkspace - 1] === nextLayout) return

        const transitionVersion = ++layoutTransitionVersion
        hoverFocusLocked = true
        const previousRects = captureWindowRects()
        workspaceLayouts[activeWorkspace - 1] = nextLayout
        update()
        const layoutAnimations = animateWindowLayout(previousRects)

        if (layoutAnimations.length === 0) {
          hoverFocusLocked = false
          return
        }

        void Promise.allSettled(
          layoutAnimations.map((animation) => animation.finished),
        ).then(() => {
          if (transitionVersion === layoutTransitionVersion)
            hoverFocusLocked = false
        })
      }

      const toggleLayout = () => {
        setLayout(
          workspaceLayouts[activeWorkspace - 1] === 'dwindle'
            ? 'scrolling'
            : 'dwindle',
        )
      }

      const switchWorkspace = (workspace: number) => {
        cancelWindowAnimations()
        workspaceSwitchVersion += 1
        const switchVersion = workspaceSwitchVersion
        screen.dataset.switchingWorkspace = ''
        activeWorkspace = workspace
        update()

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            if (switchVersion === workspaceSwitchVersion)
              delete screen.dataset.switchingWorkspace
          })
        })
      }

