      const renderShortcutList = () => {
        const template = demo.querySelector<HTMLTemplateElement>(
          '[data-shortcut-template]',
        )
        if (!template) return

        shortcutList.replaceChildren(
          ...keybinds.map((keybind) => {
            const item = template.content.firstElementChild!.cloneNode(
              true,
            ) as HTMLLIElement
            const keys = item.querySelector<HTMLElement>('[data-keybind]')!
            const keyTemplate = keys.querySelector('kbd')!
            keys.replaceChildren()

            for (const key of [
              shortcutModifier === 'Meta' ? 'Super' : 'Alt',
              ...keybind.keys,
            ]) {
              const keyElement = keyTemplate.cloneNode(true) as HTMLElement
              const keyLabel =
                keyElement.querySelector<HTMLElement>('[data-key-label]')!
              keyLabel.textContent = key
              const arrowPath = getKeyArrowPath(key)
              keyLabel.classList.toggle('opacity-0', Boolean(arrowPath))
              const arrow =
                keyElement.querySelector<SVGElement>('[data-key-arrow]')!
              arrow.classList.toggle('hidden', !arrowPath)
              arrow.querySelector('path')!.setAttribute('d', arrowPath ?? '')
              // Keep copied shortcuts readable without a visible separator.
              if (keys.childElementCount > 0) {
                const separator = document.createElement('span')
                separator.className = 'text-[0px]'
                separator.setAttribute('aria-hidden', 'true')
                separator.textContent = '+'
                keyElement.prepend(separator)
              }
              keys.append(keyElement)
            }

            const label = item.querySelector<HTMLElement>(
              '[data-shortcut-label]',
            )!
            label.textContent = keybind.label
            return item
          }),
        )
      }

      const installShortcuts = () => {
        unsubscribeShortcuts?.()
        unsubscribeShortcuts = undefined

        if (!shortcutsToggle.checked) return

        const bindings = Object.fromEntries(
          keybinds.map((keybind) => [
            `${shortcutModifier}+${keybind.code}`,
            (event: KeyboardEvent) => {
              event.preventDefault()
              keybind.action()
            },
          ]),
        )
        unsubscribeShortcuts = tinykeys(window, bindings, {
          ignore: (event) =>
            event.target !== shortcutsToggle &&
            defaultKeybindingsHandlerIgnore(event),
        })
      }

      const updateShortcutControls = () => {
        const enabled = shortcutsToggle.checked
        shortcutControls.toggleAttribute('data-shortcuts-disabled', !enabled)
        shortcutsStatus.textContent = enabled ? 'On' : 'Off'
        shortcutHint.textContent = enabled
          ? shortcutModifier === 'Meta'
            ? 'Using the Super (Windows/Command) key, which may be captured by your OS but is more faithful.'
            : 'Using the Alt (Option) key so that your browser can receive the shortcuts.'
          : 'Shortcuts are disabled. All interface buttons and controls still work.'
        modifierButtons.forEach((button) => {
          button.disabled = !enabled
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.shortcutModifier === shortcutModifier),
          )
        })
        renderShortcutList()
        installShortcuts()
      }

      // Fullscreen feature disabled for now.
      // const fullscreenPlaceholder = document.createComment('omarchy-demo')
