      calc(50% + var(--window-gap) / 2);
  }
  .screen[data-layout='dwindle'][data-window-count='3']
    .window[data-window='3'] {
    inset: round(nearest, calc(50% + var(--window-gap) / 2), 1px) 0 0
      calc(50% + var(--window-gap) / 2);
  }

  /* Scrolling fills one window, splits two, then becomes a 43%-wide strip. */
  /* Clip the moving strip at the screen edge; window positions keep the gap. */
  .screen[data-layout='scrolling'] .workspace {
