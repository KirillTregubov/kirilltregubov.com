---
import { LayoutGridIcon, MoveHorizontalIcon, RotateCcwIcon } from 'lucide-react'
import OmarchyDummyApps from './OmarchyDummyApps.astro'
---

<section
  class="omarchy-demo not-prose shadow-lg"
  aria-labelledby="omarchy-demo-title"
>
  <div class="demo-heading">
    <div>
      <p class="eyebrow">Interactive workspace</p>
      <h2 id="omarchy-demo-title">See the layout take shape</h2>
    </div>

    <div class="layout-switcher" role="group" aria-label="Window layout">
      <button type="button" data-layout-button="dwindle" aria-pressed="true">
        <LayoutGridIcon aria-hidden="true" />
        <span>Dwindle</span>
      </button>
      <button type="button" data-layout-button="scrolling" aria-pressed="false">
        <MoveHorizontalIcon aria-hidden="true" />
        <span>Scrolling</span>
      </button>
    </div>
  </div>

  <div class="desktop-experience">
    <div class="monitor-shell">
      <div
        class="screen"
        role="group"
        data-layout="dwindle"
        data-window-count="0"
        aria-label="Workspace 1, 0 windows, dwindle layout"
      >
        <div class="wallpaper" aria-hidden="true"></div>

        <div class="topbar">
          <div class="topbar-left">
            <svg
              class="omarchy-logo"
              viewBox="0 0 1200 1200"
              fill="currentColor"
              aria-label="Omarchy"
            >
              <path
                fill-rule="evenodd"
                d="M1200 1200H720v-80h400V80H640.004v160h-400v720h720V240h-80v-80H1040v880H640v160H0V0h1200ZM80 1120h480v-80H160l.004-400H80Zm0-560h80.004V160h400V80H80Z"
                clip-rule="evenodd"
              ></path>
            </svg>
            <div class="workspaces" role="group" aria-label="Workspaces">
              {[1, 2, 3, 4].map((workspace) => (
                <button
                  type="button"
                  class="workspace-button"
                  data-workspace-button={workspace}
                  aria-label={`Switch to workspace ${workspace}`}
                  aria-pressed={workspace === 1 ? 'true' : 'false'}
                >
                  <span class="workspace-number">{workspace}</span>
                </button>
              ))}
            </div>
          </div>
          <time class="clock" data-system-time></time>
          <div class="status-icons" aria-hidden="true">
            <!--
              Paths reproduced from the system's JetBrainsMono Nerd Font:
              Ethernet (f0200), volume-high (f028), and monitor (f0379).
              Keeping the outlines inline makes the demo match Omarchy without
              requiring visitors to have the Nerd Font installed.
            -->
            <svg class="status-icon ethernet-icon" viewBox="0 0 832 792">
              <path d="M207 626V500H291V626H375V500H457V626H541V500H625V626H707V250H541V126H291V250H125V626H207ZM98 0H734Q775 0 803.5 30Q832 60 832 100V694Q832 734 803.5 763Q775 792 734 792H98Q57 792 28.5 763Q0 734 0 694V100Q0 60 28.5 30Q57 0 98 0Z"></path>
            </svg>
            <svg class="status-icon audio-icon" viewBox="0 0 1154 828">
              <path d="M962 11Q1052 84 1103 189Q1154 294 1154 414Q1154 534 1103 639Q1052 744 962 817Q948 828 930 826Q912 824 901 811Q890 797 892 779Q894 761 907 750Q982 690 1024 602Q1066 514 1067 414Q1066 314 1024 226Q982 138 907 78Q894 67 892 49Q890 31 901 17Q912 4 930 2Q948 0 962 11ZM853 145Q913 194 947 264Q981 334 981 414Q981 494 947 564Q913 634 853 683Q839 694 821 692Q803 690 792 677Q780 663 782 645Q784 627 798 616Q894 538 894 414Q894 291 798 213Q784 202 782 184Q780 166 792 152Q803 138 821 136Q839 134 853 145ZM744 280Q808 333 808 414Q808 496 744 549Q730 560 712 558Q694 556 683 542Q672 528 674 510Q676 492 689 481Q721 454 721 414Q721 374 689 347Q676 336 674 318Q672 300 683 286Q694 272 712 270Q730 268 744 280ZM543 16Q577 31 577 68V760Q577 798 543 813Q508 828 481 804L238 587H115Q68 588 34 554Q0 520 0 472V357Q0 309 34 275Q68 241 115 241H238L481 25Q508 1 543 16Z"></path>
            </svg>
            <svg class="status-icon monitor-icon" viewBox="0 0 918 832">
              <path d="M834 82V582H84V82H834ZM834 0H84Q49 0 24.5 24.5Q0 49 0 82V582Q0 617 24.5 641.5Q49 666 84 666H375V750H293V832H625V750H543V666H834Q869 666 893.5 641.5Q918 617 918 582V82Q918 49 893.5 24.5Q869 0 834 0Z"></path>
            </svg>
          </div>
        </div>

        <div class="workspace" aria-live="polite">
          <div
            class="window"
            data-window-slot="0"
            data-window="0"
            role="button"
            tabindex="-1"
            aria-hidden="true"
          >
            <OmarchyDummyApps app="terminal" />
          </div>
          <div
            class="window"
            data-window-slot="1"
            data-window="0"
            role="button"
            tabindex="-1"
            aria-hidden="true"
          >
            <OmarchyDummyApps app="browser" />
          </div>
          <div
            class="window"
            data-window-slot="2"
            data-window="0"
            role="button"
            tabindex="-1"
            aria-hidden="true"
          >
            <OmarchyDummyApps app="editor" />
          </div>
        </div>
      </div>
      <div class="monitor-chin" aria-hidden="true">
        <span>OMARCHY</span>
      </div>
      <div class="monitor-stand" aria-hidden="true"></div>
    </div>

    <div class="demo-controls">
      <div class="demo-copy">
        <p class="step-copy">This workspace is empty. Open its first app.</p>
        <p class="mode-copy">Dwindle · workspace 1 · empty</p>
      </div>
      <div class="action-buttons">
        <button
          class="reset-button"
          type="button"
          aria-label="Reset demo"
          disabled
        >
          <RotateCcwIcon aria-hidden="true" />
          Reset
        </button>
        <button
          class="app-button terminal-button"
          type="button"
          data-app-button="terminal"
          aria-label="Open Terminal"
        >
          <span class="app-color" aria-hidden="true"></span>
          Terminal
        </button>
        <button
          class="app-button browser-button"
          type="button"
          data-app-button="browser"
          aria-label="Open Browser"
        >
          <span class="app-color" aria-hidden="true"></span>
          Browser
        </button>
        <button
          class="app-button editor-button"
          type="button"
          data-app-button="editor"
          aria-label="Open Editor"
        >
          <span class="app-color" aria-hidden="true"></span>
          Editor
        </button>
      </div>
    </div>

    <div class="shortcut-panel">
      <div class="shortcut-header">
        <div>
          <p class="shortcut-title">Keyboard shortcuts</p>
          <p class="shortcut-hint" data-shortcut-hint>
            Alt shortcuts are ready to use in the browser.
          </p>
        </div>

        <label class="shortcut-toggle">
          <input type="checkbox" data-shortcuts-toggle checked />
          <span class="toggle-track" aria-hidden="true">
            <span></span>
          </span>
          <span data-shortcuts-status>On</span>
        </label>
      </div>

      <div class="shortcut-controls">
        <div
          class="modifier-switcher"
          role="group"
          aria-label="Shortcut modifier"
        >
          <button
            type="button"
            data-shortcut-modifier="Meta"
            aria-pressed="false"
          >
            Super
          </button>
          <button
            type="button"
            data-shortcut-modifier="Alt"
            aria-pressed="true"
          >
            Alt
          </button>
        </div>
        <ul
          class="shortcut-list"
          data-shortcut-list
          aria-label="Demo shortcuts"
        ></ul>
      </div>
    </div>
  </div>

  <div class="mobile-disabled">
    <div class="mobile-monitor" aria-hidden="true">
      <div>
        <LayoutGridIcon />
      </div>
      <span></span>
    </div>
    <p>
      <strong>Desktop demo</strong>
    </p>
    <p>
      This workspace needs a little more room. Open the article on a desktop to
      try it.
    </p>
  </div>
</section>

<script>
  import { tinykeys } from 'tinykeys'

  const setupOmarchyDemos = () => {
    document.querySelectorAll<HTMLElement>('.omarchy-demo').forEach((demo) => {
      if (demo.dataset.initialized !== undefined) return
      demo.dataset.initialized = ''
      const lifecycleController = new AbortController()
      const listenerOptions = { signal: lifecycleController.signal }

      const screen = demo.querySelector<HTMLElement>('.screen')
      const resetButton = demo.querySelector<HTMLButtonElement>('.reset-button')
      const modeCopy = demo.querySelector<HTMLElement>('.mode-copy')
      const stepCopy = demo.querySelector<HTMLElement>('.step-copy')
      const systemTime =
        demo.querySelector<HTMLTimeElement>('[data-system-time]')
      const layoutButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-layout-button]',
      )
      const workspaceButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-workspace-button]',
      )
      const appButtons =
        demo.querySelectorAll<HTMLButtonElement>('[data-app-button]')
      const appWindows =
        demo.querySelectorAll<HTMLElement>('[data-window-slot]')
      const shortcutsToggle = demo.querySelector<HTMLInputElement>(
        '[data-shortcuts-toggle]',
      )
      const shortcutsStatus = demo.querySelector<HTMLElement>(
        '[data-shortcuts-status]',
      )
      const shortcutHint = demo.querySelector<HTMLElement>(
        '[data-shortcut-hint]',
      )
      const shortcutList = demo.querySelector<HTMLUListElement>(
        '[data-shortcut-list]',
      )
      const modifierButtons = demo.querySelectorAll<HTMLButtonElement>(
        '[data-shortcut-modifier]',
      )

      if (
        !screen ||
        !resetButton ||
        !modeCopy ||
        !stepCopy ||
        !systemTime ||
        !shortcutsToggle ||
        !shortcutsStatus ||
        !shortcutHint ||
        !shortcutList
      )
        return

      const appIds = ['terminal', 'browser', 'editor'] as const
      type DemoApp = (typeof appIds)[number]
      type LayoutMode = 'dwindle' | 'scrolling'
      type DemoWindow = { id: number; app: DemoApp; slot: number }

      // TODO(shipping): Set this to [] to restore the empty production default.
      const TEMPORARY_PRE_SHIP_DEFAULT_APPS: readonly DemoApp[] = appIds

      const appLabels: Record<DemoApp, string> = {
        terminal: 'Terminal',
        browser: 'Browser',
        editor: 'Editor',
      }
      const workspaceWindows: DemoWindow[][] = [[], [], [], []]
      const workspaceFocus: (number | null)[] = [null, null, null, null]
      const workspaceReveal: (number | null)[] = [null, null, null, null]
      const workspaceLayouts: LayoutMode[] = [
        'dwindle',
        'dwindle',
        'dwindle',
        'dwindle',
      ]
      let nextWindowId = 1
      let activeWorkspace = 1
      let workspaceSwitchVersion = 0
      let layoutTransitionVersion = 0
      let hoverFocusLocked = false
      let shortcutModifier: 'Meta' | 'Alt' = 'Alt'
      let unsubscribeShortcuts: (() => void) | undefined
      const windowAnimations = new Map<HTMLElement, Animation>()

      for (const [slot, app] of TEMPORARY_PRE_SHIP_DEFAULT_APPS.entries()) {
        const demoWindow = { id: nextWindowId++, app, slot }
        workspaceWindows[0].push(demoWindow)
        workspaceFocus[0] = demoWindow.id
        workspaceReveal[0] = demoWindow.id
      }

      const cancelWindowAnimation = (appWindow: HTMLElement) => {
        windowAnimations.get(appWindow)?.cancel()
        delete appWindow.dataset.opening
        windowAnimations.delete(appWindow)
      }

      const cancelWindowAnimations = () => {
        for (const appWindow of windowAnimations.keys())
          cancelWindowAnimation(appWindow)
      }

      type WindowRects = Map<HTMLElement, DOMRect>

      const captureWindowRects = (): WindowRects =>
        new Map(
          Array.from(appWindows)
            .filter((appWindow) => appWindow.dataset.window !== '0')
            .map((appWindow) => [appWindow, appWindow.getBoundingClientRect()]),
        )

      const animateWindowLayout = (previousRects: WindowRects) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return []

        const animations: Animation[] = []
        for (const [appWindow, previousRect] of previousRects) {
          if (appWindow.dataset.window === '0') continue

          const nextRect = appWindow.getBoundingClientRect()
          const translateX = previousRect.left - nextRect.left
          const translateY = previousRect.top - nextRect.top
          const scaleX = previousRect.width / nextRect.width
          const scaleY = previousRect.height / nextRect.height
          const positionChanged =
            Math.abs(translateX) > 0.5 || Math.abs(translateY) > 0.5
          const sizeChanged =
            Math.abs(scaleX - 1) > 0.005 || Math.abs(scaleY - 1) > 0.005
          if (!positionChanged && !sizeChanged) continue

          cancelWindowAnimation(appWindow)
          const animation = appWindow.animate(
            [
              {
                translate: `${translateX}px ${translateY}px`,
                scale: `${scaleX} ${scaleY}`,
                transformOrigin: 'top left',
              },
              {
                translate: '0 0',
                scale: '1 1',
                transformOrigin: 'top left',
              },
            ],
            {
              duration: 480,
              easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
            },
          )

          windowAnimations.set(appWindow, animation)
          animations.push(animation)
          const clearAnimation = () => {
            if (windowAnimations.get(appWindow) === animation)
              windowAnimations.delete(appWindow)
          }
          animation.addEventListener('finish', clearAnimation, { once: true })
          animation.addEventListener('cancel', clearAnimation, { once: true })
        }

        return animations
      }

      const animateWindowOpening = (windowId: number) => {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches)
          return

        const appWindow = demo.querySelector<HTMLElement>(
          `[data-window-id="${windowId}"]`,
        )
        if (!appWindow) return

        cancelWindowAnimation(appWindow)
        appWindow.dataset.opening = ''
        const animation = appWindow.animate(
          [
            { opacity: 0, scale: '0.5' },
            { opacity: 1, scale: '1' },
          ],
          {
            duration: 480,
            easing: 'cubic-bezier(0.22, 1, 0.36, 1)',
          },
        )

        windowAnimations.set(appWindow, animation)
        animation.addEventListener(
          'finish',
          () => {
            delete appWindow.dataset.opening
            windowAnimations.delete(appWindow)
          },
          { once: true },
        )
        animation.addEventListener(
          'cancel',
          () => windowAnimations.delete(appWindow),
          { once: true },
        )
      }

      const timeFormatter = new Intl.DateTimeFormat('en-GB', {
        weekday: 'short',
        day: '2-digit',
        month: 'short',
        hour: '2-digit',
        minute: '2-digit',
        hour12: false,
      })

      const updateSystemTime = () => {
        const now = new Date()
        const parts = Object.fromEntries(
          timeFormatter
            .formatToParts(now)
            .filter(({ type }) => type !== 'literal')
            .map(({ type, value }) => [type, value]),
        )

        systemTime.dateTime = now.toISOString()
        systemTime.textContent = `${parts.weekday} ${parts.day} ${parts.month} ${parts.hour}:${parts.minute}`
      }

      updateSystemTime()
      const clockInterval = window.setInterval(updateSystemTime, 1000)

      const update = () => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const layout = workspaceLayouts[activeWorkspace - 1] ?? 'dwindle'
        const windowCount = openWindows.length
        const focusIndex = activeWorkspace - 1
        const focusedWindowId = workspaceFocus[focusIndex]
        if (!openWindows.some(({ id }) => id === focusedWindowId))
          workspaceFocus[focusIndex] = openWindows.at(-1)?.id ?? null
        const revealedWindowId = workspaceReveal[focusIndex]
        if (!openWindows.some(({ id }) => id === revealedWindowId))
          workspaceReveal[focusIndex] = openWindows.at(-1)?.id ?? null
        const focusedWindow = openWindows.find(
          ({ id }) => id === workspaceFocus[focusIndex],
        )
        const revealedWindow = openWindows.find(
          ({ id }) => id === workspaceReveal[focusIndex],
        )

        screen.dataset.layout = layout
        screen.dataset.windowCount = String(windowCount)
        screen.dataset.workspace = String(activeWorkspace)
        screen.dataset.focusedPosition = String(
          revealedWindow ? openWindows.indexOf(revealedWindow) + 1 : 0,
        )
        screen.setAttribute(
          'aria-label',
          `Workspace ${activeWorkspace}, ${windowCount} ${windowCount === 1 ? 'window' : 'windows'}, ${layout} layout${focusedWindow ? `, ${focusedWindow.app} focused` : ''}`,
        )
        const layoutLabel = layout === 'dwindle' ? 'Dwindle' : 'Scrolling'

        modeCopy.textContent = `${layoutLabel} · workspace ${activeWorkspace} · ${windowCount === 0 ? 'empty' : `${windowCount} ${windowCount === 1 ? 'window' : 'windows'}`}`

        stepCopy.textContent =
          windowCount === 0
            ? 'This workspace is empty. Open its first app.'
            : windowCount === 1
              ? 'Open two more apps to see the layout take shape.'
              : windowCount === 2
                ? 'Open one more app to complete the layout.'
                : 'This workspace is full. Close a window to open another.'

        appWindows.forEach((appWindow, slot) => {
          const demoWindow = openWindows.find((item) => item.slot === slot)
          const position = demoWindow ? openWindows.indexOf(demoWindow) : -1
          const isOpen = demoWindow !== undefined
          const isFocused =
            isOpen && demoWindow.id === workspaceFocus[focusIndex]

          appWindow.dataset.window = isOpen ? String(position + 1) : '0'
          appWindow.classList.toggle(
            'terminal-window',
            demoWindow?.app === 'terminal',
          )
          appWindow.classList.toggle(
            'browser-window',
            demoWindow?.app === 'browser',
          )
          appWindow.classList.toggle(
            'editor-window',
            demoWindow?.app === 'editor',
          )
          if (demoWindow) {
            appWindow.dataset.windowId = String(demoWindow.id)
            appWindow.dataset.app = demoWindow.app
            appWindow.setAttribute(
              'aria-label',
              `Focus ${appLabels[demoWindow.app]} window ${position + 1}`,
            )
          } else {
            delete appWindow.dataset.windowId
            delete appWindow.dataset.app
            appWindow.removeAttribute('aria-label')
          }
          if (isFocused) appWindow.dataset.focused = ''
          else delete appWindow.dataset.focused
          appWindow.setAttribute('aria-hidden', String(!isOpen))
          appWindow.setAttribute('aria-pressed', String(isFocused))
          appWindow.tabIndex = isOpen ? 0 : -1
        })

        const isInitialState =
          activeWorkspace === 1 &&
          workspaceWindows.every((windows) => windows.length === 0) &&
          workspaceLayouts.every(
            (workspaceLayout) => workspaceLayout === 'dwindle',
          )

        resetButton.disabled = isInitialState

        appButtons.forEach((button) => {
          const app = button.dataset.appButton as DemoApp
          button.disabled =
            windowCount >= 3 || openWindows.some((item) => item.app === app)
          button.setAttribute('aria-label', `Open ${appLabels[app]}`)
        })

        layoutButtons.forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.layoutButton === layout),
          )
        })

        workspaceButtons.forEach((button) => {
          button.setAttribute(
            'aria-pressed',
            String(Number(button.dataset.workspaceButton) === activeWorkspace),
          )
        })
      }

      const updateFocusState = () => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const layout = workspaceLayouts[activeWorkspace - 1] ?? 'dwindle'
        const focusedWindowId = workspaceFocus[activeWorkspace - 1]
        const focusedWindow = openWindows.find(
          ({ id }) => id === focusedWindowId,
        )

        screen.setAttribute(
          'aria-label',
          `Workspace ${activeWorkspace}, ${openWindows.length} ${openWindows.length === 1 ? 'window' : 'windows'}, ${layout} layout${focusedWindow ? `, ${focusedWindow.app} focused` : ''}`,
        )
        appWindows.forEach((appWindow) => {
          const isFocused =
            Number(appWindow.dataset.windowId) === focusedWindowId
          if (isFocused) appWindow.dataset.focused = ''
          else delete appWindow.dataset.focused
          appWindow.setAttribute('aria-pressed', String(isFocused))
        })
      }

      const openApp = (app: DemoApp) => {
        workspaceSwitchVersion += 1
        delete screen.dataset.switchingWorkspace

        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        if (
          openWindows.length >= appIds.length ||
          openWindows.some((item) => item.app === app)
        )
          return

        const previousRects = captureWindowRects()
        const slot = appIds.indexOf(app)

        const demoWindow = { id: nextWindowId++, app, slot }
        openWindows.push(demoWindow)
        workspaceFocus[activeWorkspace - 1] = demoWindow.id
        workspaceReveal[activeWorkspace - 1] = demoWindow.id
        update()
        animateWindowLayout(previousRects)
        animateWindowOpening(demoWindow.id)
      }

      const closeWindow = (windowId: number) => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const windowIndex = openWindows.findIndex(({ id }) => id === windowId)
        if (windowIndex === -1) return
        const previousRects = captureWindowRects()

        const appWindow = demo.querySelector<HTMLElement>(
          `[data-window-id="${windowId}"]`,
        )
        if (appWindow) cancelWindowAnimation(appWindow)
        openWindows.splice(windowIndex, 1)

        if (workspaceFocus[activeWorkspace - 1] === windowId)
          workspaceFocus[activeWorkspace - 1] = openWindows.at(-1)?.id ?? null
        if (workspaceReveal[activeWorkspace - 1] === windowId)
          workspaceReveal[activeWorkspace - 1] = openWindows.at(-1)?.id ?? null
        update()
        animateWindowLayout(previousRects)
      }

      const selectWindow = (windowId: number, reveal = true) => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        if (!openWindows.some(({ id }) => id === windowId)) return

        const workspaceIndex = activeWorkspace - 1
        const focusChanged = workspaceFocus[workspaceIndex] !== windowId
        const revealChanged =
          reveal && workspaceReveal[workspaceIndex] !== windowId
        if (!focusChanged && !revealChanged) return

        const previousRects = revealChanged ? captureWindowRects() : null
        workspaceFocus[workspaceIndex] = windowId
        if (reveal) workspaceReveal[workspaceIndex] = windowId
        if (revealChanged && previousRects) {
          update()
          animateWindowLayout(previousRects)
        } else {
          updateFocusState()
        }
      }

      const closeFocusedWindow = () => {
        const focusedWindowId = workspaceFocus[activeWorkspace - 1]
        if (focusedWindowId) closeWindow(focusedWindowId)
      }

      type FocusDirection = 'left' | 'right' | 'up' | 'down'
      type WindowPoint = { windowId: number; x: number; y: number }

      const getWindowPoints = (openWindows: DemoWindow[]): WindowPoint[] => {
        if (workspaceLayouts[activeWorkspace - 1] === 'scrolling')
          return openWindows.map(({ id }, index) => ({
            windowId: id,
            x: index,
            y: 0,
          }))

        const positions =
          openWindows.length === 3
            ? [
                [0, 0.5],
                [1, 0],
                [1, 1],
              ]
            : openWindows.length === 2
              ? [
                  [0, 0],
                  [1, 0],
                ]
              : [[0, 0]]

        return openWindows.map(({ id }, index) => ({
          windowId: id,
          x: positions[index]?.[0] ?? 0,
          y: positions[index]?.[1] ?? 0,
        }))
      }

      const focusWindow = (direction: FocusDirection) => {
        const openWindows = workspaceWindows[activeWorkspace - 1] ?? []
        const focusedWindowId = workspaceFocus[activeWorkspace - 1]
        if (!focusedWindowId || openWindows.length < 2) return

        const points = getWindowPoints(openWindows)
        const current = points.find(
          ({ windowId }) => windowId === focusedWindowId,
        )
        if (!current) return

        const candidates = points
          .filter((point) => {
            if (direction === 'left') return point.x < current.x
            if (direction === 'right') return point.x > current.x
            if (direction === 'up') return point.y < current.y
            return point.y > current.y
          })
          .map((point) => {
            const primary =
              direction === 'left' || direction === 'right'
                ? Math.abs(point.x - current.x)
                : Math.abs(point.y - current.y)
            const secondary =
              direction === 'left' || direction === 'right'
                ? Math.abs(point.y - current.y)
                : Math.abs(point.x - current.x)
            return { ...point, distance: primary + secondary * 1.5 }
          })
          .sort((a, b) => a.distance - b.distance)

        const next = candidates[0]
        if (next) selectWindow(next.windowId)
      }

      const setLayout = (nextLayout: LayoutMode) => {
        if (workspaceLayouts[activeWorkspace - 1] === nextLayout) return

        const transitionVersion = ++layoutTransitionVersion
        hoverFocusLocked = true
        const previousRects = captureWindowRects()
        workspaceLayouts[activeWorkspace - 1] = nextLayout
        update()
        const layoutAnimations = animateWindowLayout(previousRects)

        if (layoutAnimations.length === 0) {
          hoverFocusLocked = false
          return
        }

        void Promise.allSettled(
          layoutAnimations.map((animation) => animation.finished),
        ).then(() => {
          if (transitionVersion === layoutTransitionVersion)
            hoverFocusLocked = false
        })
      }

      const toggleLayout = () => {
        setLayout(
          workspaceLayouts[activeWorkspace - 1] === 'dwindle'
            ? 'scrolling'
            : 'dwindle',
        )
      }

      const switchWorkspace = (workspace: number) => {
        cancelWindowAnimations()
        workspaceSwitchVersion += 1
        const switchVersion = workspaceSwitchVersion
        screen.dataset.switchingWorkspace = ''
        activeWorkspace = workspace
        update()

        window.requestAnimationFrame(() => {
          window.requestAnimationFrame(() => {
            if (switchVersion === workspaceSwitchVersion)
              delete screen.dataset.switchingWorkspace
          })
        })
      }

      type Keybind = {
        code: string
        keys: string[]
        label: string
        action: () => void
      }

      const keybinds: Keybind[] = [
        ...[1, 2, 3, 4].map((workspace) => ({
          code: `Digit${workspace}`,
          keys: [String(workspace)],
          label: `Workspace ${workspace}`,
          action: () => switchWorkspace(workspace),
        })),
        {
          code: 'Enter',
          keys: ['Enter'],
          label: 'Terminal',
          action: () => openApp('terminal'),
        },
        {
          code: 'Shift+Enter',
          keys: ['Shift', 'Enter'],
          label: 'Browser',
          action: () => openApp('browser'),
        },
        {
          code: 'Shift+KeyN',
          keys: ['Shift', 'N'],
          label: 'Editor',
          action: () => openApp('editor'),
        },
        {
          code: 'KeyW',
          keys: ['W'],
          label: 'Close window',
          action: closeFocusedWindow,
        },
        {
          code: 'KeyL',
          keys: ['L'],
          label: 'Toggle layout',
          action: toggleLayout,
        },
        ...(
          [
            ['ArrowLeft', '←', 'left'],
            ['ArrowDown', '↓', 'down'],
            ['ArrowUp', '↑', 'up'],
            ['ArrowRight', '→', 'right'],
          ] as const
        ).map(([code, key, direction]) => ({
          code,
          keys: [key],
          label: `Focus ${direction}`,
          action: () => focusWindow(direction),
        })),
      ]

      const renderShortcutList = () => {
        shortcutList.replaceChildren(
          ...keybinds.map((keybind) => {
            const item = document.createElement('li')
            const keys = document.createElement('span')
            keys.className = 'shortcut-keys'

            for (const key of [
              shortcutModifier === 'Meta' ? 'Super' : 'Alt',
              ...keybind.keys,
            ]) {
              const keyElement = document.createElement('kbd')
              keyElement.textContent = key
              keys.append(keyElement)
            }

            const label = document.createElement('span')
            label.textContent = keybind.label
            item.append(keys, label)
            return item
          }),
        )
      }

      const installShortcuts = () => {
        unsubscribeShortcuts?.()
        unsubscribeShortcuts = undefined

        if (!shortcutsToggle.checked) return

        const bindings = Object.fromEntries(
          keybinds.map((keybind) => [
            `${shortcutModifier}+${keybind.code}`,
            (event: KeyboardEvent) => {
              event.preventDefault()
              keybind.action()
            },
          ]),
        )
        unsubscribeShortcuts = tinykeys(window, bindings)
      }

      const updateShortcutControls = () => {
        const enabled = shortcutsToggle.checked
        shortcutsStatus.textContent = enabled ? 'On' : 'Off'
        shortcutHint.textContent = enabled
          ? shortcutModifier === 'Meta'
            ? 'Super may be captured by your desktop. Switch to Alt to try them.'
            : 'Alt mode is active so the browser can receive the shortcuts.'
          : 'Shortcuts are disabled. Buttons and workspace controls still work.'
        modifierButtons.forEach((button) => {
          button.disabled = !enabled
          button.setAttribute(
            'aria-pressed',
            String(button.dataset.shortcutModifier === shortcutModifier),
          )
        })
        renderShortcutList()
        installShortcuts()
      }

      appButtons.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            const app = button.dataset.appButton as DemoApp
            if (!appIds.includes(app)) return
            openApp(app)
          },
          listenerOptions,
        )
      })

      resetButton.addEventListener(
        'click',
        () => {
          cancelWindowAnimations()
          workspaceSwitchVersion += 1
          delete screen.dataset.switchingWorkspace
          workspaceWindows.splice(0, workspaceWindows.length, [], [], [], [])
          workspaceFocus.splice(
            0,
            workspaceFocus.length,
            null,
            null,
            null,
            null,
          )
          workspaceReveal.splice(
            0,
            workspaceReveal.length,
            null,
            null,
            null,
            null,
          )
          workspaceLayouts.splice(
            0,
            workspaceLayouts.length,
            'dwindle',
            'dwindle',
            'dwindle',
            'dwindle',
          )
          nextWindowId = 1
          activeWorkspace = 1
          update()
        },
        listenerOptions,
      )

      workspaceButtons.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            switchWorkspace(Number(button.dataset.workspaceButton) || 1)
          },
          listenerOptions,
        )
      })

      appWindows.forEach((appWindow) => {
        const selectSlotWindow = () => {
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) selectWindow(windowId)
        }

        const selectSlotWindowOnHover = () => {
          if (hoverFocusLocked) return
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) selectWindow(windowId, false)
        }

        const closeSlotWindow = (event: Event) => {
          event.stopPropagation()
          const windowId = Number(appWindow.dataset.windowId)
          if (windowId) closeWindow(windowId)
        }

        appWindow.addEventListener('click', selectSlotWindow, listenerOptions)
        appWindow.addEventListener('focus', selectSlotWindow, listenerOptions)
        appWindow.addEventListener(
          'mouseenter',
          selectSlotWindowOnHover,
          listenerOptions,
        )
        appWindow
          .querySelectorAll<HTMLElement>('[data-window-close]')
          .forEach((closeButton) => {
            closeButton.addEventListener(
              'click',
              closeSlotWindow,
              listenerOptions,
            )
          })
        appWindow.addEventListener(
          'keydown',
          (event) => {
            if (event.key !== 'Enter' && event.key !== ' ') return
            event.preventDefault()
            selectSlotWindow()
          },
          listenerOptions,
        )
      })

      layoutButtons.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            setLayout(
              button.dataset.layoutButton === 'scrolling'
                ? 'scrolling'
                : 'dwindle',
            )
          },
          listenerOptions,
        )
      })

      shortcutsToggle.addEventListener(
        'change',
        updateShortcutControls,
        listenerOptions,
      )
      modifierButtons.forEach((button) => {
        button.addEventListener(
          'click',
          () => {
            shortcutModifier =
              button.dataset.shortcutModifier === 'Alt' ? 'Alt' : 'Meta'
            updateShortcutControls()
          },
          listenerOptions,
        )
      })

      document.addEventListener(
        'astro:before-swap',
        () => {
          window.clearInterval(clockInterval)
          layoutTransitionVersion += 1
          unsubscribeShortcuts?.()
          cancelWindowAnimations()
          lifecycleController.abort()
          delete demo.dataset.initialized
        },
        { once: true },
      )

      update()
      updateShortcutControls()
    })
  }

  document.addEventListener('astro:page-load', setupOmarchyDemos)
</script>

