---
import { getBadge } from './badges'

interface Props {
  format: string
  class?: string
}

const { format, class: className } = Astro.props
const badge = getBadge(format)
---

{/* Requires a BadgeSprite on the page that includes this format. */}
{badge ? (
  <span
    class:list={['inline-flex min-w-0 items-center', className]}
    role="img"
    aria-label={format}
  >
    <svg
      class="block h-4 w-auto max-w-43 overflow-visible"
      width={badge.width}
      height={badge.height}
      viewBox={badge.viewBox}
      fill="none"
      aria-hidden="true"
    >
      <use href={`#${badge.id}`} />
    </svg>
  </span>
) : (
  <span>{format}</span>
)}
