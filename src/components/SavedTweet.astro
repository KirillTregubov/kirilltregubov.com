---
import { EmbeddedTweet } from 'react-tweet'
import { fetchTweet } from '@lib/tweets'

interface Props {
  url: string
}

const { url } = Astro.props

// Fetched at build time, so the page shows the post even where X is blocked.
const tweet = await fetchTweet(url)
---

{tweet ? (
  <div class="[&_.react-tweet-theme]:m-0! [&_.react-tweet-theme]:max-w-none! [&_.react-tweet-theme]:min-w-0! [&_.react-tweet-theme]:[--tweet-header-line-height:1.5rem]! [&_.react-tweet-theme_p_a]:underline! [&_.react-tweet-theme_p_a]:underline-offset-2">
    <EmbeddedTweet tweet={tweet} />
  </div>
) : (
  <a
    href={url}
    target="_blank"
    rel="noopener"
    class="block rounded-xl border border-neutral-700 bg-neutral-800 px-4 py-3 text-neutral-300 transition hover:border-neutral-600 hover:text-white"
  >
    Couldn't load this post. Open it on X →
    <span class="mt-1 block truncate text-sm text-neutral-500">{url}</span>
  </a>
)}

<script>
  // The tweet is static HTML, so wire up react-tweet's video play button by hand
  // instead of hydrating React for it.
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLButtonElement>(
        '.react-tweet-theme video + button:not([data-init])',
      )
      .forEach((button) => {
        const video = button.previousElementSibling
        const overlay = button.nextElementSibling
        if (
          !(video instanceof HTMLVideoElement) ||
          !(overlay instanceof HTMLElement)
        )
          return

        const source = video.querySelector('source')
        const watchOnX = overlay.querySelector('a')
        if (!source || !watchOnX) return

        button.dataset.init = ''
        button.setAttribute('aria-label', 'Play video')
        watchOnX.setAttribute('aria-live', 'polite')

        const showFallback = () => {
          const failureMessage = 'Playback failed. Watch on X'
          const hadFocus = document.activeElement === video
          button.hidden = false
          overlay.hidden = false
          video.controls = false
          video.tabIndex = -1
          if (watchOnX.textContent !== failureMessage) {
            watchOnX.textContent = failureMessage
          }
          if (hadFocus) button.focus()
        }

        video.addEventListener('error', showFallback)
        button.addEventListener('click', async () => {
          // A direct src makes a failed download reject play() in browsers
          // that can leave it pending with <source> children.
          if (video.src !== source.src || video.error) video.src = source.src
          try {
            await video.play()
          } catch {
            showFallback()
            return
          }

          const hadFocus = document.activeElement === button
          video.controls = true
          video.tabIndex = 0
          if (hadFocus) video.focus()
          button.hidden = true
          overlay.hidden = true
        })
      })
  })
</script>
