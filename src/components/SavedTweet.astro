---
import { EmbeddedTweet } from 'react-tweet'
import { fetchTweet } from '@lib/tweets'

interface Props {
  url: string
}

const { url } = Astro.props

// Fetched at build time, so the page shows the post even where X is blocked.
const tweet = await fetchTweet(url)
const hintId = tweet && `saved-tweet-hint-${tweet.id_str}`
---

{tweet ? (
  <div
    data-saved-tweet
    tabindex="0"
    role="group"
    aria-label={`Post by ${tweet.user.name}`}
    aria-describedby={hintId}
    class="group/tweet relative rounded-xl transition-shadow motion-reduce:transition-none [&_.react-tweet-theme]:m-0! [&_.react-tweet-theme]:max-w-none! [&_.react-tweet-theme]:min-w-0! [&_.react-tweet-theme]:[--tweet-header-line-height:1.5rem]! [&_.react-tweet-theme_p_a]:underline! [&_.react-tweet-theme_p_a]:underline-offset-2"
  >
    <EmbeddedTweet tweet={tweet} />
    <span id={hintId} hidden>
      Press Enter to move through the links in this post, and Escape to leave
      it.
    </span>
    <span
      aria-hidden="true"
      class="pointer-events-none absolute -top-3 right-4 hidden rounded-md border border-neutral-600 bg-neutral-800 px-2 py-0.5 text-xs text-neutral-300 group-focus-visible/tweet:block"
    >
      Enter to explore
    </span>
  </div>
) : (
  <a
    href={url}
    target="_blank"
    rel="noopener"
    class="block rounded-xl border border-neutral-700 bg-neutral-800 px-4 py-3 text-neutral-300 transition hover:border-neutral-600 hover:text-white"
  >
    Couldn't load this post. Open it on X →
    <span class="mt-1 block truncate text-sm text-neutral-500">{url}</span>
  </a>
)}

<script>
  // Each post is one Tab stop. Its links and buttons leave the tab order until
  // you press Enter (or focus one by clicking or with a screen reader), and
  // drop back out once focus leaves the post, so Tab skips dense posts.
  const focusable =
    'a[href], button, input, select, textarea, iframe, summary, video[controls], [tabindex]'

  const inner = (post: HTMLElement) =>
    [...post.querySelectorAll<HTMLElement>(focusable)].filter(
      (element) => element !== post,
    )

  const collapse = (post: HTMLElement) => {
    if (post.dataset.collapsed !== undefined) return
    post.dataset.collapsed = ''
    for (const element of inner(post)) {
      if (element.dataset.tabindex === undefined) {
        element.dataset.tabindex = element.getAttribute('tabindex') ?? ''
      }
      element.tabIndex = -1
    }
  }

  const expand = (post: HTMLElement) => {
    if (post.dataset.collapsed === undefined) return
    delete post.dataset.collapsed
    for (const element of inner(post)) {
      const saved = element.dataset.tabindex
      if (saved === undefined) continue
      delete element.dataset.tabindex
      if (saved === '') element.removeAttribute('tabindex')
      else element.setAttribute('tabindex', saved)
    }
  }

  const isTabbable = (element: HTMLElement) =>
    element.tabIndex >= 0 && !element.closest('[hidden]')

  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLElement>('[data-saved-tweet]:not([data-init])')
      .forEach((post) => {
        post.dataset.init = ''
        collapse(post)

        post.addEventListener('focusin', (event) => {
          if (event.target !== post) expand(post)
        })
        post.addEventListener('focusout', (event) => {
          const next = event.relatedTarget
          if (next instanceof Node && !post.contains(next)) collapse(post)
        })
        post.addEventListener('keydown', (event) => {
          if (
            event.target === post &&
            (event.key === 'Enter' || event.key === ' ')
          ) {
            event.preventDefault()
            expand(post)
            inner(post).find(isTabbable)?.focus()
          } else if (event.target !== post && event.key === 'Escape') {
            event.preventDefault()
            collapse(post)
            post.focus()
          }
        })
      })
  })

  // The tweet is static HTML, so wire up react-tweet's video play button by hand
  // instead of hydrating React for it.
  document.addEventListener('astro:page-load', () => {
    document
      .querySelectorAll<HTMLButtonElement>(
        '.react-tweet-theme video + button:not([data-init])',
      )
      .forEach((button) => {
        const video = button.previousElementSibling
        const overlay = button.nextElementSibling
        if (
          !(video instanceof HTMLVideoElement) ||
          !(overlay instanceof HTMLElement)
        )
          return

        const source = video.querySelector('source')
        const watchOnX = overlay.querySelector('a')
        if (!source || !watchOnX) return

        button.dataset.init = ''
        button.setAttribute('aria-label', 'Play video')
        watchOnX.setAttribute('aria-live', 'polite')

        const showFallback = () => {
          const failureMessage = 'Playback failed. Watch on X'
          const hadFocus = document.activeElement === video
          button.hidden = false
          overlay.hidden = false
          video.controls = false
          video.tabIndex = -1
          if (watchOnX.textContent !== failureMessage) {
            watchOnX.textContent = failureMessage
          }
          if (hadFocus) button.focus()
        }

        video.addEventListener('error', showFallback)
        button.addEventListener('click', async () => {
          // A direct src makes a failed download reject play() in browsers
          // that can leave it pending with <source> children.
          if (video.src !== source.src || video.error) video.src = source.src
          try {
            await video.play()
          } catch {
            showFallback()
            return
          }

          const hadFocus = document.activeElement === button
          video.controls = true
          video.tabIndex = 0
          if (hadFocus) video.focus()
          button.hidden = true
          overlay.hidden = true
        })
      })
  })
</script>
