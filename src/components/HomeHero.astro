---
import AboutMe from './AboutMe.astro'
import Saturn from './Saturn'
import { interactiveButtonClass } from '@styles/classes'
---

<section class="flex flex-col justify-center lg:flex-row lg:items-center lg:gap-6 xl:gap-0 2xl:-mt-6">
  <AboutMe class="animate-[fadeUp_0.6s_forwards] lg:text-balance" />
  <figure
    class="saturn relative box-content h-[calc(100vw-10.5rem)] max-h-69 w-full overflow-hidden sm:max-h-74 lg:h-[calc(100vw-9rem)] lg:max-h-75 lg:min-w-105 xl:max-h-100 xl:min-w-150 2xl:min-w-175"
    title="My favourite planet, Saturn."
  >
    <Saturn
      client:idle
      className="max-lg:h-[calc(100%+1.5rem)] max-lg:-translate-y-6 sm:max-lg:h-88 sm:max-lg:-translate-y-14"
    />
    <figcaption class="absolute bottom-0 w-full pb-2 text-center text-sm font-medium text-neutral-400/80 motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0 xl:pb-4 2xl:pb-6">
      My favourite planet, Saturn.{' '}
      <a
        class:list={[interactiveButtonClass, '-m-0.5 inline-block rounded-sm p-0.5 underline select-none hover:text-neutral-300 focus-visible:text-neutral-300 focus-visible:outline-hidden active:text-neutral-300']}
        href="https://science.nasa.gov/resource/saturn-3d-model/"
        target="_blank"
        rel="noopener"
      >
        Source
      </a>
    </figcaption>
  </figure>
</section>
