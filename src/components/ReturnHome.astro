---
import { ArrowLeftIcon, HomeIcon } from 'lucide-react'
import { interactiveButtonClass } from '@styles/classes'

interface Props {
  containerClass?: string
  href?: string
  label?: string
}

const { containerClass, href = '/', label = 'Home', ...props } = Astro.props
---

<menu
  class:list={[
    "sticky -top-1 isolate z-10 -mx-1 -mt-5 mb-4 flex gap-6 px-1 pt-5 pb-2 before:pointer-events-none before:absolute before:inset-y-0 before:left-1/2 before:-z-10 before:w-dvw before:-translate-x-1/2 before:bg-neutral-900 before:content-[''] after:pointer-events-none after:absolute after:-bottom-2 after:left-1/2 after:z-10 after:h-2 after:w-dvw after:-translate-x-1/2 after:bg-linear-to-b after:from-neutral-900 after:to-transparent after:content-[''] motion-safe:animate-[fadeUp_0.6s_forwards] motion-safe:opacity-0 max-xs:flex-col xs:-mt-7 xs:justify-between xs:pt-7 md:-mt-13",
    containerClass,
  ]}
  {...props}
>
  <a
    {href}
    class:list={[interactiveButtonClass, '-ml-1 inline-flex w-auto grow-0 items-center justify-center gap-2.5 rounded-sm px-1 font-medium select-none hover:text-white focus-visible:text-white active:text-white']}
  >
    {href === '/' ? (
      <HomeIcon className="size-5 shrink-0 -translate-y-px" aria-hidden="true" />
    ) : (
      <ArrowLeftIcon className="size-5 shrink-0 -translate-y-px" aria-hidden="true" />
    )}
    <span>{label}</span>
  </a>
  <slot />
</menu>
