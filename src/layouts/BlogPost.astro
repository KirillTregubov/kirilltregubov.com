---
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'
import type { BlogSeriesNavigation } from '@lib/series'
import BlogSeriesNavigationComponent from '@components/BlogSeriesNavigation.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'
import { ChevronRightIcon } from 'lucide-react'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  image: {
    url: string
    alt: string
  }
  tags: string[]
  headings: MarkdownHeading[]
  series?: BlogSeriesNavigation
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  tags,
  headings,
  series,
} = Astro.props

const tableOfContents = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
)
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
---

<Layout
  title={`${title} - Kirill Tregubov`}
  {description}
  type="article"
  image={image.url}
  publishedDate={pubDate}
  {updatedDate}
  bodyClass="flex flex-col"
  footerClass="motion-safe:animate-[fadeUp_0.6s_forwards_0.6s] motion-safe:opacity-0"
>
  <main class="mx-auto w-full max-w-200 grow md:space-y-8">
    <ReturnHome href="/blog" label="Blog" />
    <header class="mt-6 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0">
      <div class="mb-6 overflow-hidden rounded-xl bg-neutral-800">
        <Image
          class="unblur aspect-[1200/630] w-full object-cover select-none"
          src={image.url}
          alt={image.alt}
          width={1200}
          height={630}
          loading="eager"
        />
      </div>
      <h1 class="text-3xl leading-tight font-semibold text-neutral-100 sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-lg text-neutral-300">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-neutral-500">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updatedDate.toISOString()}>
              Updated {formatDate(updatedDate)}
            </time>
          </>
        )}
        {tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <ul class="flex flex-wrap gap-2" aria-label="Tags">
              {tags.map((tag) => (
                <li class="rounded-sm bg-neutral-800 px-2 py-0.5 text-neutral-400">
                  {tag}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </header>
    {series && (
      <BlogSeriesNavigationComponent series={series} placement="top" />
    )}
    <article class="prose prose-lg max-w-none text-neutral-300 prose-neutral dark:prose-invert prose-headings:scroll-mt-20 prose-h2:text-2xl prose-h3:text-xl prose-h4:font-medium prose-a:text-white prose-img:rounded-xl">
      {tableOfContents.length > 1 && (
        <details class="group/toc not-prose overflow-hidden rounded-xl border border-neutral-800 bg-neutral-800/30 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 rounded-xl px-5 py-4 font-semibold text-neutral-200 transition marker:content-none hover:bg-neutral-800/50 hover:text-white">
            <span>Table of contents</span>
            <ChevronRightIcon
              className="size-4 shrink-0 text-neutral-500 transition-transform duration-150 group-open/toc:rotate-90"
              aria-hidden="true"
            />
          </summary>
          <nav
            aria-label="Table of contents"
            class="border-t border-neutral-800 px-5 py-4"
          >
            <ol class="space-y-2">
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-4']}>
                  <a
                    class="block rounded-sm text-sm text-neutral-400 transition hover:text-white"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      <div class="motion-safe:animate-[fadeUp_0.6s_forwards_0.45s] motion-safe:opacity-0">
        <slot />
      </div>
    </article>
    {series && (
      <BlogSeriesNavigationComponent series={series} placement="bottom" />
    )}
  </main>
</Layout>
