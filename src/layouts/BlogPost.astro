---
import type { MarkdownHeading } from 'astro'
import { Image } from 'astro:assets'
import type { BlogSeriesNavigation } from '@lib/series'
import BlogSeriesNavigationComponent from '@components/BlogSeriesNavigation.astro'
import ReturnHome from '@components/ReturnHome.astro'
import Layout from '@layouts/Layout.astro'
import { ChevronRightIcon } from 'lucide-react'

interface Props {
  title: string
  description: string
  pubDate: Date
  updatedDate?: Date
  image: {
    url: string
    alt: string
  }
  tags: string[]
  headings: MarkdownHeading[]
  series?: BlogSeriesNavigation
}

const {
  title,
  description,
  pubDate,
  updatedDate,
  image,
  tags,
  headings,
  series,
} = Astro.props

const tableOfContents = headings.filter(
  (heading) => heading.depth === 2 || heading.depth === 3,
)
const formatDate = (date: Date) =>
  date.toLocaleDateString('en-CA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  })
---

<Layout
  title={`${title} - Kirill Tregubov`}
  {description}
  type="article"
  image={image.url}
  publishedDate={pubDate}
  {updatedDate}
  bodyClass="flex flex-col"
  footerClass="motion-safe:animate-[fadeUp_0.6s_forwards_0.6s] motion-safe:opacity-0"
>
  <main class="mx-auto w-full max-w-200 grow space-y-8">
    <ReturnHome href="/blog" label="Blog" />
    <header class="mt-6 motion-safe:animate-[fadeUp_0.6s_forwards_0.15s] motion-safe:opacity-0">
      <div class="mb-6 overflow-hidden rounded-xl bg-neutral-800">
        <Image
          class="unblur aspect-1200/630 w-full object-cover select-none"
          src={image.url}
          alt={image.alt}
          width={1200}
          height={630}
          loading="eager"
        />
      </div>
      <h1 class="text-3xl leading-tight font-semibold text-neutral-100 sm:text-4xl">
        {title}
      </h1>
      <p class="mt-3 text-lg text-neutral-300">{description}</p>
      <div class="mt-4 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-neutral-500">
        <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
        {updatedDate && (
          <>
            <span aria-hidden="true">·</span>
            <time datetime={updatedDate.toISOString()}>
              Updated {formatDate(updatedDate)}
            </time>
          </>
        )}
        {tags.length > 0 && (
          <>
            <span aria-hidden="true">·</span>
            <ul class="flex flex-wrap gap-2" aria-label="Tags">
              {tags.map((tag) => (
                <li class="rounded-sm bg-neutral-800 px-2 py-0.5 text-neutral-400">
                  {tag}
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </header>
    {series && (
      <BlogSeriesNavigationComponent series={series} placement="top" />
    )}
    <article class="prose prose-lg max-w-none text-neutral-300 prose-neutral dark:prose-invert prose-headings:scroll-mt-20 prose-h2:text-2xl prose-h3:text-xl prose-h4:font-medium prose-a:-m-0.5 prose-a:rounded-sm prose-a:p-0.5 prose-a:hover:text-neutral-300 prose-a:focus-visible:text-neutral-300 prose-a:active:text-neutral-300 prose-a:transition prose-a:text-white prose-img:rounded-xl">
      {tableOfContents.length > 1 && (
        <details class="toc-details group/toc not-prose rounded-xl border border-neutral-800 transition bg-neutral-800 motion-safe:animate-[fadeUp_0.6s_forwards_0.3s] motion-safe:opacity-0">
          <summary class="toc-summary flex cursor-pointer list-none rounded-xl items-center justify-between gap-4 px-5 py-4 font-semibold transition-[background-color,color,border-radius] text-neutral-200 marker:content-none hover:bg-neutral-700 hover:text-white active:text-white focus-visible:text-white focus-visible:ring-inset group-open/toc:rounded-b-none group/summary">
            <span>Table of contents</span>
            <ChevronRightIcon
              className="size-4 shrink-0 text-neutral-500 transition-transform duration-150 group-hover/summary:text-white group-active/summary:text-white group-focus-visible/summary:text-white group-open/toc:rotate-90"
              aria-hidden="true"
            />
          </summary>
          <nav
            aria-label="Table of contents"
            class="toc-content border-t border-neutral-800 px-5 py-4"
          >
            <ol class="space-y-2">
              {tableOfContents.map((heading) => (
                <li class:list={[heading.depth === 3 && 'pl-4']}>
                  <a
                    class="block rounded-sm text-base text-neutral-400 transition hover:text-white"
                    href={`#${heading.slug}`}
                  >
                    {heading.text}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        </details>
      )}
      <div class="[&_summary]:-m-0.5 [&_summary]:rounded-sm [&_summary]:p-0.5 [&_summary]:transition [&_summary]:cursor-pointer motion-safe:animate-[fadeUp_0.6s_forwards_0.45s] motion-safe:opacity-0">
        <slot />
      </div>
    </article>
    {series && (
      <BlogSeriesNavigationComponent series={series} placement="bottom" />
    )}
  </main>
</Layout>

<script>
  const setupTableOfContents = () => {
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)')

    document
      .querySelectorAll<HTMLDetailsElement>('.toc-details')
      .forEach((details) => {
        if (details.dataset.tocInit !== undefined) return
        details.dataset.tocInit = ''

        const summary = details.querySelector<HTMLElement>('.toc-summary')
        const content = details.querySelector<HTMLElement>('.toc-content')

        if (!summary || !content) return

        summary.addEventListener('click', async (event) => {
          if (reducedMotion.matches) return

          event.preventDefault()
          if (details.dataset.animating !== undefined) return

          const opening = !details.open
          const startHeight = details.getBoundingClientRect().height
          details.dataset.animating = ''

          if (opening) details.open = true
          else details.dataset.closing = ''

          const borderHeight = details.offsetHeight - details.clientHeight
          const endHeight = opening
            ? details.scrollHeight + borderHeight
            : summary.getBoundingClientRect().height + borderHeight

          const heightAnimation = details.animate(
            [{ height: `${startHeight}px` }, { height: `${endHeight}px` }],
            {
              duration: 240,
              easing: 'cubic-bezier(0.2, 0.8, 0.2, 1)',
              fill: 'forwards',
            },
          )
          const contentAnimation = content.animate(
            opening
              ? [
                  { opacity: 0, transform: 'translateY(-0.25rem)' },
                  { opacity: 1, transform: 'translateY(0)' },
                ]
              : [
                  { opacity: 1, transform: 'translateY(0)' },
                  { opacity: 0, transform: 'translateY(-0.25rem)' },
                ],
            { duration: 180, easing: 'ease-out', fill: 'forwards' },
          )

          try {
            await Promise.all([
              heightAnimation.finished,
              contentAnimation.finished,
            ])
            if (!opening) details.open = false
          } finally {
            heightAnimation.cancel()
            contentAnimation.cancel()
            delete details.dataset.animating
            delete details.dataset.closing
          }
        })
      })
  }

  document.addEventListener('astro:page-load', setupTableOfContents)
</script>

<style>
  .toc-details[data-closing] > .toc-summary {
    border-bottom-right-radius: 0.75rem;
    border-bottom-left-radius: 0.75rem;
  }
</style>
