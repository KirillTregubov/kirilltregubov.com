{
  "name": "personal-site",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "build:clean": "astro check && astro build --force",
    "preview": "astro preview",
    "check": "astro check",
    "verify:theatres": "bun scripts/verify-theatres.ts",
    "solid": "bun scripts/solid-color.ts",
    "format": "oxfmt && prettier --write '**/*.astro'",
    "format:check": "oxfmt --check && prettier --check '**/*.astro'",
    "upgrade": "bunx @astrojs/upgrade"
  },
  "dependencies": {
    "@astrojs/mdx": "8.1.6",
    "@astrojs/react": "7.1.9",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/inter": "^5.3.0",
    "@pmndrs/detect-gpu": "^6.0.32",
    "@react-spring/three": "^10.1.2",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "astro": "7.4.13",
    "astro-heroicons": "^2.1.5-1",
    "cobe": "^2.0.1",
    "fuse.js": "^7.5.0",
    "lucide-react": "^1.81.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-snowfall": "^2.4.0",
    "react-tweet": "^3.3.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "three": "^0.187.0",
    "tinykeys": "^4.0.1",
    "typescript": "6.0.3",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@types/node": "^26.6.11",
    "@vercel/speed-insights": "^2.1.1",
    "oxfmt": "^0.80.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1"
  },
  "engines": {
    "node": ">=26"
  },
  "packageManager": "bun@1.4.5",
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "@vercel/speed-insights",
    "esbuild",
    "sharp"
  ]
}
